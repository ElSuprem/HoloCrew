<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:HoloCrew.Controls"
                    xmlns:converters="clr-namespace:HoloCrew.Converters">

    <!-- ========================================================================
         TARJETA DE PRODUCTO REUTILIZABLE
         Plantilla única para la tarjeta de producto "clara" (Home, Catálogo,
         Wishlist...). Se referencia con ItemTemplate="{StaticResource ProductCardTemplate}".
         Los comandos se resuelven contra el DataContext de la vista que la hospeda
         (AncestorType=UserControl), por eso funciona en cualquier vista cuyo VM
         exponga ViewProductDetailCommand / ToggleWishlistCommand / AddToCartCommand.

         Los converters se declaran aquí como instancias locales (no tienen estado)
         para que el diccionario sea autosuficiente al fusionarse en App.xaml.
         ======================================================================== -->

    <converters:AspectRatioConverter x:Key="AspectRatioConverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

    <DataTemplate x:Key="ProductCardTemplate">
        <Border Background="{DynamicResource WhitePrimaryBrush}"
                Margin="10"
                Cursor="Hand">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- La altura de la imagen es proporcional al ancho (ancho * 1.25),
                         así se recorta igual a cualquier tamaño de ventana. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zona de la imagen.
                     Fondo = WhitePrimaryBrush (igual que la tarjeta) para que el relleno
                     de Uniform se funda con las fotos de fondo blanco y no se note el marco. -->
                <Border Grid.Row="0" Background="{DynamicResource WhitePrimaryBrush}" ClipToBounds="True"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatioConverter}, ConverterParameter=1.25}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Grid>
                        <!-- Imagen del producto.
                             Stretch=Uniform: se ve el producto ENTERO siempre (centrado sobre
                             el fondo gris), sin recortar lados. Para "a sangre" usar UniformToFill. -->
                        <controls:AsyncImage Source="{Binding MainImageUrl}" Stretch="Uniform"/>

                        <!-- Overlay SOLD OUT cuando todas las tallas están agotadas -->
                        <Border Background="#CCFFFFFF"
                                Visibility="{Binding IsCompletelyOutOfStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsHitTestVisible="False"
                                Panel.ZIndex="200">
                            <Border Background="#0A0A0A"
                                    Padding="20,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="SOLD OUT"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                            </Border>
                        </Border>

                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12">
                            <Border Background="{DynamicResource BlackPrimaryBrush}"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Border Background="{DynamicResource RedAccentBrush}"
                                    Padding="10,5"
                                    Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="White" FontSize="10" FontWeight="Bold">
                                    <Run Text="-"/><Run Text="{Binding DiscountPercentage, Mode=OneWay}"/><Run Text="%"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Wishlist button -->
                        <Button Width="40" Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12"
                                Cursor="Hand"
                                Panel.ZIndex="100"
                                Command="{Binding DataContext.ToggleWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="40" Height="40"
                                            Background="{DynamicResource WhitePrimaryBrush}"
                                            CornerRadius="20">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                     Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                      Fill="Transparent" Stroke="#1F2937" StrokeThickness="1.5"/>
                                            </Viewbox>
                                            <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                     Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                      Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quick Add on hover -->
                        <Border Background="{DynamicResource BlackPrimaryBrush}"
                                Height="45"
                                VerticalAlignment="Bottom"
                                Cursor="Hand"
                                Opacity="0"
                                x:Name="QuickAddButton">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <TextBlock Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Por defecto, productos con tallas -->
                                        <Setter Property="Text" Value="VIEW SIZES"/>
                                        <Style.Triggers>
                                            <!-- Solo "VIEW SIZES" si hay varias tallas que elegir;
                                                 talla única (gorras) o sin talla (bolsos) -> "VIEW PRODUCT" -->
                                            <DataTrigger Binding="{Binding HasMultipleSizes}" Value="False">
                                                <Setter Property="Text" Value="VIEW PRODUCT"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Product info -->
                <Border Grid.Row="1" Padding="5,16,5,20">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BlackPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BlackPrimaryBrush}"/>
                            <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Gray400Brush}"
                                       TextDecorations="Strikethrough"
                                       Margin="10,2,0,0"
                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hover animations -->
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="QuickAddButton"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="QuickAddButton"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
    </DataTemplate>

</ResourceDictionary>
