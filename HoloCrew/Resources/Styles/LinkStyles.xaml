<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos para enlaces y hyperlinks.
     Se usan con Style="{StaticResource ModernHyperlink}" en un Hyperlink.
     Al pasar el ratón se subrayan y cambian de color. -->

    <!-- enlace normal con color de acento -->
    <Style x:Key="ModernHyperlink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- textblock que funciona como enlace (usa Command en lugar de NavigateUri) -->
    <Style x:Key="LinkTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- enlace secundario (gris, menos llamativo) -->
    <Style x:Key="SecondaryLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>