<!-- ========================================
     ESTILOS PARA LINKS Y HYPERLINKS
     Con hover effects
     ======================================== -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================
         HYPERLINK CON HOVER
         ======================================== -->
    <Style x:Key="ModernHyperlink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================
         TEXTBLOCK COMO LINK (con Command)
         ======================================== -->
    <Style x:Key="LinkTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========================================
         SECONDARY LINK (gris, menos prominente)
         ======================================== -->
    <Style x:Key="SecondaryLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
