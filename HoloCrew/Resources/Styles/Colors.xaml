<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORS.XAML
         Definiciones de colores en formato Color (sin brushes).
         Estos colores se usan luego en Brushes.xaml para crear los pinceles.
         Separar Color de Brush evita errores del diseñador.
    -->

    <!-- negros -->
    <Color x:Key="BlackPrimary">#0A0A0A</Color>
    <Color x:Key="BlackSecondary">#1A1A1A</Color>
    <Color x:Key="BlackTertiary">#2A2A2A</Color>

    <!-- blancos -->
    <Color x:Key="WhitePrimary">#FFFFFF</Color>
    <Color x:Key="WhiteSecondary">#F5F5F5</Color>
    <Color x:Key="WhiteTertiary">#E8E8E8</Color>

    <!-- rojo de la marca -->
    <Color x:Key="RedAccent">#FF0000</Color>
    <Color x:Key="RedAccentDark">#CC0000</Color>
    <Color x:Key="RedAccentLight">#FF3333</Color>

    <!-- grises -->
    <Color x:Key="Gray100">#F7F7F7</Color>
    <Color x:Key="Gray200">#E8E8E8</Color>
    <Color x:Key="Gray300">#D1D1D1</Color>
    <Color x:Key="Gray400">#B0B0B0</Color>
    <Color x:Key="Gray500">#8A8A8A</Color>
    <Color x:Key="Gray600">#6B6B6B</Color>
    <Color x:Key="Gray700">#4A4A4A</Color>
    <Color x:Key="Gray800">#2E2E2E</Color>
    <Color x:Key="Gray900">#1F1F1F</Color>

    <!-- colores para mensajes -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- capas semitransparentes -->
    <Color x:Key="OverlayDark">#80000000</Color>
    <Color x:Key="OverlayLight">#40FFFFFF</Color>

    <!-- colores al pasar el ratón -->
    <Color x:Key="HoverLight">#F0F0F0</Color>
    <Color x:Key="HoverDark">#20FFFFFF</Color>

</ResourceDictionary>