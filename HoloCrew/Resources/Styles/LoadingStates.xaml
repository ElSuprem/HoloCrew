<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- SKELETON LOADER ANIMATION -->
    <!-- ============================================ -->

    <!-- Animación de shimmer para skeleton -->
    <Storyboard x:Key="SkeletonShimmer" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="-200" To="400"
                         Duration="0:0:1.5"/>
    </Storyboard>

    <!-- Brush con gradiente para shimmer -->
    <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E5E7EB" Offset="0"/>
        <GradientStop Color="#F3F4F6" Offset="0.5"/>
        <GradientStop Color="#E5E7EB" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================ -->
    <!-- SKELETON BASE STYLE -->
    <!-- ============================================ -->
    <Style x:Key="SkeletonBase" TargetType="Border">
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Skeleton para texto (línea) -->
    <Style x:Key="SkeletonText" TargetType="Border" BasedOn="{StaticResource SkeletonBase}">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Skeleton para título -->
    <Style x:Key="SkeletonTitle" TargetType="Border" BasedOn="{StaticResource SkeletonBase}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Skeleton para imagen cuadrada -->
    <Style x:Key="SkeletonImageSquare" TargetType="Border" BasedOn="{StaticResource SkeletonBase}">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Skeleton para avatar circular -->
    <Style x:Key="SkeletonAvatar" TargetType="Border" BasedOn="{StaticResource SkeletonBase}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <!-- Skeleton para botón -->
    <Style x:Key="SkeletonButton" TargetType="Border" BasedOn="{StaticResource SkeletonBase}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- ============================================ -->
    <!-- SKELETON PRODUCT CARD -->
    <!-- ============================================ -->
    <ControlTemplate x:Key="SkeletonProductCard">
        <Border Background="White" Margin="10">
            <StackPanel>
                <!-- Image placeholder -->
                <Border Style="{StaticResource SkeletonImageSquare}" Height="280"/>

                <!-- Content -->
                <StackPanel Margin="15">
                    <!-- Category -->
                    <Border Style="{StaticResource SkeletonText}" Width="60" Height="12"/>
                    <!-- Title -->
                    <Border Style="{StaticResource SkeletonText}" Width="180"/>
                    <!-- Price -->
                    <Border Style="{StaticResource SkeletonText}" Width="80" Height="20" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!-- ============================================ -->
    <!-- SKELETON PRODUCT DETAIL -->
    <!-- ============================================ -->
    <ControlTemplate x:Key="SkeletonProductDetail">
        <Grid Margin="80,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Image -->
            <StackPanel Grid.Column="0" Margin="0,0,50,0">
                <Border Style="{StaticResource SkeletonImageSquare}" Height="500"/>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Border Style="{StaticResource SkeletonImageSquare}" Width="80" Height="80" Margin="0,0,10,0"/>
                    <Border Style="{StaticResource SkeletonImageSquare}" Width="80" Height="80" Margin="0,0,10,0"/>
                    <Border Style="{StaticResource SkeletonImageSquare}" Width="80" Height="80" Margin="0,0,10,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Right: Info -->
            <StackPanel Grid.Column="1">
                <!-- Category -->
                <Border Style="{StaticResource SkeletonText}" Width="80" Height="14"/>
                <!-- Title -->
                <Border Style="{StaticResource SkeletonTitle}" Width="300" Height="36" Margin="0,10,0,0"/>
                <Border Style="{StaticResource SkeletonTitle}" Width="200" Height="36"/>
                <!-- Rating -->
                <Border Style="{StaticResource SkeletonText}" Width="150" Height="20" Margin="0,20,0,0"/>
                <!-- Price -->
                <Border Style="{StaticResource SkeletonText}" Width="120" Height="40" Margin="0,20,0,0"/>
                <!-- Description -->
                <Border Style="{StaticResource SkeletonText}" Margin="0,30,0,0"/>
                <Border Style="{StaticResource SkeletonText}"/>
                <Border Style="{StaticResource SkeletonText}" Width="250"/>
                <!-- Size selector -->
                <Border Style="{StaticResource SkeletonText}" Width="60" Height="14" Margin="0,30,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SkeletonBase}" Width="50" Height="44" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource SkeletonBase}" Width="50" Height="44" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource SkeletonBase}" Width="50" Height="44" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource SkeletonBase}" Width="50" Height="44" Margin="0,0,8,0"/>
                </StackPanel>
                <!-- Add to cart button -->
                <Border Style="{StaticResource SkeletonButton}" Margin="0,30,0,0"/>
            </StackPanel>
        </Grid>
    </ControlTemplate>

    <!-- ============================================ -->
    <!-- LOADING SPINNER -->
    <!-- ============================================ -->
    <Style x:Key="LoadingSpinner" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================ -->
    <!-- LOADING OVERLAY -->
    <!-- ============================================ -->
    <Style x:Key="LoadingOverlay" TargetType="Border">
        <Setter Property="Background" Value="#80FFFFFF"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================ -->
    <!-- ERROR STATE -->
    <!-- ============================================ -->
    <Style x:Key="ErrorStateContainer" TargetType="Border">
        <Setter Property="Background" Value="#FEF2F2"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="40"/>
        <Setter Property="Margin" Value="20"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ErrorIcon" TargetType="TextBlock">
        <Setter Property="Text" Value="⚠️"/>
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="ErrorTitle" TargetType="TextBlock">
        <Setter Property="Text" Value="Something went wrong"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ErrorMessage" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#7F1D1D"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="RetryButton" TargetType="Button">
        <Setter Property="Content" Value="Try Again"/>
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#B91C1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- EMPTY STATE -->
    <!-- ============================================ -->
    <Style x:Key="EmptyStateContainer" TargetType="Border">
        <Setter Property="Padding" Value="60"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EmptyIcon" TargetType="TextBlock">
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="EmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="EmptySubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>

    <Style x:Key="EmptyActionButton" TargetType="Button">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="32,14"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#262626"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- PULL TO REFRESH INDICATOR -->
    <!-- ============================================ -->
    <Style x:Key="RefreshIndicator" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="0,-50,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ============================================ -->
    <!-- LOAD MORE INDICATOR -->
    <!-- ============================================ -->
    <Style x:Key="LoadMoreContainer" TargetType="Border">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LoadMoreText" TargetType="TextBlock">
        <Setter Property="Text" Value="Loading more..."/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================ -->
    <!-- INLINE ERROR (for form fields) -->
    <!-- ============================================ -->
    <Style x:Key="InlineError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- ============================================ -->
    <!-- SUCCESS TOAST -->
    <!-- ============================================ -->
    <Style x:Key="SuccessToast" TargetType="Border">
        <Setter Property="Background" Value="#10B981"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- ERROR TOAST -->
    <!-- ============================================ -->
    <Style x:Key="ErrorToast" TargetType="Border">
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="10" ShadowDepth="3"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
