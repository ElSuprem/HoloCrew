<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MENUSTYLES.XAML
     Estilos para el menú principal, footer, badges, etc.
     Se usan en el header de navegación y en el mega menu desplegable. -->

    <!-- enlace dentro del mega menu (gris, se pone negro al pasar el ratón) -->
    <Style x:Key="MegaMenuLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Gray600Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- enlace del footer (gris oscuro, se pone blanco al pasar el ratón) -->
    <Style x:Key="FooterLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Gray400Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WhitePrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- cabecera de categoría en el mega menu (negrita, se pone roja al pasar el ratón) -->
    <Style x:Key="MegaMenuCategory" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- enlace que se subraya al pasar el ratón -->
    <Style x:Key="HoverUnderlineLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Gray600Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- badge rojo para notificaciones (punto o número en el header) -->
    <Style x:Key="NotificationBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RedAccentBrush}"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,5,5,0"/>
    </Style>

    <!-- botón cuadrado para iconos del header (carrito, usuario, etc.) -->
    <Style x:Key="HeaderIconButton" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#20FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- enlace de la barra de navegación superior -->
    <Style x:Key="TopNavLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WhitePrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Gray300Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>