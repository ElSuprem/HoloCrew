<!-- ========================================
     HOLOCREW - ESTILOS MEGA MENU
     Estilos para el menú desplegable y links
     ======================================== -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== LINK DEL MEGA MENU ========== -->
    <Style x:Key="MegaMenuLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Gray600Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BlackPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== LINK DEL FOOTER ========== -->
    <Style x:Key="FooterLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Gray400Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource WhitePrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== CATEGORIA HEADER EN MEGA MENU ========== -->
    <Style x:Key="MegaMenuCategory" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BlackPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource RedAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== HOVER LINK CON UNDERLINE ========== -->
    <Style x:Key="HoverUnderlineLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Gray600Brush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BlackPrimaryBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== BADGE DE NOTIFICACIÓN ========== -->
    <Style x:Key="NotificationBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RedAccentBrush}"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,5,5,0"/>
    </Style>

    <!-- ========== ICONO DE HEADER ========== -->
    <Style x:Key="HeaderIconButton" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#20FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== BOTÓN DE MENÚ TOP NAV ========== -->
    <Style x:Key="TopNavLink" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WhitePrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
