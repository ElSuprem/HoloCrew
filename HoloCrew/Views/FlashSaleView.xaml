<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.FlashSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <!-- ============================================ -->
        <!-- LOADING STATE -->
        <!-- ============================================ -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource BackgroundPrimary}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding LoadingMessage}" 
                           FontSize="16"
                           Foreground="{DynamicResource Gray500Brush}"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- EMPTY STATE -->
        <!-- ============================================ -->
        <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource BackgroundPrimary}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                <TextBlock Text="" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding EmptyTitle}" 
                           FontSize="24"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="{Binding EmptySubtitle}" 
                           FontSize="16"
                           Foreground="{DynamicResource Gray500Brush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>
                <Button Content="{Binding EmptyActionText}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding EmptyActionCommand}"
                        Padding="40,15"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT -->
        <!-- ============================================ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>

                <!-- ============================================ -->
                <!-- HERO BANNER CON COUNTDOWN -->
                <!-- ============================================ -->
                <!-- HERO: Always dark -->
                <Border Background="#0A0A0A" Padding="80,60">
                    <Grid>
                        <!-- Fondo con patrón -->
                        <Border Opacity="0.1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FF6B00" Offset="0.5"/>
                                    <GradientStop Color="#FFD700" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Título y subtítulo -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Background="{DynamicResource RedAccentBrush}" Padding="12,6">
                                        <TextBlock Text="LIMITED TIME" 
                                                   Foreground="White" 
                                                   FontSize="12" 
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#FF6B00" Padding="12,6" Margin="10,0,0,0">
                                        <TextBlock Text="UP TO 70% OFF" 
                                                   Foreground="White" 
                                                   FontSize="12" 
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="FLASH" 
                                           FontSize="72"
                                           FontWeight="Black"
                                           Foreground="White"
                                           Margin="0,0,0,-10"/>
                                <TextBlock Text="SALE" 
                                           FontSize="72"
                                           FontWeight="Black"
                                           Margin="0,0,0,20">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF6B00" Offset="0"/>
                                            <GradientStop Color="#FFD700" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <TextBlock Text="{Binding SaleSubtitle}"
                                           FontSize="16"
                                           Foreground="{DynamicResource Gray400Brush}"
                                           Margin="0,0,0,25"/>

                                <TextBlock FontSize="14" Foreground="{DynamicResource Gray500Brush}">
                                    <Run Text="{Binding TotalProductCount, Mode=OneWay}"/>
                                    <Run Text=" products on sale"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Countdown Timer -->
                            <Border Grid.Column="1" 
                                    Background="#1A1A1A"
                                    Padding="40,30"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ENDS IN"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Gray500Brush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,15"/>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- Hours -->
                                        <StackPanel>
                                            <Border Background="{DynamicResource RedAccentBrush}" 
                                                    Padding="20,15"
                                                    MinWidth="70">
                                                <TextBlock Text="{Binding HoursRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="36"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="HOURS"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Gray500Brush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text=":"
                                                   FontSize="36"
                                                   FontWeight="Black"
                                                   Foreground="White"
                                                   VerticalAlignment="Top"
                                                   Margin="8,15,8,0"/>

                                        <!-- Minutes -->
                                        <StackPanel>
                                            <Border Background="{DynamicResource RedAccentBrush}" 
                                                    Padding="20,15"
                                                    MinWidth="70">
                                                <TextBlock Text="{Binding MinutesRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="36"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MINS"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Gray500Brush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text=":"
                                                   FontSize="36"
                                                   FontWeight="Black"
                                                   Foreground="White"
                                                   VerticalAlignment="Top"
                                                   Margin="8,15,8,0"/>

                                        <!-- Seconds -->
                                        <StackPanel>
                                            <Border Background="{DynamicResource RedAccentBrush}" 
                                                    Padding="20,15"
                                                    MinWidth="70">
                                                <TextBlock Text="{Binding SecondsRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="36"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="SECS"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Gray500Brush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Hurry up message -->
                                    <TextBlock Text="HURRY UP!"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#FF6B00"
                                               HorizontalAlignment="Center"
                                               Margin="0,15,0,0"
                                               Visibility="{Binding IsSaleActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- URGENCY BAR -->
                <!-- ============================================ -->
                <Border Background="#FF6B00" Padding="15,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="LIMITED STOCK - ONCE IT'S GONE, IT'S GONE!"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="" FontSize="14" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- FILTERS BAR -->
                <!-- ============================================ -->
                <Border Background="{DynamicResource WhitePrimaryBrush}"
                        BorderBrush="{DynamicResource Gray200Brush}"
                        BorderThickness="0,0,0,1"
                        Padding="80,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category filters -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Filter:"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>

                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0"
                                                Padding="15,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Sort dropdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Sort by:"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortBy}"
                                      Width="180"
                                      Height="36"
                                      Padding="12,0"
                                      FontSize="13"
                                      Style="{StaticResource ThemedComboBox}"
                                      ItemContainerStyle="{StaticResource ThemedComboBoxItem}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- PRODUCTS GRID -->
                <!-- ============================================ -->
                <Border Padding="80,50" Background="{DynamicResource Gray50Brush}">
                    <ItemsControl ItemsSource="{Binding FlashSaleProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WhitePrimaryBrush}"
                                        Margin="10"
                                        Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="300"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Image -->
                                        <Border Grid.Row="0" Background="{DynamicResource Gray100Brush}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <!-- Discount Badge -->
                                                <Border Background="{DynamicResource RedAccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="12,6"
                                                        Margin="0">
                                                    <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                                                        <Run Text="-"/>
                                                        <Run Text="{Binding DiscountPercentage, Mode=OneWay}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Stock warning -->
                                                <Border Background="#FEF3C7"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="10,5"
                                                        Margin="0,40,0,0"
                                                        Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#92400E">
                                                        <Run Text="Only "/>
                                                        <Run Text="{Binding Stock, Mode=OneWay}"/>
                                                        <Run Text=" left!"/>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Wishlist button -->
                                                <Button Width="40" Height="40"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,12,12,0"
                                                        Cursor="Hand"
                                                        Panel.ZIndex="100"
                                                        Command="{Binding DataContext.ToggleWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="40" Height="40"
                                                                    Background="White"
                                                                    CornerRadius="20">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                                                                </Border.Effect>
                                                                <Grid>
                                                                    <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                                             Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                        <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                              Fill="Transparent" Stroke="#1F2937" StrokeThickness="1.5"/>
                                                                    </Viewbox>
                                                                    <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                                             Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                              Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                                                    </Viewbox>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Quick Add (always dark) -->
                                                <Button Background="#0A0A0A"
                                                        BorderThickness="0"
                                                        Height="45"
                                                        VerticalAlignment="Bottom"
                                                        Opacity="0"
                                                        x:Name="QuickAdd"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="ADD TO CART"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Row="1" Margin="15">
                                            <StackPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </StackPanel.InputBindings>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource RedAccentBrush}"/>
                                                <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource Gray400Brush}"
                                                           TextDecorations="Strikethrough"
                                                           Margin="12,2,0,0"/>
                                            </StackPanel>

                                            <!-- Savings -->
                                            <TextBlock Foreground="#10B981" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0">
                                                <Run Text="You save €"/>
                                                <Run Text="{Binding Savings, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hover trigger -->
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="QuickAdd"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="QuickAdd"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ============================================ -->
                <!-- BOTTOM CTA -->
                <!-- BOTTOM CTA: Always dark -->
                <Border Background="#0A0A0A" Padding="80,50">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Don't see what you're looking for?"
                                   FontSize="18"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <Button Content="BROWSE ALL PRODUCTS"
                                Style="{StaticResource OutlineButton}"
                                BorderBrush="White"
                                Foreground="White"
                                Padding="40,15"
                                FontSize="14"
                                Command="{Binding BrowseAllProductsCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
