<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Top Nav Bar (negro) -->
            <RowDefinition Height="70"/>
            <!-- Main Header con logo y mega menu -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- TOP NAVIGATION BAR (Negro con menú) -->
        <!-- ============================================ -->
        <Border Grid.Row="0" Background="{StaticResource BlackPrimaryBrush}">
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Menú izquierdo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- SHOP con dropdown -->
                    <Border x:Name="ShopMenuTrigger" 
                            Background="Transparent" 
                            Padding="0,0,25,0"
                            Cursor="Hand"
                            MouseEnter="ShopMenu_MouseEnter"
                            MouseLeave="ShopMenu_MouseLeave">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SHOP" 
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="▼" 
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       FontSize="8"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="FLASH SALE" 
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,25,0"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToFlashSaleCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBlock Text="BLACK WEEK" 
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,25,0"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBlock Text="MEMBERS CLUB" 
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToMembersClubCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

                <!-- Logo central -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick"/>
                    </Border.InputBindings>
                    <TextBlock Text="HOLOCREW" 
                               FontSize="24" 
                               FontWeight="Black" 
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               FontStyle="Italic"/>
                </Border>

                <!-- Iconos derecha -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Currency/Country -->
                    <TextBlock Text="EUR €" 
                               Foreground="{StaticResource Gray400Brush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray600Brush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="SPAIN ▼" 
                               Foreground="{StaticResource Gray400Brush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <!-- Search Icon (SVG Path) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Buscar">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ToggleSearchCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" 
                                  Stroke="{StaticResource WhitePrimaryBrush}" 
                                  StrokeThickness="2"
                                  Fill="Transparent"/>
                        </Viewbox>
                    </Border>

                    <!-- Wishlist Icon (Heart) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Lista de deseos">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToWishlistCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" 
                                      Stroke="{StaticResource WhitePrimaryBrush}" 
                                      StrokeThickness="1.5"
                                      Fill="Transparent"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="7"
                                    Width="14" Height="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,3,3,0"
                                    Visibility="{Binding WishlistItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding WishlistItemCount}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Profile Icon (User) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Mi cuenta">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToProfileCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M20 21V19C20 16.7909 18.2091 15 16 15H8C5.79086 15 4 16.7909 4 19V21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" 
                                  Stroke="{StaticResource WhitePrimaryBrush}" 
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>

                    <!-- Notifications Icon (Bell) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Notificaciones">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToNotificationsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8ZM13.73 21C13.5542 21.3031 13.3019 21.5547 12.9982 21.7295C12.6946 21.9044 12.3504 21.9965 12 21.9965C11.6496 21.9965 11.3054 21.9044 11.0018 21.7295C10.6982 21.5547 10.4458 21.3031 10.27 21" 
                                      Stroke="{StaticResource WhitePrimaryBrush}" 
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="7"
                                    Width="14" Height="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,3,3,0"
                                    Visibility="{Binding UnreadNotificationCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cart Icon (Shopping Bag) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Carrito">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToCartCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6ZM3 6H21M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" 
                                      Stroke="{StaticResource WhitePrimaryBrush}" 
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="7"
                                    Width="14" Height="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,3,3,0"
                                    Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CartItemCount}"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Settings Icon (Gear) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Configuración">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToSettingsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z M19.4 15C19.2669 15.3016 19.2272 15.6362 19.286 15.9606C19.3448 16.285 19.4995 16.5843 19.73 16.82L19.79 16.88C19.976 17.0657 20.1235 17.2863 20.2241 17.5291C20.3248 17.7719 20.3766 18.0322 20.3766 18.295C20.3766 18.5578 20.3248 18.8181 20.2241 19.0609C20.1235 19.3037 19.976 19.5243 19.79 19.71C19.6043 19.896 19.3837 20.0435 19.1409 20.1441C18.8981 20.2448 18.6378 20.2966 18.375 20.2966C18.1122 20.2966 17.8519 20.2448 17.6091 20.1441C17.3663 20.0435 17.1457 19.896 16.96 19.71L16.9 19.65C16.6643 19.4195 16.365 19.2648 16.0406 19.206C15.7162 19.1472 15.3816 19.1869 15.08 19.32C14.7842 19.4468 14.532 19.6572 14.3543 19.9255C14.1766 20.1938 14.0813 20.5082 14.08 20.83V21C14.08 21.5304 13.8693 22.0391 13.4942 22.4142C13.1191 22.7893 12.6104 23 12.08 23C11.5496 23 11.0409 22.7893 10.6658 22.4142C10.2907 22.0391 10.08 21.5304 10.08 21V20.91C10.0723 20.579 9.96512 20.258 9.77251 19.9887C9.5799 19.7194 9.31074 19.5143 9 19.4C8.69838 19.2669 8.36381 19.2272 8.03941 19.286C7.71502 19.3448 7.41568 19.4995 7.18 19.73L7.12 19.79C6.93425 19.976 6.71368 20.1235 6.47088 20.2241C6.22808 20.3248 5.96783 20.3766 5.705 20.3766C5.44217 20.3766 5.18192 20.3248 4.93912 20.2241C4.69632 20.1235 4.47575 19.976 4.29 19.79C4.10405 19.6043 3.95653 19.3837 3.85588 19.1409C3.75523 18.8981 3.70343 18.6378 3.70343 18.375C3.70343 18.1122 3.75523 17.8519 3.85588 17.6091C3.95653 17.3663 4.10405 17.1457 4.29 16.96L4.35 16.9C4.58054 16.6643 4.73519 16.365 4.794 16.0406C4.85282 15.7162 4.81312 15.3816 4.68 15.08C4.55324 14.7842 4.34276 14.532 4.07447 14.3543C3.80618 14.1766 3.49179 14.0813 3.17 14.08H3C2.46957 14.08 1.96086 13.8693 1.58579 13.4942C1.21071 13.1191 1 12.6104 1 12.08C1 11.5496 1.21071 11.0409 1.58579 10.6658C1.96086 10.2907 2.46957 10.08 3 10.08H3.09C3.42099 10.0723 3.742 9.96512 4.0113 9.77251C4.28059 9.5799 4.48572 9.31074 4.6 9C4.73312 8.69838 4.77282 8.36381 4.714 8.03941C4.65519 7.71502 4.50054 7.41568 4.27 7.18L4.21 7.12C4.02405 6.93425 3.87653 6.71368 3.77588 6.47088C3.67523 6.22808 3.62343 5.96783 3.62343 5.705C3.62343 5.44217 3.67523 5.18192 3.77588 4.93912C3.87653 4.69632 4.02405 4.47575 4.21 4.29C4.39575 4.10405 4.61632 3.95653 4.85912 3.85588C5.10192 3.75523 5.36217 3.70343 5.625 3.70343C5.88783 3.70343 6.14808 3.75523 6.39088 3.85588C6.63368 3.95653 6.85425 4.10405 7.04 4.29L7.1 4.35C7.33568 4.58054 7.63502 4.73519 7.95941 4.794C8.28381 4.85282 8.61838 4.81312 8.92 4.68H9C9.29577 4.55324 9.54802 4.34276 9.72569 4.07447C9.90337 3.80618 9.99872 3.49179 10 3.17V3C10 2.46957 10.2107 1.96086 10.5858 1.58579C10.9609 1.21071 11.4696 1 12 1C12.5304 1 13.0391 1.21071 13.4142 1.58579C13.7893 1.96086 14 2.46957 14 3V3.09C14.0013 3.41179 14.0966 3.72618 14.2743 3.99447C14.452 4.26276 14.7042 4.47324 15 4.6C15.3016 4.73312 15.6362 4.77282 15.9606 4.714C16.285 4.65519 16.5843 4.50054 16.82 4.27L16.88 4.21C17.0657 4.02405 17.2863 3.87653 17.5291 3.77588C17.7719 3.67523 18.0322 3.62343 18.295 3.62343C18.5578 3.62343 18.8181 3.67523 19.0609 3.77588C19.3037 3.87653 19.5243 4.02405 19.71 4.21C19.896 4.39575 20.0435 4.61632 20.1441 4.85912C20.2448 5.10192 20.2966 5.36217 20.2966 5.625C20.2966 5.88783 20.2448 6.14808 20.1441 6.39088C20.0435 6.63368 19.896 6.85425 19.71 7.04L19.65 7.1C19.4195 7.33568 19.2648 7.63502 19.206 7.95941C19.1472 8.28381 19.1869 8.61838 19.32 8.92V9C19.4468 9.29577 19.6572 9.54802 19.9255 9.72569C20.1938 9.90337 20.5082 9.99872 20.83 10H21C21.5304 10 22.0391 10.2107 22.4142 10.5858C22.7893 10.9609 23 11.4696 23 12C23 12.5304 22.7893 13.0391 22.4142 13.4142C22.0391 13.7893 21.5304 14 21 14H20.91C20.5882 14.0013 20.2738 14.0966 20.0055 14.2743C19.7372 14.452 19.5268 14.7042 19.4 15Z" 
                                  Stroke="{StaticResource WhitePrimaryBrush}" 
                                  StrokeThickness="1.5"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MEGA MENU DROPDOWN (Debajo del header) -->
        <!-- ============================================ -->
        <Border x:Name="MegaMenuDropdown"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="{StaticResource WhitePrimaryBrush}"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Panel.ZIndex="1000"
                MouseEnter="ShopMenu_MouseEnter"
                MouseLeave="ShopMenu_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Categorías -->
                    <ColumnDefinition Width="350"/>
                    <!-- Banner promocional -->
                </Grid.ColumnDefinitions>

                <!-- Categorías del menú -->
                <Grid Grid.Column="0" Margin="70,35,40,35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SHOP ALL -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHOP ALL" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BlackPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="BLACK WEEK" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="NEW ARRIVALS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="new" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SOFTS COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="CLASSIC COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="ACTIVEWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="TRACKSUITS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- TOPS -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TOPS" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BlackPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="T-SHIRTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="tshirts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="HOODIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="hoodies" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="TRACK JACKETS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="JERSEYS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="KNITWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="JACKETS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- BOTTOMS -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BOTTOMS" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BlackPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="DENIM PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="CARGO PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="cargo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JOGGERS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="joggers" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="TRACK PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="JORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="SHORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="SWIMSHORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="UNDERWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- FOOTWEAR -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="FOOTWEAR" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BlackPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="ARMBO LOWS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="armbo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="VORTEX" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="VENTURE" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="VITORIA" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="V-SLIDES" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- ACCESSORIES -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ACCESSORIES" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BlackPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="CAPS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="caps" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BAGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="bags" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BEANIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="CARDHOLDER" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="BELTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="RINGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                        <TextBlock Text="RUGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Banner promocional derecho -->
                <Border Grid.Column="1" Background="#F5F5F5" Margin="0,0,0,0">
                    <Grid>
                        <!-- Imagen de fondo (placeholder) -->
                        <Border Background="{StaticResource Gray200Brush}"/>

                        <!-- Overlay con texto -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                            <TextBlock Text="SOFTS COLLECTION" 
                                       FontSize="28" 
                                       FontWeight="Black" 
                                       Foreground="{StaticResource BlackPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Discover our premium soft collection designed for comfort." 
                                       FontSize="13" 
                                       Foreground="{StaticResource Gray600Brush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,20"
                                       MaxWidth="250"/>
                            <Button Content="VIEW ALL" 
                                    Style="{StaticResource OutlineButton}"
                                    Padding="25,12"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Command="{Binding NavigateToCatalogCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- SEARCH BAR (Expandible - Full Width) -->
        <!-- ============================================ -->
        <Border x:Name="SearchBarExpanded"
                Grid.Row="1"
                Background="{StaticResource BlackPrimaryBrush}"
                Height="60"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                IsVisibleChanged="SearchBar_IsVisibleChanged"
                Panel.ZIndex="999">
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Campo de búsqueda -->
                <Border Background="{StaticResource WhitePrimaryBrush}" 
                        VerticalAlignment="Center" 
                        Height="44"
                        Margin="0,0,20,0">
                    <Grid>
                        <!-- Icono de lupa -->
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" 
                                  Stroke="{StaticResource Gray400Brush}" 
                                  StrokeThickness="2"
                                  Fill="Transparent"/>
                        </Viewbox>

                        <!-- TextBox -->
                        <TextBox x:Name="SearchTextBox"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="45,0,15,0"
                                 FontSize="15"
                                 CaretBrush="{StaticResource BlackPrimaryBrush}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding ToggleSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Placeholder -->
                        <TextBlock Text="Search for products..."
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Margin="45,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Botón cerrar -->
                <Border Grid.Column="1" 
                        Width="44" 
                        Height="44"
                        Background="Transparent"
                        Cursor="Hand" 
                        ToolTip="Close (Esc)">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSearchCommand}"/>
                    </Border.InputBindings>
                    <Viewbox Width="16" Height="16">
                        <Path Data="M18 6L6 18M6 6L18 18" 
                              Stroke="{StaticResource WhitePrimaryBrush}" 
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- BANNER PROMO (debajo del header) -->
        <!-- ============================================ -->
        <Border Grid.Row="1" 
                Background="#FF6B00"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="🔥 BLACK WEEK - UP TO 50% OFF ON SELECTED ITEMS 🔥"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ============================================ -->
        <!-- CONTENT AREA CON SCROLL -->
        <!-- ============================================ -->
        <ScrollViewer Grid.Row="2" 
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DYNAMIC CONTENT -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentView}"/>

                <!-- FOOTER -->
                <Border Grid.Row="1" 
                        Background="{StaticResource BlackPrimaryBrush}"
                        Padding="70,60,70,30">
                    <StackPanel>
                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMNA 1: ABOUT -->
                            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                <TextBlock Text="HOLOCREW" 
                                           FontSize="20"
                                           FontWeight="Black"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Premium streetwear for the next generation. Express yourself with our exclusive collections designed for comfort and style."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,20"/>
                                <TextBlock Text="Follow Us"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Gray800Brush}" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="🐦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}" Width="36" Height="36" Cursor="Hand">
                                        <TextBlock Text="📘" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- COLUMNA 2: SHOP -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SHOP" 
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="New Arrivals" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Best Sellers" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Sale" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Collections" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Accessories" Style="{StaticResource FooterLink}"/>
                            </StackPanel>

                            <!-- COLUMNA 3: HELP -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HELP" 
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Shipping Info" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Returns &amp; Exchanges" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Size Guide" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Track Order" Style="{StaticResource FooterLink}"/>
                                <TextBlock Text="Contact Us" Style="{StaticResource FooterLink}"/>
                            </StackPanel>

                            <!-- COLUMNA 4: NEWSLETTER -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STAY UPDATED" 
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Margin="0,0,0,15"/>
                                <TextBlock Text="Subscribe for exclusive offers and early access to new drops."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,15"/>
                                <Border Background="{StaticResource WhitePrimaryBrush}" Height="46">
                                    <Grid>
                                        <TextBox BorderThickness="0" VerticalAlignment="Center" Padding="15,0,100,0" FontSize="13"/>
                                        <TextBlock Text="Your email..."
                                                   Foreground="{StaticResource Gray400Brush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="15,0,0,0"
                                                   IsHitTestVisible="False"/>
                                        <Button Content="JOIN" 
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="11"
                                                Padding="18,0"
                                                Height="36"
                                                HorizontalAlignment="Right"
                                                Margin="5"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footer Bottom -->
                        <Border BorderBrush="{StaticResource Gray700Brush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <Grid>
                                <TextBlock Foreground="{StaticResource Gray500Brush}" FontSize="12">
                                    <Run Text="© 2024 HoloCrew. All rights reserved."/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Privacy Policy" Foreground="{StaticResource Gray500Brush}" FontSize="12" Margin="0,0,20,0" Cursor="Hand"/>
                                    <TextBlock Text="Terms of Service" Foreground="{StaticResource Gray500Brush}" FontSize="12" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
