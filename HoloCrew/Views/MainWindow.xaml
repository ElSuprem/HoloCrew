<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER BAR -->
        <Border Grid.Row="0" 
                Background="{StaticResource BlackPrimaryBrush}">
            <TextBlock Text="FREE SHIPPING OVER 50€  |  14 DAYS RETURN POLICY  |  WORLDWIDE SHIPPING"
                       Foreground="{StaticResource WhitePrimaryBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- MAIN HEADER -->
        <Border Grid.Row="1" 
                Background="{StaticResource WhitePrimaryBrush}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <Border Grid.Column="0" Padding="0,0,40,0">
                    <TextBlock Text="HOLOCREW" 
                               FontSize="26" 
                               FontWeight="Black" 
                               Foreground="{StaticResource BlackPrimaryBrush}" 
                               VerticalAlignment="Center"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Border>

                <!-- MENU NAVIGATION -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="SHOP" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14" 
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="FLASH SALE" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToFlashSaleCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14"
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="BLACK WEEK" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToBlackWeekCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14"
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="MEMBERS CLUB" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToMembersClubCommand}"/>
                </StackPanel>

                <!-- SEARCH BAR -->
                <Border Grid.Column="2" 
                        Background="{StaticResource Gray100Brush}"
                        Width="300" 
                        Height="44"
                        Margin="0,0,35,0">
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="15,0,45,0"
                                 FontSize="14"/>
                        <TextBlock Text="Search products..."
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="🔍" 
                                   FontSize="16"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Right"
                                   Margin="0,0,15,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ACTION ICONS -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">

                    <Button Content="🔔" 
                            Style="{StaticResource IconButton}"
                            FontSize="22"
                            Command="{Binding NavigateToNotificationsCommand}"
                            ToolTip="Notificaciones"/>

                    <Button Content="♥" 
                            Style="{StaticResource IconButton}"
                            FontSize="22"
                            Command="{Binding NavigateToWishlistCommand}"
                            ToolTip="Lista de deseos"/>

                    <!-- Cart with badge -->
                    <Grid Margin="0,0,8,0">
                        <Button Content="🛒" 
                                Style="{StaticResource IconButton}"
                                FontSize="22"
                                Command="{Binding NavigateToCartCommand}"/>
                        <Border Background="{StaticResource RedAccentBrush}" 
                                Width="22" 
                                Height="22"
                                CornerRadius="11"
                                VerticalAlignment="Top" 
                                HorizontalAlignment="Right"
                                Margin="0,-6,-6,0"
                                Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="{Binding CartItemCount}" 
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       FontSize="11" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Button Content="👤" 
                            Style="{StaticResource IconButton}"
                            FontSize="22"
                            Command="{Binding NavigateToProfileCommand}"
                            ToolTip="Perfil"/>

                    <Button Content="⚙️" 
                            Style="{StaticResource IconButton}"
                            FontSize="22"
                            Command="{Binding NavigateToSettingsCommand}"
                            ToolTip="Configuración"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT AREA + FOOTER -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="2" 
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="600"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content Area -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentView}"/>

                <!-- FOOTER -->
                <Border Grid.Row="1"
                        Background="{StaticResource BlackPrimaryBrush}"
                        Padding="70,50,70,40">
                    <StackPanel>
                        <!-- Footer Main Grid -->
                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMNA 1: LOGO Y DESCRIPCIÓN -->
                            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                <TextBlock Text="HOLOCREW" 
                                           FontSize="22" 
                                           FontWeight="Black" 
                                           Foreground="{StaticResource WhitePrimaryBrush}" 
                                           Margin="0,0,0,18"/>
                                <TextBlock Text="Premium streetwear for those who dare to stand out. Quality meets style in every piece."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Margin="0,0,0,25"/>

                                <!-- Social Icons -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Margin="0,0,10,0"
                                            Cursor="Hand">
                                        <TextBlock Text="📘" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Margin="0,0,10,0"
                                            Cursor="Hand">
                                        <TextBlock Text="📷" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Cursor="Hand">
                                        <TextBlock Text="🐦" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- COLUMNA 2: ENLACES RÁPIDOS -->
                            <StackPanel Grid.Column="1" Margin="0,0,40,0">
                                <TextBlock Text="SHOP" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <Button Content="New Arrivals" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Best Sellers" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Sale" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Accessories" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- COLUMNA 3: AYUDA -->
                            <StackPanel Grid.Column="2" Margin="0,0,40,0">
                                <TextBlock Text="HELP" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <Button Content="Shipping Info" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Returns" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Size Guide" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Contact Us" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- COLUMNA 4: NEWSLETTER -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STAY UPDATED" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <TextBlock Text="Subscribe to get exclusive offers and early access to new drops."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Margin="0,0,0,18"/>
                                <Border Background="{StaticResource WhitePrimaryBrush}" 
                                        Height="50">
                                    <Grid>
                                        <TextBox BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 Padding="18,0,110,0"
                                                 FontSize="14"/>
                                        <TextBlock Text="Your email..."
                                                   Foreground="{StaticResource Gray400Brush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="18,0,0,0"
                                                   IsHitTestVisible="False"/>
                                        <Button Content="SUBSCRIBE" 
                                                Style="{StaticResource AccentButton}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Padding="22,0"
                                                HorizontalAlignment="Right"
                                                Margin="5"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footer Bottom -->
                        <Border BorderBrush="{StaticResource Gray700Brush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,25,0,0">
                            <Grid>
                                <TextBlock Foreground="{StaticResource Gray500Brush}"
                                           FontSize="13">
                                    <Run Text="© 2024 HoloCrew. All rights reserved."/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="Privacy Policy" 
                                               Foreground="{StaticResource Gray500Brush}"
                                               FontSize="13"
                                               Margin="0,0,25,0"
                                               Cursor="Hand"/>
                                    <TextBlock Text="Terms of Service" 
                                               Foreground="{StaticResource Gray500Brush}"
                                               FontSize="13"
                                               Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
