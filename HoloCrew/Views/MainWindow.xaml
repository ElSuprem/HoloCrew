<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Top Banner -->
            <RowDefinition Height="80"/>
            <!-- Main Header -->
            <RowDefinition Height="*"/>
            <!-- Content + Footer -->
        </Grid.RowDefinitions>

        <!-- ===================================
             TOP BANNER BAR
             =================================== -->
        <Border Grid.Row="0" 
                Background="{StaticResource BlackPrimaryBrush}">
            <TextBlock Text="FREE SHIPPING OVER 50€  |  14 DAYS RETURN POLICY  |  WORLDWIDE SHIPPING"
                       Foreground="{StaticResource WhitePrimaryBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- ===================================
             MAIN HEADER
             =================================== -->
        <Border Grid.Row="1" 
                Background="{StaticResource WhitePrimaryBrush}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1">
            <Grid Margin="60,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo -->
                    <ColumnDefinition Width="*"/>
                    <!-- Menu -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <TextBlock Grid.Column="0"
                           Text="HOLOCREW" 
                           FontSize="24" 
                           FontWeight="Black" 
                           Foreground="{StaticResource BlackPrimaryBrush}" 
                           VerticalAlignment="Center"
                           Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick" />
                    </TextBlock.InputBindings>
                </TextBlock>

                <!-- MENU NAVIGATION -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="SHOP" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14" 
                               VerticalAlignment="Center"/>
                    <Button Content="FLASH SALE" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14" 
                               VerticalAlignment="Center"/>
                    <Button Content="BLACK WEEK" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14" 
                               VerticalAlignment="Center"/>
                    <Button Content="MEMBERS CLUB" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                </StackPanel>

                <!-- SEARCH BAR -->
                <Border Grid.Column="2" 
                        Background="{StaticResource Gray100Brush}"
                        Width="280" 
                        Height="40"
                        Margin="0,0,30,0">
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="12,0,40,0"
                                 FontSize="14"/>
                        <TextBlock Text="Search products..."
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="🔍" 
                                   FontSize="16"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ACTION ICONS -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">

                    <!-- Notifications -->
                    <Button Content="🔔" 
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            Command="{Binding NavigateToNotificationsCommand}"
                            ToolTip="Notificaciones"/>

                    <!-- Wishlist -->
                    <Button Content="♥" 
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            Command="{Binding NavigateToWishlistCommand}"
                            ToolTip="Lista de deseos"/>

                    <!-- Cart with badge -->
                    <Grid>
                        <Button Content="🛒" 
                                Style="{StaticResource IconButton}"
                                FontSize="20"
                                Command="{Binding NavigateToCartCommand}"/>
                        <Border Background="{StaticResource RedAccentBrush}" 
                                Width="20" 
                                Height="20"
                                CornerRadius="10"
                                VerticalAlignment="Top" 
                                HorizontalAlignment="Right"
                                Margin="0,-5,-5,0"
                                Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                            <TextBlock Text="{Binding CartItemCount}" 
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Profile -->
                    <Button Content="👤" 
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            Command="{Binding NavigateToProfileCommand}"
                            ToolTip="Perfil"/>

                    <!-- Settings -->
                    <Button Content="⚙️" 
                            Style="{StaticResource IconButton}"
                            FontSize="20"
                            Command="{Binding NavigateToSettingsCommand}"
                            ToolTip="Configuración"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================
             CONTENT AREA + FOOTER
             =================================== -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="600"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content Area -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentView}"/>

                <!-- Footer -->
                <Border Grid.Row="1"
                        Background="{StaticResource BlackPrimaryBrush}"
                        Padding="60,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA 1: LOGO Y DESCRIPCIÓN -->
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="HOLOCREW" 
                                   FontSize="18" 
                                   FontWeight="Black" 
                                   Foreground="{StaticResource WhitePrimaryBrush}" 
                                   Margin="0,0,0,12" />
                            <TextBlock Text="Premium streetwear for those who dare to stand out. Quality meets style in every piece."
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                        </StackPanel>

                        <!-- COLUMNA 2: ENLACES RÁPIDOS -->
                        <StackPanel Grid.Column="1" Margin="0,0,30,0">
                            <TextBlock Text="ENLACES RÁPIDOS" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,15"/>
                            <Button Content="Nuevos Productos" Style="{StaticResource TextButton}" 
                                Foreground="{StaticResource Gray400Brush}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Ofertas Especiales" Style="{StaticResource TextButton}" 
                                Foreground="{StaticResource Gray400Brush}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Tops" Style="{StaticResource TextButton}" 
                                Foreground="{StaticResource Gray400Brush}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Bottoms" Style="{StaticResource TextButton}" 
                                Foreground="{StaticResource Gray400Brush}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <Button Content="Accesorios" Style="{StaticResource TextButton}" 
                                Foreground="{StaticResource Gray400Brush}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- COLUMNA 3: CONTACTO -->
                        <StackPanel Grid.Column="2" Margin="0,0,30,0">
                            <TextBlock Text="CONTACTO" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,15"/>
                            <TextBlock Foreground="{StaticResource Gray400Brush}" FontSize="13" Margin="0,0,0,8">
                            <Run Text="📍"/>
                            <Run Text="Calle Principal 123, Madrid"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Gray400Brush}" FontSize="13" Margin="0,0,0,8">
                            <Run Text="📞"/>
                            <Run Text="+34 900 123 456"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource Gray400Brush}" FontSize="13">
                            <Run Text="✉️"/>
                            <Run Text="info@holocrew.com"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- COLUMNA 4: NEWSLETTER -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="NEWSLETTER" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,15"/>
                            <TextBlock Text="Suscríbete para recibir ofertas exclusivas"
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                            <Border Background="{StaticResource WhitePrimaryBrush}" Height="45">
                                <Grid>
                                    <TextBox BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Padding="15,0,100,0"
                                         FontSize="14"/>
                                    <TextBlock Text="Tu email..."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           IsHitTestVisible="False"/>
                                    <Button Content="SUBSCRIBE" 
                                        Style="{StaticResource AccentButton}"
                                        FontSize="11"
                                        Padding="20,12"
                                        HorizontalAlignment="Right"
                                        Margin="5"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
