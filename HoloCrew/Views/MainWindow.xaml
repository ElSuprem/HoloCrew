<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR -->
        <Border Grid.Row="0" Background="{StaticResource BlackPrimaryBrush}">
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ShopMenuTrigger" Background="Transparent" Padding="0,0,25,0" Cursor="Hand"
                            MouseEnter="ShopMenu_MouseEnter" MouseLeave="ShopMenu_MouseLeave">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SHOP" Foreground="{StaticResource WhitePrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="▼" Foreground="{StaticResource WhitePrimaryBrush}" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="FLASH SALE" Foreground="{StaticResource WhitePrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,25,0" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToFlashSaleCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBlock Text="BLACK WEEK" Foreground="{StaticResource WhitePrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,25,0" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBlock Text="MEMBERS CLUB" Foreground="{StaticResource WhitePrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToMembersClubCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick"/>
                    </Border.InputBindings>
                    <TextBlock Text="HOLOCREW" FontSize="24" FontWeight="Black" Foreground="{StaticResource WhitePrimaryBrush}" FontStyle="Italic"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EUR €" Foreground="{StaticResource Gray400Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="|" Foreground="{StaticResource Gray600Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="SPAIN" Foreground="{StaticResource Gray400Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Buscar">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ToggleSearchCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                        </Viewbox>
                    </Border>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Lista de deseos">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToWishlistCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding WishlistItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding WishlistItemCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Mi cuenta">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToProfileCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M20 21V19C20 16.7909 18.2091 15 16 15H8C5.79086 15 4 16.7909 4 19V21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Notificaciones">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToNotificationsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8ZM13.73 21C13.5542 21.3031 13.3019 21.5547 12.9982 21.7295C12.6946 21.9044 12.3504 21.9965 12 21.9965C11.6496 21.9965 11.3054 21.9044 11.0018 21.7295C10.6982 21.5547 10.4458 21.3031 10.27 21" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding UnreadNotificationCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Carrito">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToCartCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6ZM3 6H21M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <Border Background="{StaticResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CartItemCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Configuración">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToSettingsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="18" Height="18">
                            <Path Data="M12 15a3 3 0 100-6 3 3 0 000 6z M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MEGA MENU DROPDOWN -->
        <Border x:Name="MegaMenuDropdown" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource WhitePrimaryBrush}" VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="1000" MouseEnter="ShopMenu_MouseEnter" MouseLeave="ShopMenu_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="70,35,40,35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHOP ALL" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="BLACK WEEK" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="NEW ARRIVALS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="new" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SOFTS COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="softs" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="CLASSIC COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="classic" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TOPS" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="T-SHIRTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="tshirts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="HOODIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="hoodies" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JACKETS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="jackets" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JERSEYS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="jerseys" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BOTTOMS" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="CARGO PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="cargo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JOGGERS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="joggers" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="DENIM" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="denim" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SHORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="shorts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="FOOTWEAR" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="ARMBO LOWS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="armbo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SNEAKERS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="sneakers" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SLIDES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="slides" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ACCESSORIES" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="CAPS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="caps" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BAGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="bags" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BEANIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="beanies" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="#F5F5F5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <TextBlock Text="SOFTS COLLECTION" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Premium comfort for everyday wear." FontSize="13" Foreground="{StaticResource Gray600Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,20" MaxWidth="250"/>
                        <Button Content="VIEW ALL" Style="{StaticResource OutlineButton}" Padding="25,12" FontSize="12" HorizontalAlignment="Center" Command="{Binding NavigateToCatalogCommand}" CommandParameter="softs"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SEARCH BAR -->
        <Border x:Name="SearchBarExpanded" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource BlackPrimaryBrush}" Height="60" VerticalAlignment="Top" Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}" IsVisibleChanged="SearchBar_IsVisibleChanged" Panel.ZIndex="999">
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource WhitePrimaryBrush}" VerticalAlignment="Center" Height="44" Margin="0,0,20,0">
                    <Grid>
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" Stroke="{StaticResource Gray400Brush}" StrokeThickness="2" Fill="Transparent"/>
                        </Viewbox>
                        <TextBox x:Name="SearchTextBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="45,0,15,0" FontSize="15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding ToggleSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Search for products..." Foreground="{StaticResource Gray400Brush}" FontSize="15" VerticalAlignment="Center" Margin="45,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="44" Height="44" Background="Transparent" Cursor="Hand" ToolTip="Cerrar">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSearchCommand}"/>
                    </Border.InputBindings>
                    <Viewbox Width="16" Height="16">
                        <Path Data="M18 6L6 18M6 6L18 18" Stroke="{StaticResource WhitePrimaryBrush}" StrokeThickness="2"/>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>

        <!-- BANNER PROMO ANIMADO -->
        <Border Grid.Row="1" Background="#FF6B00" Cursor="Hand" Visibility="{Binding IsSearchVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
            </Border.InputBindings>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="BannerText" Storyboard.TargetProperty="(Canvas.Left)" From="1400" To="-1200" Duration="0:0:20"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Canvas ClipToBounds="True" Height="35">
                <TextBlock x:Name="BannerText" Canvas.Top="8" Text="🔥 BLACK WEEK - UP TO 50% OFF    ⭐ FREE SHIPPING OVER €50    🎁 NEW ARRIVALS WEEKLY    🔥 BLACK WEEK - UP TO 50% OFF    ⭐ FREE SHIPPING OVER €50    🎁 NEW ARRIVALS WEEKLY" Foreground="White" FontSize="13" FontWeight="Bold"/>
            </Canvas>
        </Border>

        <!-- CONTENT AREA (SIN FOOTER) -->
        <ScrollViewer Grid.Row="2" x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <ContentControl Content="{Binding CurrentView}"/>
        </ScrollViewer>
    </Grid>
</Window>
