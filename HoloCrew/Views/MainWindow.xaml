<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER BAR -->
        <Border Grid.Row="0" 
                Background="{StaticResource BlackPrimaryBrush}">
            <TextBlock Text="FREE SHIPPING OVER 50€  |  14 DAYS RETURN POLICY  |  WORLDWIDE SHIPPING"
                       Foreground="{StaticResource WhitePrimaryBrush}"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- MAIN HEADER -->
        <Border Grid.Row="1" 
                Background="{StaticResource WhitePrimaryBrush}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid Margin="70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO -->
                <Border Grid.Column="0" Padding="0,0,40,0">
                    <TextBlock Text="HOLOCREW" 
                               FontSize="26" 
                               FontWeight="Black" 
                               Foreground="{StaticResource BlackPrimaryBrush}" 
                               VerticalAlignment="Center"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </Border>

                <!-- MENU NAVIGATION -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="SHOP" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14" 
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="FLASH SALE" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToFlashSaleCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14"
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="BLACK WEEK" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToBlackWeekCommand}"/>
                    <TextBlock Text="|" 
                               Foreground="{StaticResource Gray300Brush}" 
                               FontSize="14"
                               Margin="4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="MEMBERS CLUB" 
                            Style="{StaticResource MenuButton}"
                            Command="{Binding NavigateToMembersClubCommand}"/>
                </StackPanel>

                <!-- SEARCH BAR -->
                <Border Grid.Column="2" 
                        Background="{StaticResource Gray100Brush}"
                        Width="300" 
                        Height="44"
                        Margin="0,0,35,0">
                    <Grid>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Padding="15,0,45,0"
                                 FontSize="14">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Search products..."
                                   Foreground="{StaticResource Gray400Brush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Background="Transparent"
                                Width="40"
                                Height="44"
                                HorizontalAlignment="Right"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ExecuteSearchCommand}"/>
                            </Border.InputBindings>
                            <TextBlock Text="🔍" 
                                       FontSize="16"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,10,0"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ⭐ ICONOS DEL HEADER (RIGHT SIDE) -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Wishlist Icon con Badge -->
                    <Border Background="Transparent" 
                            Width="44" Height="44" 
                            Cursor="Hand" 
                            Margin="0,0,8,0"
                            ToolTip="Lista de deseos">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToWishlistCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <TextBlock Text="🤍" 
                                       FontSize="22" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <!-- Badge de wishlist -->
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="8"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Visibility="{Binding WishlistItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding WishlistItemCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cart Icon con Badge -->
                    <Border Background="Transparent" 
                            Width="44" Height="44" 
                            Cursor="Hand" 
                            Margin="0,0,8,0"
                            ToolTip="Carrito de compras">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToCartCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <TextBlock Text="🛒" 
                                       FontSize="22" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="8"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CartItemCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ⭐ NUEVO: Notifications Icon (Campanita) con Badge -->
                    <Border Background="Transparent" 
                            Width="44" Height="44" 
                            Cursor="Hand" 
                            Margin="0,0,8,0"
                            ToolTip="Notificaciones">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToNotificationsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <TextBlock Text="🔔" 
                                       FontSize="22" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <!-- Badge de notificaciones no leídas -->
                            <Border Background="{StaticResource RedAccentBrush}"
                                    CornerRadius="8"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Visibility="{Binding UnreadNotificationCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Profile Icon - SIEMPRE VISIBLE, CAMBIA SEGÚN LOGIN -->
                    <Border Background="Transparent" 
                            Width="44" Height="44" 
                            Cursor="Hand" 
                            Margin="0,0,8,0"
                            ToolTip="Mi cuenta">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToProfileCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <!-- Icono dinámico: 👤 (no logged) → 👨 (logged) -->
                        <TextBlock FontSize="22" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="👤"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                            <Setter Property="Text" Value="👨"/>
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Settings Icon - SIEMPRE VISIBLE -->
                    <Border Background="Transparent" 
                            Width="44" Height="44" 
                            Cursor="Hand"
                            ToolTip="Configuración">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToSettingsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <TextBlock Text="⚙️" 
                                   FontSize="22" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Opacity="0.7"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT AREA CON SCROLL -->
        <ScrollViewer Grid.Row="2" 
                      x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DYNAMIC CONTENT -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentView}"/>

                <!-- FOOTER -->
                <Border Grid.Row="1" 
                        Background="{StaticResource BlackPrimaryBrush}"
                        Padding="70,70,70,35">
                    <StackPanel>
                        <Grid Margin="0,0,0,45">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUMNA 1: ABOUT -->
                            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                <TextBlock Text="HOLOCREW" 
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           Margin="0,0,0,20"/>
                                <TextBlock Text="Premium streetwear for the next generation. Express yourself with our exclusive collections."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Margin="0,0,0,25"/>
                                <TextBlock Text="Follow Us"
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Margin="0,0,10,0"
                                            Cursor="Hand">
                                        <TextBlock Text="📷" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Margin="0,0,10,0"
                                            Cursor="Hand">
                                        <TextBlock Text="👤" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{StaticResource Gray800Brush}"
                                            Width="40" Height="40"
                                            Cursor="Hand">
                                        <TextBlock Text="🐦" 
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- COLUMNA 2: ENLACES RÁPIDOS -->
                            <StackPanel Grid.Column="1" Margin="0,0,40,0">
                                <TextBlock Text="SHOP" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <Button Content="New Arrivals" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Best Sellers" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Sale" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Accessories" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- COLUMNA 3: AYUDA -->
                            <StackPanel Grid.Column="2" Margin="0,0,40,0">
                                <TextBlock Text="HELP" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <Button Content="Shipping Info" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Returns" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Size Guide" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10"/>
                                <Button Content="Contact Us" 
                                        Style="{StaticResource TextButton}" 
                                        Foreground="{StaticResource Gray400Brush}" 
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- COLUMNA 4: NEWSLETTER -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STAY UPDATED" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Foreground="{StaticResource WhitePrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                <TextBlock Text="Subscribe to get exclusive offers and early access to new drops."
                                           Foreground="{StaticResource Gray400Brush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           LineHeight="22"
                                           Margin="0,0,0,18"/>
                                <Border Background="{StaticResource WhitePrimaryBrush}" 
                                        Height="50">
                                    <Grid>
                                        <TextBox BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 Padding="18,0,110,0"
                                                 FontSize="14"/>
                                        <TextBlock Text="Your email..."
                                                   Foreground="{StaticResource Gray400Brush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="18,0,0,0"
                                                   IsHitTestVisible="False"/>
                                        <Button Content="SUBSCRIBE" 
                                                Style="{StaticResource AccentButton}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Padding="22,0"
                                                HorizontalAlignment="Right"
                                                Margin="5"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Footer Bottom -->
                        <Border BorderBrush="{StaticResource Gray700Brush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,25,0,0">
                            <Grid>
                                <TextBlock Foreground="{StaticResource Gray500Brush}"
                                           FontSize="13">
                                    <Run Text="© 2024 HoloCrew. All rights reserved."/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="Privacy Policy" 
                                               Foreground="{StaticResource Gray500Brush}"
                                               FontSize="13"
                                               Margin="0,0,25,0"
                                               Cursor="Hand"/>
                                    <TextBlock Text="Terms of Service" 
                                               Foreground="{StaticResource Gray500Brush}"
                                               FontSize="13"
                                               Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
