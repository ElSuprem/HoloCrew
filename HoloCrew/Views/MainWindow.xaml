<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Tu Tienda Online"
        Height="768" 
        Width="1366"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Content -->
            <RowDefinition Height="Auto" />
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ============ HEADER / NAVIGATION BAR ============ -->
        <Border Grid.Row="0" 
                Background="#1976D2" 
                Height="70"
                BorderThickness="0,0,0,1"
                BorderBrush="#115293">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Logo -->
                    <ColumnDefinition Width="*" />
                    <!-- Menú -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Búsqueda -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Acciones -->
                </Grid.ColumnDefinitions>

                <!-- Logo y Nombre -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <TextBlock Text="🛒" 
                               FontSize="32" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="HoloCrew" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Menú de Navegación -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            Margin="40,0,0,0"
                            VerticalAlignment="Center">

                    <Button Content="Inicio" 
                            Command="{Binding NavigateToHomeCommand}"
                            Style="{StaticResource MenuButtonStyle}"
                            Margin="0,0,10,0" />

                    <Button Content="Catálogo" 
                            Command="{Binding NavigateToCatalogCommand}"
                            Style="{StaticResource MenuButtonStyle}"
                            Margin="0,0,10,0" />

                </StackPanel>

                <!-- Acciones -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">

                    <!-- Wishlist -->
                    <Button Command="{Binding NavigateToWishlistCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,15,0">
                        <Grid>
                            <TextBlock Text="♥" 
                                       FontSize="24" 
                                       Foreground="White" />
                        </Grid>
                    </Button>

                    <!-- Carrito -->
                    <Button Command="{Binding NavigateToCartCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,15,0">
                        <Grid>
                            <TextBlock Text="🛒" 
                                       FontSize="24" 
                                       Foreground="White" />

                            <!-- Badge con contador -->
                            <Border Background="#FF6F00"
                                    CornerRadius="10"
                                    Padding="5,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-8,0"
                                    Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CartItemCount}" 
                                           Foreground="White" 
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Usuario -->
                    <Button Command="{Binding NavigateToProfileCommand}"
                            Style="{StaticResource IconButtonStyle}">
                        <TextBlock Text="👤" 
                                   FontSize="24" 
                                   Foreground="White" />
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CONTENT AREA (Vistas dinámicas) ============ -->
        <ContentControl Grid.Row="1" 
                        Content="{Binding CurrentView}" 
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- ============ FOOTER ============ -->
        <Border Grid.Row="2" 
                Background="#263238" 
                Padding="20,15"
                BorderThickness="0,1,0,0"
                BorderBrush="#1C2428">
            <Grid>
                <TextBlock Text="© 2024 HoloCrew - Todos los derechos reservados" 
                           Foreground="#B0BEC5" 
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>