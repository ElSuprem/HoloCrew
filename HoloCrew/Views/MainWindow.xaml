<Window x:Class="HoloCrew.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HoloCrew - Premium Streetwear" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource BlackPrimaryBrush}"
        Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top nav bar (black) - main links centered -->
            <RowDefinition Height="45"/>
            <!-- Row 1: Sub nav bar (white) - SHOP+MEMBER left, Logo center, icons right -->
            <RowDefinition Height="55"/>
            <!-- Row 2: Content area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- ROW 0: TOP NAVIGATION BAR (BLACK)            -->
        <!-- Centered links: SHOP / FLASH SALE / BLACK WEEK / MEMBERS CLUB -->
        <!-- ============================================ -->
        <!-- TOP BAR: Always dark regardless of theme -->
        <Border Grid.Row="0" Background="#0A0A0A">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="SHOP" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,50,0" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NavigateToCatalogCommand}" MouseAction="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <TextBlock Text="FLASH SALE" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,50,0" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NavigateToFlashSaleCommand}" MouseAction="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <TextBlock Text="BLACK WEEK" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,50,0" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <TextBlock Text="MEMBERS CLUB" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding Command="{Binding NavigateToMembersClubCommand}" MouseAction="LeftClick"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- ROW 1: SUB NAVIGATION BAR (WHITE)            -->
        <!-- Left: SHOP dropdown + MEMBER CLUB            -->
        <!-- Center: HOLOCREW logo                        -->
        <!-- Right: EUR € | SPAIN + Search/Wishlist/User/Cart -->
        <!-- ============================================ -->
        <Border Grid.Row="1" Background="{DynamicResource WhitePrimaryBrush}"
                BorderBrush="{DynamicResource Gray200Brush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: SHOP dropdown + MEMBER CLUB -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ShopMenuTrigger" Background="Transparent" Padding="0,0,25,0" Cursor="Hand"
                            MouseEnter="ShopMenu_MouseEnter" MouseLeave="ShopMenu_MouseLeave">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SHOP" Foreground="{DynamicResource BlackPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" Foreground="{DynamicResource BlackPrimaryBrush}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MEMBER CLUB" Foreground="{DynamicResource BlackPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding Command="{Binding NavigateToMembersClubCommand}" MouseAction="LeftClick"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

                <!-- CENTER: Logo -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding NavigateToHomeCommand}" MouseAction="LeftClick"/>
                    </Border.InputBindings>
                    <TextBlock Text="HOLOCREW" FontSize="22" FontWeight="Black" Foreground="{DynamicResource BlackPrimaryBrush}" FontStyle="Italic"/>
                </Border>

                <!-- RIGHT: Currency + Icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="EUR €" Foreground="{DynamicResource Gray500Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="|" Foreground="{DynamicResource Gray300Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SPAIN" Foreground="{DynamicResource Gray500Brush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <!-- Down arrow for country -->
                    <TextBlock Text="▾" Foreground="{DynamicResource Gray400Brush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <!-- Search -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Search">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ToggleSearchCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                        </Viewbox>
                    </Border>

                    <!-- Wishlist -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Wishlist">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToWishlistCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <Border Background="{DynamicResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding WishlistItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding WishlistItemCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- User account -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="My Account">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToProfileCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="20" Height="20">
                            <Path Data="M20 21V19C20 16.7909 18.2091 15 16 15H8C5.79086 15 4 16.7909 4 19V21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>

                    <!-- Notifications -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Notifications">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToNotificationsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8ZM13.73 21C13.5542 21.3031 13.3019 21.5547 12.9982 21.7295C12.6946 21.9044 12.3504 21.9965 12 21.9965C11.6496 21.9965 11.3054 21.9044 11.0018 21.7295C10.6982 21.5547 10.4458 21.3031 10.27 21" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <Border Background="{DynamicResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding UnreadNotificationCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Settings -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Settings">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToSettingsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Viewbox Width="18" Height="18">
                            <Path Data="M12 15a3 3 0 100-6 3 3 0 000 6z M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Viewbox>
                    </Border>

                    <!-- Cart (bag icon like web) -->
                    <Border Background="Transparent" Width="40" Height="40" Cursor="Hand" ToolTip="Cart">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToCartCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6ZM3 6H21M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <Border Background="{DynamicResource RedAccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding CartItemCount, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Text="{Binding CartItemCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MEGA MENU DROPDOWN                           -->
        <!-- Matches web: 6 columns + collection image    -->
        <!-- ============================================ -->
        <Border x:Name="MegaMenuDropdown" Grid.Row="1" Grid.RowSpan="2" 
                Background="{DynamicResource WhitePrimaryBrush}" 
                VerticalAlignment="Top" 
                Margin="0,55,0,0"
                Visibility="Collapsed" 
                Panel.ZIndex="1000" 
                MouseEnter="ShopMenu_MouseEnter" 
                MouseLeave="ShopMenu_MouseLeave">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.12" BlurRadius="25" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Category columns -->
                <Grid Grid.Column="0" Margin="50,35,30,35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SHOP ALL -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHOP ALL" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="BLACK WEEK" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToBlackWeekCommand}" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="NEW ARRIVALS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="new" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SOFTS COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="softs" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="CLASSIC COLLECTION" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="classic" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="ACTIVEWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="activewear" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="TRACKSUITS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="tracksuits" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <!-- TOPS -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TOPS" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="T-SHIRTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="tshirts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="HOODIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="hoodies" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="TRACK JACKETS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="trackjackets" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JERSEYS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="jerseys" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="KNITWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="knitwear" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JACKETS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="jackets" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <!-- BOTTOMS -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BOTTOMS" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="DENIM PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="denim" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="CARGO PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="cargo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JOGGERS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="joggers" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="TRACK PANTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="trackpants" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="JORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="jorts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SHORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="shorts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="SWIMSHORTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="swimshorts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="UNDERWEAR" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="underwear" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <!-- FOOTWEAR -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="FOOTWEAR" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="ARMBO LOWS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="armbo" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="VORTEX" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="vortex" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="VENTURE" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="venture" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="VITORIA" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="vitoria" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="V-SLIDES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="slides" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <!-- ACCESSORIES -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ACCESSORIES" FontWeight="Bold" FontSize="13" Margin="0,0,0,18"/>
                        <TextBlock Text="CAPS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="caps" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BAGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="bags" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BEANIES" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="beanies" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="CARDHOLDER" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="cardholder" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="BELTS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="belts" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="RINGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="rings" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="RUGS" Style="{StaticResource MegaMenuLink}" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NavigateToCatalogCommand}" CommandParameter="rugs" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Collection promo panel (right side) -->
                <Border Grid.Column="1" Background="{DynamicResource Gray100Brush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <TextBlock Text="SOFTS COLLECTION" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Discover our premium soft collection designed for comfort." FontSize="13" Foreground="{DynamicResource Gray600Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,20" MaxWidth="280"/>
                        <Button Content="VIEW ALL" Style="{StaticResource OutlineButton}" Padding="25,12" FontSize="12" HorizontalAlignment="Center" Command="{Binding NavigateToCatalogCommand}" CommandParameter="softs"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <!-- ============================================ -->
        <!-- SEARCH BAR + LIVE RESULTS DROPDOWN           -->
        <!-- ============================================ -->
        <Border x:Name="SearchBarExpanded" Grid.Row="1" Grid.RowSpan="2"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                IsVisibleChanged="SearchBar_IsVisibleChanged" 
                Panel.ZIndex="2000"
                VerticalAlignment="Top">

            <Grid>
                <!-- Dark backdrop (click to close) -->
                <Border Background="#80000000" 
                        VerticalAlignment="Stretch"
                        MinHeight="800">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSearchCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Search panel -->
                <Border Background="{DynamicResource WhitePrimaryBrush}" 
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource Gray200Brush}"
                        BorderThickness="0,0,0,1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="5" Direction="270"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Search input row -->
                        <Border Padding="50,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search icon -->
                                <Viewbox Grid.Column="0" Width="22" Height="22" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" 
                                          Stroke="{DynamicResource Gray400Brush}" StrokeThickness="2" Fill="Transparent"/>
                                </Viewbox>

                                <!-- Search input -->
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchTextBox" 
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="{DynamicResource BlackPrimaryBrush}"
                                             CaretBrush="{DynamicResource BlackPrimaryBrush}"
                                             VerticalAlignment="Center" 
                                             VerticalContentAlignment="Center" 
                                             FontSize="18"
                                             FontWeight="Light">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}"/>
                                            <KeyBinding Key="Escape" Command="{Binding ToggleSearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <!-- Placeholder -->
                                    <TextBlock Text="Search for products, categories..." 
                                               Foreground="{DynamicResource Gray400Brush}" 
                                               FontSize="18" 
                                               FontWeight="Light"
                                               VerticalAlignment="Center" 
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Loading indicator -->
                                <TextBlock Grid.Column="2" Text="Searching..." 
                                           FontSize="12" Foreground="{DynamicResource Gray400Brush}" 
                                           VerticalAlignment="Center" Margin="0,0,15,0"
                                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Close button -->
                                <Border Grid.Column="3" Width="36" Height="36" Cursor="Hand" VerticalAlignment="Center">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleSearchCommand}"/>
                                    </Border.InputBindings>
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M18 6L6 18M6 6L18 18" Stroke="{DynamicResource Gray500Brush}" StrokeThickness="2.5"/>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource Gray200Brush}"/>

                        <!-- LIVE SEARCH RESULTS -->
                        <Border Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="50,10,50,20"
                                MaxHeight="450">
                            <StackPanel>
                                <!-- Results count -->
                                <TextBlock FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="0,8,0,12">
                                    <Run Text="{Binding SearchResultCount, Mode=OneWay}"/>
                                    <Run Text=" results found"/>
                                </TextBlock>

                                <!-- Product results -->
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,12" Margin="0,0,0,2" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.ViewSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Product image placeholder -->
                                                    <Border Grid.Column="0" Width="50" Height="50" 
                                                            Background="{DynamicResource Gray100Brush}"/>

                                                    <!-- Product info -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" 
                                                                   FontSize="14" FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource BlackPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Category.Name}" 
                                                                   FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <!-- Price -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}" 
                                                                   FontSize="12" Foreground="{DynamicResource Gray400Brush}" 
                                                                   TextDecorations="Strikethrough" HorizontalAlignment="Right"
                                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- View all results -->
                                <Border Margin="0,10,0,5" Padding="12" Cursor="Hand" Background="{DynamicResource BlackPrimaryBrush}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExecuteSearchCommand}"/>
                                    </Border.InputBindings>
                                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White">
                                        <Run Text="VIEW ALL "/><Run Text="{Binding SearchResultCount, Mode=OneWay}"/><Run Text=" RESULTS"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Quick categories (when no query) -->
                        <Border Padding="50,15,50,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchResults}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="POPULAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="hoodies"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Hoodies" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="tshirts"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="T-Shirts" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="denim"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Denim" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="sneakers"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Sneakers" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="bags"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Bags" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}" CommandParameter="new"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="New Arrivals" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Gray100Brush}" Padding="14,8" Margin="0,0,8,8" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToBlackWeekCommand}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="Black Week" FontSize="13" Foreground="{DynamicResource Gray700Brush}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- CONTENT AREA                                 -->
        <!-- ============================================ -->
        <ScrollViewer Grid.Row="2" x:Name="MainScrollViewer" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled" 
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <ContentControl Content="{Binding CurrentView}"/>
        </ScrollViewer>
    </Grid>
</Window>
