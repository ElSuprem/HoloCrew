<UserControl x:Class="HoloCrew.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:HoloCrew.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <!-- ✅ REGISTRA TU CONVERTER PERSONALIZADO -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock Text="Historial de Pedidos" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,30" />

            <!-- Filtros -->
            <Border Background="#F8F9FA"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filtrar por:" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0" />

                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              Width="200"
                              Padding="12,8"
                              FontSize="14"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              Margin="0,0,20,0" />

                    <TextBlock Text="Desde:" 
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <DatePicker SelectedDate="{Binding StartDate}"
                                Width="150"
                                Padding="10,8"
                                FontSize="14"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Margin="0,0,20,0" />

                    <TextBlock Text="Hasta:" 
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <DatePicker SelectedDate="{Binding EndDate}"
                                Width="150"
                                Padding="10,8"
                                FontSize="14"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Margin="0,0,20,0" />

                    <Button Content="Aplicar" 
                            Command="{Binding ApplyFiltersCommand}"
                            Padding="15,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Lista de pedidos -->
            <ItemsControl ItemsSource="{Binding Orders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,0,0,20"
                                Padding="25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Estado -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Detalles -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Total -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Acciones -->
                                </Grid.ColumnDefinitions>

                                <!-- Estado -->
                                <Border Grid.Column="0" 
                                        Background="{Binding StatusColor}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        Margin="0,0,20,0">
                                    <TextBlock Text="{Binding StatusText}" 
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <!-- Detalles del pedido -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding OrderNumber}" 
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding OrderDate, StringFormat='Fecha: {0:dd/MM/yyyy}'}" 
                                               FontSize="14"
                                               Foreground="#666"
                                               Margin="0,0,0,5" />

                                    <!-- CORREGIDO: Línea 149 - Error de StringFormat -->
                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} productos}" 
                                               FontSize="14"
                                               Foreground="#666" />
                                </StackPanel>

                                <!-- Total -->
                                <StackPanel Grid.Column="2" 
                                            Margin="20,0,20,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='€{0:N2}'}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1976D2" />
                                </StackPanel>

                                <!-- Acciones -->
                                <StackPanel Grid.Column="3" 
                                            VerticalAlignment="Center">
                                    <Button Content="Ver Detalles" 
                                            Command="{Binding DataContext.ViewOrderDetailCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="15,10"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="Transparent"
                                            Foreground="#1976D2"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Margin="0,0,0,10">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Volver a pedir" 
                                            Command="{Binding DataContext.ReorderCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="15,10"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Background="Transparent"
                                            Foreground="#4CAF50"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sin pedidos -->
            <!-- ✅ AHORA SÍ FUNCIONARÁ porque el converter está registrado -->
            <Border Visibility="{Binding HasNoOrders, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#FFF3E0"
                    CornerRadius="12"
                    Padding="40"
                    Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📦" 
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />
                    <TextBlock Text="No hay pedidos aún" 
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#E65100"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Cuando realices tu primer pedido, aparecerá aquí" 
                               FontSize="14"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="0,0,0,20" />
                    <Button Content="Ver productos" 
                            Command="{Binding BrowseProductsCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <Grid Height="200"
                  VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Cargando pedidos..." 
                               FontSize="16" 
                               Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>