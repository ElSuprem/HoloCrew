<UserControl x:Class="HoloCrew.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Border Padding="60,40,60,80">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="ORDER HISTORY" 
                       Style="{StaticResource HeadingLarge}"
                       Margin="0,0,0,40" />

            <!-- Filtros -->
            <Border Background="{DynamicResource Gray100Brush}"
                    Padding="35,28"
                    Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- STATUS -->
                    <TextBlock Grid.Column="0"
                               Text="STATUS:" 
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              Height="48"
                              VerticalContentAlignment="Center"
                              Padding="15,0"
                              FontSize="14"/>

                    <!-- FROM -->
                    <TextBlock Grid.Column="3"
                               Text="FROM:" 
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding StartDate}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,0,8,0"
                                FontSize="14"/>

                    <!-- TO -->
                    <TextBlock Grid.Column="6"
                               Text="TO:" 
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <DatePicker Grid.Column="7"
                                SelectedDate="{Binding EndDate}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,0,8,0"
                                FontSize="14"/>

                    <!-- APPLY (alineado a la derecha gracias a Width=*) -->
                    <Button Grid.Column="9"
                            Content="APPLY" 
                            Style="{StaticResource PrimaryButton}"
                            FontSize="13"
                            Padding="32,14"
                            Height="48"
                            Command="{Binding ApplyFiltersCommand}"/>
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Background="{DynamicResource Gray100Brush}"
                    Padding="60,80"
                    Visibility="{Binding HasOrders, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="" 
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="NO ORDERS YET" 
                               Style="{StaticResource HeadingMedium}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="You haven't placed any orders yet" 
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center"
                               Margin="0,0,0,30"/>
                    <Button Content="START SHOPPING" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseProductsCommand}"/>
                </StackPanel>
            </Border>

            <!-- Orders List -->
            <ItemsControl ItemsSource="{Binding Orders}"
                          Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource WhitePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="1"
                                Padding="35,28"
                                Margin="0,0,0,18"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding DataContext.ViewOrderDetailCommand, 
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              MouseAction="LeftClick"/>
                            </Border.InputBindings>

                            <!-- Una sola fila con todo centrado verticalmente -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Order Number & Date -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SubtitleLarge}"
                                               FontWeight="Bold">
                                        <Run Text="ORDER #"/>
                                        <Run Text="{Binding OrderNumber, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='MMMM dd, yyyy'}"
                                               Style="{StaticResource BodyMedium}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Items count -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,30,0">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource SubtitleLarge}"
                                               FontWeight="Bold">
                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="ITEMS"
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2"
                                        Background="#1A1A1A"
                                        Padding="18,10"
                                        VerticalAlignment="Center"
                                        Margin="0,0,30,0">
                                    <TextBlock Text="{Binding Status, Mode=OneWay}"
                                               Style="{StaticResource Caption}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WhitePrimaryBrush}"/>
                                </Border>

                                <!-- Total -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Total, StringFormat='{}{0:N2}€'}"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,30,0"/>

                                <!-- View Details -->
                                <Button Grid.Column="4"
                                        Content="VIEW DETAILS →"
                                        Style="{StaticResource TextButton}"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ViewOrderDetailCommand, 
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stats Summary -->
            <Border Background="{DynamicResource Gray100Brush}"
                    Padding="40,35"
                    Margin="0,30,0,0"
                    Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Orders -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalOrders}"
                                   Style="{StaticResource HeadingLarge}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="TOTAL ORDERS" 
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Total Spent -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalSpent, StringFormat='{}{0:N2}€'}"
                                   Style="{StaticResource HeadingLarge}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="TOTAL SPENT" 
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Avg Order Value -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AverageOrderValue, StringFormat='{}{0:N2}€'}"
                                   Style="{StaticResource HeadingLarge}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="AVG ORDER VALUE" 
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>