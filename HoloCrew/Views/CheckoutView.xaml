<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="80,50,40,80">
                <StackPanel>

                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="CHECKOUT" 
                                   Style="{StaticResource HeadingLarge}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shipping" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Width="30" Height="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Payment" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Width="30" Height="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Gray300Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Confirm" FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- PASO 1: INFORMACIÓN DE ENVÍO -->
                    <Border Background="{DynamicResource WhitePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,25"
                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="SHIPPING INFORMATION" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,25"/>

                            <StackPanel Visibility="{Binding SavedAddresses.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                        Margin="0,0,0,25">
                                <TextBlock Text="Saved addresses" 
                                           Style="{StaticResource SubtitleMedium}"
                                           Margin="0,0,0,15"/>
                                <ItemsControl ItemsSource="{Binding SavedAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderDefault}"
                                                    BorderThickness="1"
                                                    Padding="15"
                                                    Margin="0,0,0,10"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectSavedAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0">
                                                        <Run Text="{Binding FullName}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding AddressLine1}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ Add new address"
                                        Style="{StaticResource TextButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddNewAddressCommand}"
                                        Margin="0,5,0,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Full Name *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ShippingAddress.FullName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{DynamicResource Gray300Brush}"
                                             BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ShippingAddress.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{DynamicResource Gray300Brush}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Address *" 
                                           Style="{StaticResource BodyMedium}"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding ShippingAddress.AddressLine1, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50"
                                         VerticalContentAlignment="Center"
                                         Padding="15,0"
                                         FontSize="14"
                                         BorderBrush="{DynamicResource Gray300Brush}"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Apartment, floor, etc. (optional)" 
                                           Style="{StaticResource BodyMedium}"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding ShippingAddress.AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50"
                                         VerticalContentAlignment="Center"
                                         Padding="15,0"
                                         FontSize="14"
                                         BorderBrush="{DynamicResource Gray300Brush}"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="City *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ShippingAddress.City, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{DynamicResource Gray300Brush}"
                                             BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Postal Code *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ShippingAddress.PostalCode, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{DynamicResource Gray300Brush}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Country *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Height="50"
                                              VerticalContentAlignment="Center"
                                              Padding="15,0"
                                              FontSize="14"
                                              BorderBrush="{DynamicResource Gray300Brush}"
                                              BorderThickness="1"
                                              SelectedValue="{Binding ShippingAddress.Country}"
                                              SelectedValuePath="Content">
                                        <ComboBoxItem Content="Spain" IsSelected="True"/>
                                        <ComboBoxItem Content="Portugal"/>
                                        <ComboBoxItem Content="France"/>
                                        <ComboBoxItem Content="Italy"/>
                                        <ComboBoxItem Content="Germany"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="State/Province" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding ShippingAddress.State, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{DynamicResource Gray300Brush}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PASO 2: MÉTODO DE PAGO -->
                    <Border Background="{DynamicResource WhitePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,25"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="PAYMENT METHOD" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,15"/>

                            <Border Background="#FEF3C7"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="1"
                                    Padding="15"
                                    Margin="0,0,0,25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Demo mode — no real charge is made"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#92400E"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#78350F">
                                        <Run Text="Use the test card "/>
                                        <Run Text="4242 4242 4242 4242" FontWeight="Bold" FontFamily="Consolas"/>
                                        <Run Text=" with any future date and any CVV (e.g. "/>
                                        <Run Text="12/30" FontFamily="Consolas"/>
                                        <Run Text=", "/>
                                        <Run Text="123" FontFamily="Consolas"/>
                                        <Run Text=")."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Cardholder Name *" 
                                           Style="{StaticResource BodyMedium}"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding CardholderName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50"
                                         VerticalContentAlignment="Center"
                                         Padding="15,0"
                                         FontSize="14"
                                         BorderBrush="{DynamicResource Gray300Brush}"
                                         BorderThickness="1"
                                         MaxLength="60"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Card Number *" 
                                           Style="{StaticResource BodyMedium}"
                                           Margin="0,0,0,8"/>
                                <Border BorderThickness="1" Height="50">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCardNumberValid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             Padding="15,0"
                                             FontSize="14"
                                             FontFamily="Consolas"
                                             MaxLength="19"/>
                                </Border>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Expiration Date * (MM/YY)" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderThickness="1" Height="50">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpirationDateValid}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="15,0"
                                                 FontSize="14"
                                                 FontFamily="Consolas"
                                                 MaxLength="5"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CVV *" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <Border BorderThickness="1" Height="50">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCvvValid}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding Cvv, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="15,0"
                                                 FontSize="14"
                                                 FontFamily="Consolas"
                                                 MaxLength="4"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <TextBlock Text="We accept:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="{DynamicResource Gray100Brush}" Padding="8,4" Margin="0,0,5,0">
                                    <TextBlock Text="VISA" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource Gray100Brush}" Padding="8,4" Margin="0,0,5,0">
                                    <TextBlock Text="MASTERCARD" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <Border Background="{DynamicResource Gray100Brush}" Padding="8,4">
                                    <TextBlock Text="AMEX" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PASO 3: CONFIRMACIÓN -->
                    <Border Background="{DynamicResource WhitePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,25"
                            Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="CONFIRM ORDER" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,25"/>

                            <Border Background="{DynamicResource Gray50Brush}"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="SHIPPING ADDRESS" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="Edit" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   Cursor="Hand"
                                                   TextDecorations="Underline">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding PreviousStepCommand}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding ShippingAddress.FullName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ShippingAddress.AddressLine1}" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="{Binding ShippingAddress.PostalCode}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ShippingAddress.City}"/>
                                        <Run Text=", "/>
                                        <Run Text="{Binding ShippingAddress.Country}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ShippingAddress.PhoneNumber}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Gray50Brush}"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="PAYMENT METHOD" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="Edit" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Right"
                                                   Cursor="Hand"
                                                   TextDecorations="Underline">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding PreviousStepCommand}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💳" FontSize="18" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardholderName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CardNumberMasked}" 
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontFamily="Consolas"
                                                       FontSize="13"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0">
                                                <Run Text="Expires: "/>
                                                <Run Text="{Binding ExpirationDate}"/>
                                                <Run Text=" — Demo mode"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PRODUCTS" FontWeight="Bold" FontSize="12" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding OrderItems}" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource Gray200Brush}" Width="60" Height="60" ClipToBounds="True">
                                                <controls:AsyncImage Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                                    <Run Text="Qty: "/>
                                                    <Run Text="{Binding Quantity}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Size}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding Color}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Subtotal, StringFormat={}{0:C}}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="← BACK"
                                Style="{StaticResource OutlineButton}"
                                Padding="30,15"
                                Command="{Binding PreviousStepCommand}"
                                Visibility="{Binding IsStep1, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Button Grid.Column="0"
                                Content="CANCEL"
                                Style="{StaticResource OutlineButton}"
                                Padding="30,15"
                                Command="{Binding CancelCheckoutCommand}"
                                Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButton}"
                                Padding="40,15"
                                FontSize="14"
                                Command="{Binding NextStepCommand}"
                                Visibility="{Binding IsStep3, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CONTINUE"/>
                                    <TextBlock Text=" →"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource AccentButton}"
                                Padding="40,15"
                                FontSize="14"
                                Command="{Binding CompleteOrderCommand}"
                                IsEnabled="{Binding CanCompleteOrder}"
                                Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 CONFIRM ORDER"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource BlackPrimaryBrush}"
                            Padding="20"
                            Margin="0,20,0,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ProcessingMessage}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEE2E2"
                            BorderBrush="#F87171"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,20,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"/>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- resumen del pedido (sidebar) -->
        <Border Grid.Column="1" 
                Background="{DynamicResource Gray50Brush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="40,50,40,80">
                    <StackPanel>
                        <TextBlock Text="ORDER SUMMARY" 
                                   Style="{StaticResource HeadingMedium}"
                                   Margin="0,0,0,30"/>

                        <ItemsControl ItemsSource="{Binding OrderItems}" Margin="0,0,0,30">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Border Background="{DynamicResource Gray200Brush}" Width="70" Height="70" ClipToBounds="True">
                                                <controls:AsyncImage Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Border Background="{DynamicResource BlackPrimaryBrush}"
                                                    CornerRadius="10"
                                                    Width="20" Height="20"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-5,-5,0">
                                                <TextBlock Text="{Binding Quantity}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding ProductName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0">
                                                <Run Text="{Binding Size}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding Color}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C}}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="0,1,0,0"
                                Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Subtotal" Style="{StaticResource BodyLarge}"/>
                            <TextBlock Text="{Binding OrderTotal, StringFormat={}{0:C}}" 
                                       Style="{StaticResource BodyLarge}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Shipping" Style="{StaticResource BodyLarge}"/>
                            <TextBlock Text="FREE" 
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="#10B981"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="IVA (21%)" Style="{StaticResource BodyLarge}"/>
                            <TextBlock Text="{Binding OrderTotal, StringFormat=€{0:N2}}" 
                                       Style="{StaticResource BodyLarge}" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderDefault}"
                                BorderThickness="0,1,0,0"
                                Padding="0,20,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL" 
                                           Style="{StaticResource HeadingMedium}"
                                           FontSize="20"/>
                                <TextBlock Text="{Binding OrderTotal, StringFormat=€{0:N2}}"
                                           Style="{StaticResource HeadingMedium}"
                                           FontSize="20"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource WhitePrimaryBrush}"
                                Padding="15"
                                Margin="0,30,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🔒" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="100% Secure Payment" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="Your data is protected with 256-bit SSL encryption."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="📦 Free shipping on orders over +€50" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="14 days free returns" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>