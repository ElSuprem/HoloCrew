<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <!-- FORMULARIO DE CHECKOUT CON SCROLL -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="80,50,40,80">
                <StackPanel>

                    <!-- ⭐ HEADER CON INDICADOR DE PASOS -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="CHECKOUT" 
                                   Style="{StaticResource HeadingLarge}"/>

                        <!-- Stepper -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Margin="0,0,10,0">
                                <TextBlock Text="1"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Envío"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>

                            <Border Background="{StaticResource Gray300Brush}"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Margin="0,0,10,0">
                                <TextBlock Text="2"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pago"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>

                            <Border Background="{StaticResource Gray300Brush}"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Margin="0,0,10,0">
                                <TextBlock Text="3"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Confirmar"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ⭐ SECCIÓN 1: INFORMACIÓN DE ENVÍO -->
                    <Border Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,25">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📦 INFORMACIÓN DE ENVÍO" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,25"/>

                            <!-- Nombre y Apellidos -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="50"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Apellidos" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="50"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dirección -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Dirección" 
                                           Style="{StaticResource BodyMedium}"
                                           Margin="0,0,0,8"/>
                                <TextBox Height="50"
                                         Padding="15,0"
                                         FontSize="14"
                                         BorderBrush="{StaticResource BorderDefault}"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <!-- Ciudad y Código Postal -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ciudad" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="50"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Código Postal" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="50"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- País y Teléfono -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="País" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox Height="50"
                                              Padding="15,0"
                                              FontSize="14"
                                              BorderBrush="{StaticResource BorderDefault}"
                                              BorderThickness="1">
                                        <ComboBoxItem Content="España" IsSelected="True"/>
                                        <ComboBoxItem Content="Portugal"/>
                                        <ComboBoxItem Content="Francia"/>
                                        <ComboBoxItem Content="Italia"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Teléfono" 
                                               Style="{StaticResource BodyMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBox Height="50"
                                             Padding="15,0"
                                             FontSize="14"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ⭐ SECCIÓN 2: MÉTODO DE ENVÍO -->
                    <Border Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,25">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🚚 MÉTODO DE ENVÍO" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,25"/>

                            <!-- Standard Shipping -->
                            <RadioButton GroupName="Shipping"
                                         IsChecked="True"
                                         Margin="0,0,0,15">
                                <RadioButton.Content>
                                    <Grid Width="620">
                                        <StackPanel>
                                            <TextBlock Text="Envío estándar (3-5 días)" 
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Entrega en días laborables" 
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="€4.99" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Express Shipping -->
                            <RadioButton GroupName="Shipping"
                                         Margin="0,0,0,15">
                                <RadioButton.Content>
                                    <Grid Width="620">
                                        <StackPanel>
                                            <TextBlock Text="Envío express (1-2 días)" 
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Entrega urgente" 
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="€9.99" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Free Shipping -->
                            <RadioButton GroupName="Shipping">
                                <RadioButton.Content>
                                    <Grid Width="620">
                                        <StackPanel>
                                            <TextBlock Text="Envío gratis (7-10 días)" 
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Para pedidos superiores a €50" 
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="GRATIS" 
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#10B981"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- ⭐ SECCIÓN 3: MÉTODO DE PAGO -->
                    <Border Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Padding="35,30"
                            Margin="0,0,0,30">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.06" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="💳 MÉTODO DE PAGO" 
                                       Style="{StaticResource HeadingMedium}"
                                       Margin="0,0,0,25"/>

                            <!-- Credit Card -->
                            <RadioButton GroupName="Payment"
                                         IsChecked="True"
                                         Margin="0,0,0,20">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="Tarjeta de crédito/débito" 
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="Visa, Mastercard, American Express" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- PayPal -->
                            <RadioButton GroupName="Payment"
                                         Margin="0,0,0,20">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="PayPal" 
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="Pago seguro con PayPal" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Bank Transfer -->
                            <RadioButton GroupName="Payment">
                                <RadioButton.Content>
                                    <StackPanel>
                                        <TextBlock Text="Transferencia bancaria" 
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="Procesamiento en 1-2 días laborables" 
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </RadioButton.Content>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- ⭐ BOTÓN FINAL CON ESPACIO -->
                    <Button Content="PLACE ORDER"
                            Style="{StaticResource AccentButton}"
                            Height="60"
                            FontSize="18"
                            FontWeight="Bold"
                            Margin="0,10,0,0"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ORDER SUMMARY SIDEBAR (sin cambios) -->
        <Border Grid.Column="1" 
                Background="{StaticResource Gray50Brush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Padding="40,50,40,80">
                    <StackPanel>
                        <TextBlock Text="ORDER SUMMARY" 
                                   Style="{StaticResource HeadingMedium}"
                                   Margin="0,0,0,30"/>

                        <!-- Order items... (mantener existente) -->
                        <TextBlock Text="[Aquí van los items del pedido]"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"
                                   Margin="0,20"/>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
