<UserControl x:Class="HoloCrew.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock Text="Finalizar Compra" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,30" />

            <!-- Progreso -->
            <Border Background="#F8F9FA"
                    Padding="20"
                    Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Border Background="#1976D2"
                            Width="40"
                            Height="40"
                            CornerRadius="20">
                        <TextBlock Text="1" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Envío" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,0,40,0"
                               VerticalAlignment="Center" />

                    <Rectangle Width="60" 
                               Height="2" 
                               Fill="#E0E0E0"
                               VerticalAlignment="Center" />

                    <Border Background="#E0E0E0"
                            Width="40"
                            Height="40"
                            CornerRadius="20">
                        <TextBlock Text="2" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Pago" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,0,40,0"
                               VerticalAlignment="Center"
                               Foreground="#666" />

                    <Rectangle Width="60" 
                               Height="2" 
                               Fill="#E0E0E0"
                               VerticalAlignment="Center" />

                    <Border Background="#E0E0E0"
                            Width="40"
                            Height="40"
                            CornerRadius="20">
                        <TextBlock Text="3" 
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Confirmación" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#666" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- FORMULARIO DE ENVÍO -->
                <StackPanel Grid.Column="0" 
                            Margin="0,0,20,0">
                    <TextBlock Text="Dirección de envío" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Padding="30">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Nombre" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ShippingFirstName}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Apellidos" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ShippingLastName}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Dirección" 
                                       FontWeight="SemiBold" 
                                       Margin="0,20,0,8" />
                            <TextBox Text="{Binding ShippingAddress}"
                                     Padding="12,10"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Margin="0,0,0,20" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Ciudad" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ShippingCity}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Código Postal" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ShippingPostalCode}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="País" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding ShippingCountry}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Teléfono" 
                                       FontWeight="SemiBold" 
                                       Margin="0,20,0,8" />
                            <TextBox Text="{Binding ShippingPhone}"
                                     Padding="12,10"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Método de pago" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,40,0,20" />

                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Padding="30">
                        <StackPanel>
                            <RadioButton Content="Tarjeta de crédito/débito"
                                         GroupName="PaymentMethod"
                                         IsChecked="{Binding IsCreditCardSelected}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Margin="0,0,0,20" />

                            <Border Background="#F8F9FA"
                                    Padding="20"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding IsCreditCardSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Número de tarjeta" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,0,8" />
                                    <TextBox Text="{Binding CardNumber}"
                                             Padding="12,10"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1"
                                             Margin="0,0,0,20" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Fecha de caducidad" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,0,0,8" />
                                            <TextBox Text="{Binding CardExpiry}"
                                                     Padding="12,10"
                                                     FontSize="14"
                                                     BorderBrush="#E0E0E0"
                                                     BorderThickness="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="CVV" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,0,0,8" />
                                            <TextBox Text="{Binding CardCVV}"
                                                     Padding="12,10"
                                                     FontSize="14"
                                                     BorderBrush="#E0E0E0"
                                                     BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <RadioButton Content="PayPal"
                                         GroupName="PaymentMethod"
                                         IsChecked="{Binding IsPayPalSelected}"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Margin="0,0,0,20" />

                            <RadioButton Content="Contra reembolso"
                                         GroupName="PaymentMethod"
                                         IsChecked="{Binding IsCashOnDeliverySelected}"
                                         FontSize="14"
                                         FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Botones de navegación -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0">
                        <Button Content="← Volver al carrito" 
                                Command="{Binding BackToCartCommand}"
                                Padding="25,12"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="#1976D2"
                                BorderBrush="#1976D2"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,0,20,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Continuar con el pago →" 
                                Command="{Binding ProcessPaymentCommand}"
                                Padding="30,15"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Background="#1976D2"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsEnabled="{Binding CanProceedToPayment}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#115293" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BBDEFB" />
                                            <Setter Property="Foreground" Value="#90A4AE" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- RESUMEN DEL PEDIDO -->
                <Border Grid.Column="1" 
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Padding="30">
                    <StackPanel>
                        <TextBlock Text="Resumen del pedido" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,20" />

                        <!-- Productos -->
                        <ItemsControl ItemsSource="{Binding OrderItems}"
                                      Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                Margin="0,0,0,10">
                                        <TextBlock Text="{Binding ProductName}" 
                                                   FontSize="13"
                                                   Width="200"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                                                   FontSize="13"
                                                   Foreground="#666"
                                                   Margin="5,0,5,0" />
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='€{0:N2}'}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Width="80" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" 
                                Background="#E0E0E0"
                                Margin="0,0,0,20" />

                        <!-- Totales -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Subtotal" 
                                           FontSize="14"
                                           Foreground="#666"
                                           Width="200" />
                                <TextBlock Text="{Binding Subtotal, StringFormat='€{0:N2}'}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Envío" 
                                           FontSize="14"
                                           Foreground="#666"
                                           Width="200" />
                                <TextBlock Text="{Binding ShippingCost, StringFormat='€{0:N2}'}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Descuento" 
                                           FontSize="14"
                                           Foreground="#4CAF50"
                                           Width="200" />
                                <TextBlock Text="{Binding DiscountAmount, StringFormat='-€{0:N2}'}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#4CAF50"
                                           HorizontalAlignment="Right" />
                            </StackPanel>

                            <Border Height="1" 
                                    Background="#E0E0E0"
                                    Margin="0,10,0,10" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total" 
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Width="200" />
                                <TextBlock Text="{Binding Total, StringFormat='€{0:N2}'}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Información de seguridad -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="15"
                                Margin="0,30,0,0">
                            <StackPanel>
                                <TextBlock Text="🔒 Compra segura" 
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Tu información está protegida con encriptación SSL" 
                                           FontSize="12"
                                           Foreground="#666"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#80FFFFFF"
                  Height="400">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Procesando pago..." FontSize="16" Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>