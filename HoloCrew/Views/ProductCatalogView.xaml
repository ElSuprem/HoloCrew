<UserControl x:Class="HoloCrew.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR: FILTROS - Mejorado -->
        <Border Grid.Column="0" 
                Background="{StaticResource BlackPrimaryBrush}"
                BorderBrush="{StaticResource Gray800Brush}"
                BorderThickness="0,0,1,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="15" ShadowDepth="0" Direction="0"/>
            </Border.Effect>

            <Border Padding="35,45">
                <StackPanel>
                    <!-- Título -->
                    <TextBlock Text="FILTERS" 
                               Style="{StaticResource HeadingMedium}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               Margin="0,0,0,45"/>

                    <!-- Búsqueda -->
                    <TextBlock Text="SEARCH" 
                               Style="{StaticResource SubtitleMedium}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Border Background="{StaticResource WhitePrimaryBrush}"
                            Height="48"
                            Margin="0,0,0,35">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="15,0"
                                 VerticalAlignment="Center"
                                 FontSize="14"/>
                    </Border>

                    <!-- Rango de Precio -->
                    <TextBlock Text="PRICE RANGE" 
                               Style="{StaticResource SubtitleMedium}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Background="{StaticResource WhitePrimaryBrush}"
                                Height="48">
                            <TextBox Text="{Binding MinPrice}" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="14"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="-" 
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <Border Grid.Column="2"
                                Background="{StaticResource WhitePrimaryBrush}"
                                Height="48">
                            <TextBox Text="{Binding MaxPrice}" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="14"/>
                        </Border>
                    </Grid>

                    <!-- Categorías -->
                    <TextBlock Text="CATEGORY" 
                               Style="{StaticResource SubtitleMedium}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               Margin="0,0,0,18"/>
                    <Border Margin="0,0,0,35">
                        <StackPanel>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="ALL PRODUCTS" 
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WhitePrimaryBrush}"/>
                            </Border>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="Hoodies &amp; Sweatshirts" 
                                           FontSize="14"
                                           Foreground="{StaticResource Gray400Brush}"/>
                            </Border>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="T-Shirts" 
                                           FontSize="14"
                                           Foreground="{StaticResource Gray400Brush}"/>
                            </Border>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="Pants &amp; Jeans" 
                                           FontSize="14"
                                           Foreground="{StaticResource Gray400Brush}"/>
                            </Border>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="Outerwear" 
                                           FontSize="14"
                                           Foreground="{StaticResource Gray400Brush}"/>
                            </Border>
                            <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                                <TextBlock Text="Accessories" 
                                           FontSize="14"
                                           Foreground="{StaticResource Gray400Brush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tallas -->
                    <TextBlock Text="SIZE" 
                               Style="{StaticResource SubtitleMedium}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               Margin="0,0,0,18"/>
                    <WrapPanel Margin="0,0,0,35">
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Width="45" Height="45"
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <TextBlock Text="XS" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Width="45" Height="45"
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <TextBlock Text="S" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Width="45" Height="45"
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <TextBlock Text="M" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Width="45" Height="45"
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <TextBlock Text="L" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Width="45" Height="45"
                                Margin="0,0,8,8"
                                Cursor="Hand">
                            <TextBlock Text="XL" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>

                    <!-- Clear Filters -->
                    <Button Content="CLEAR ALL FILTERS" 
                            Background="Transparent"
                            Foreground="{StaticResource RedAccentBrush}"
                            BorderBrush="{StaticResource RedAccentBrush}"
                            BorderThickness="2"
                            FontSize="13"
                            FontWeight="Bold"
                            Padding="0,12"
                            Cursor="Hand"
                            Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- GRID PRODUCTOS - Mejorado -->
        <Border Grid.Column="1" Padding="60,50,60,80">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ALL PRODUCTS" 
                                   Style="{StaticResource HeadingLarge}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="147 products found" 
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sort by: " 
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Featured" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Grid de productos con sombras -->
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.Items>
                        <!-- Producto 1 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,25,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="OVERSIZED HOODIE" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Premium Cotton Blend" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="59.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Producto 2 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,25,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="CARGO PANTS" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Tactical Style" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="79.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Producto 3 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,0,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <!-- NEW Badge -->
                                <Border Background="{StaticResource RedAccentBrush}"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="15,15,0,0">
                                    <TextBlock Text="NEW" 
                                               FontSize="11" 
                                               FontWeight="Black" 
                                               Foreground="{StaticResource WhitePrimaryBrush}"/>
                                </Border>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="GRAPHIC TEE" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Limited Edition" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="39.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Producto 4 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,25,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="BOMBER JACKET" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Water Resistant" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="129.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Producto 5 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,25,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="JOGGERS" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Comfortable Fit" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="69.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Producto 6 -->
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                Margin="0,0,0,25"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="380"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                                <Border Grid.Row="1" Padding="25,22">
                                    <StackPanel>
                                        <TextBlock Text="STREETWEAR CAP" 
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Adjustable" 
                                                   Style="{StaticResource BodySmall}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="29.99€" 
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,18"/>
                                        <Button Content="ADD TO CART" 
                                                Style="{StaticResource AddToCartButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
