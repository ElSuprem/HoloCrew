<UserControl x:Class="HoloCrew.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <!-- Sidebar Filtros -->
            <ColumnDefinition Width="*" />
            <!-- Grid Productos -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR: Filtros -->
        <Border Grid.Column="0" 
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Filtros" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="0,0,0,30" 
                               Foreground="#1976D2" />

                    <!-- Búsqueda -->
                    <TextBlock Text="Buscar" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" 
                               Foreground="#555" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10"
                             FontSize="14"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             CornerRadius="6"
                             Margin="0,0,0,25">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Rango de Precio -->
                    <TextBlock Text="Precio" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" 
                               Foreground="#555" />
                    <StackPanel Orientation="Horizontal" 
                                Margin="0,0,0,20"
                                HorizontalAlignment="Center">
                        <TextBox Text="{Binding MinPrice}" 
                                 Width="80" 
                                 Padding="8,6"
                                 FontSize="14"
                                 TextAlignment="Center"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 CornerRadius="4" />
                        <TextBlock Text="-" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,10,0" 
                                   FontSize="14"
                                   Foreground="#777" />
                        <TextBox Text="{Binding MaxPrice}" 
                                 Width="80" 
                                 Padding="8,6"
                                 FontSize="14"
                                 TextAlignment="Center"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 CornerRadius="4" />
                    </StackPanel>

                    <!-- Botones Filtros -->
                    <Button Content="Aplicar Filtros" 
                            Command="{Binding ApplyFiltersCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="8"
                            Cursor="Hand"
                            Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BBDEFB" />
                                        <Setter Property="Foreground" Value="#90A4AE" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Limpiar Filtros" 
                            Command="{Binding ClearFiltersCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            Foreground="#1976D2"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- GRID: Productos -->
        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="40">
                <Grid Margin="0,0,0,30">
                    <TextBlock Text="{Binding Title}" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Foreground="#1976D2"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Ordenar por:" 
                                   FontSize="14" 
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555" />

                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}"
                                  Width="180"
                                  Padding="12,8"
                                  FontSize="14"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1"
                                  CornerRadius="6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" 
                                               FontSize="14"
                                               Padding="4,2" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding FilteredProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Width="260"
                                    Margin="10"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#40000000" 
                                                      BlurRadius="12" 
                                                      ShadowDepth="3" 
                                                      Opacity="0.15" />
                                </Border.Effect>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ViewProductDetailCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Imagen del Producto -->
                                    <Border Grid.Row="0" 
                                            CornerRadius="12,12,0,0"
                                            Background="#F5F5F5">
                                        <TextBlock Text="📷" 
                                                   FontSize="64"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CCC" />

                                        <Border Background="#F44336"
                                                Padding="8,4"
                                                CornerRadius="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="10"
                                                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DiscountPercentage, StringFormat='-{0}%'}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="12" />
                                        </Border>
                                    </Border>

                                    <!-- Información del Producto -->
                                    <StackPanel Grid.Row="1" Padding="15">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#757575"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,12" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="★" Foreground="#FFC107" FontSize="14" />
                                            <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}"
                                                       FontSize="12"
                                                       Margin="4,0,8,0" />
                                            <TextBlock Text="{Binding ReviewCount, StringFormat='({0})'}"
                                                       FontSize="12"
                                                       Foreground="#999" />
                                        </StackPanel>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Price, StringFormat='€{0:N2}'}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2" />

                                                <TextBlock Text="{Binding OriginalPrice, StringFormat='€{0:N2}'}"
                                                           FontSize="14"
                                                           Foreground="#999"
                                                           TextDecorations="Strikethrough"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <Button Content="+" 
                                                    HorizontalAlignment="Right"
                                                    Width="36"
                                                    Height="36"
                                                    Background="#1976D2"
                                                    Foreground="White"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.AddToCartCommand, 
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="18"
                                                                            Width="{TemplateBinding Width}"
                                                                            Height="{TemplateBinding Height}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#115293" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                      Height="200"
                      VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Cargando productos..." FontSize="16" Foreground="#666" />
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#FFF3E0"
                        CornerRadius="12"
                        Padding="40"
                        Margin="0,40,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" 
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20" />
                        <TextBlock Text="No se encontraron productos" 
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#E65100"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Intenta cambiar los filtros de búsqueda" 
                                   FontSize="14"
                                   Foreground="#777"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>