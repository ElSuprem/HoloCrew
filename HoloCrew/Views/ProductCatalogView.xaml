<UserControl x:Class="HoloCrew.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <!-- Loading state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading products..." FontSize="16" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error state -->
        <Border Visibility="{Binding IsError, Converter={StaticResource BoolToVisibilityConverter}}" Padding="60">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="48" Height="48" Margin="0,0,0,20">
                    <Path Data="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" 
                          Stroke="#DC2626" StrokeThickness="2" Fill="Transparent"/>
                </Viewbox>
                <TextBlock Text="Failed to load products" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="#DC2626" Margin="0,0,0,10"/>
                <TextBlock Text="Please try again later" FontSize="14" Foreground="{DynamicResource Gray500Brush}" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CATEGORY TITLE -->
            <Border Grid.Row="0" Background="{DynamicResource WhitePrimaryBrush}" Padding="0,35,0,20">
                <TextBlock Text="{Binding CurrentCategoryName}" 
                           FontSize="32"
                           FontWeight="Black"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- HORIZONTAL FILTER BAR -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource WhitePrimaryBrush}" 
                    BorderBrush="{DynamicResource Gray200Brush}"
                    BorderThickness="0,1,0,1"
                    Padding="60,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Checkboxes -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox Content="ONLY SHOW AVAILABLE PRODUCTS" 
                                  IsChecked="{Binding InStockOnly}" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource BlackPrimaryBrush}"
                                  Cursor="Hand"
                                  Margin="0,0,0,6"/>
                        <CheckBox Content="ON SALE" 
                                  IsChecked="{Binding OnSaleOnly}" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource BlackPrimaryBrush}"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <!-- CENTER: Category pills + Sort -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- ALL -->
                        <Border Padding="12,8" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectCategoryCommand}" CommandParameter="All" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryAll}" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#0A0A0A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="ALL" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryAll}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- TOPS -->
                        <Border Padding="12,8" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectCategoryCommand}" CommandParameter="Tops" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryTops}" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#0A0A0A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="TOPS" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryTops}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- BOTTOMS -->
                        <Border Padding="12,8" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectCategoryCommand}" CommandParameter="Bottoms" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryBottoms}" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#0A0A0A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="BOTTOMS" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryBottoms}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- FOOTWEAR -->
                        <Border Padding="12,8" Margin="0,0,6,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectCategoryCommand}" CommandParameter="Footwear" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryFootwear}" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#0A0A0A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="FOOTWEAR" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryFootwear}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- ACCESSORIES -->
                        <Border Padding="12,8" Margin="0,0,20,0" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding SelectCategoryCommand}" CommandParameter="Accessories" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategoryAccessories}" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="BorderBrush" Value="#0A0A0A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="ACCESSORIES" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryAccessories}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Sort dropdown -->
                        <TextBlock Text="SORT BY:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" 
                                  SelectedItem="{Binding SortBy}"
                                  Width="180" 
                                  Height="36" 
                                  FontSize="12"
                                  VerticalContentAlignment="Center" 
                                  Padding="12,0"
                                  Style="{StaticResource ThemedComboBox}"
                                  ItemContainerStyle="{StaticResource ThemedComboBoxItem}"/>
                    </StackPanel>

                    <!-- RIGHT: Product count -->
                    <TextBlock Grid.Column="2" 
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BlackPrimaryBrush}">
                        <Run Text="{Binding TotalProductCount, Mode=OneWay}"/>
                        <Run Text=" PRODUCTS"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- PRODUCTS GRID -->
            <Grid Grid.Row="2" Background="{DynamicResource WhitePrimaryBrush}">
                <ItemsControl ItemsSource="{Binding FilteredProducts}" Margin="50,30,50,60">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WhitePrimaryBrush}" 
                                    Margin="10" 
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="380"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Image area -->
                                    <Border Grid.Row="0" Background="{DynamicResource Gray100Brush}" ClipToBounds="True">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <!-- Imagen del producto -->
                                            <controls:AsyncImage Source="{Binding MainImageUrl}"/>

                                            <!-- Overlay SOLD OUT cuando todas las tallas están agotadas -->
                                            <Border Background="#CCFFFFFF"
                                                    Visibility="{Binding IsCompletelyOutOfStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    IsHitTestVisible="False"
                                                    Panel.ZIndex="200">
                                                <Border Background="#0A0A0A"
                                                        Padding="20,8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="SOLD OUT"
                                                               Foreground="White"
                                                               FontSize="14"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Border>

                                            <!-- Badges -->
                                            <StackPanel Orientation="Horizontal" 
                                                        HorizontalAlignment="Left" 
                                                        VerticalAlignment="Top" 
                                                        Margin="12">
                                                <Border Background="{DynamicResource BlackPrimaryBrush}" 
                                                        Padding="10,5" 
                                                        Margin="0,0,6,0" 
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="{DynamicResource RedAccentBrush}" 
                                                        Padding="10,5" 
                                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Foreground="White" FontSize="10" FontWeight="Bold">
                                                        <Run Text="-"/><Run Text="{Binding DiscountPercentage, Mode=OneWay}"/><Run Text="%"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <!-- Wishlist button -->
                                            <Button Width="40" Height="40"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="12"
                                                    Cursor="Hand"
                                                    Panel.ZIndex="100"
                                                    Command="{Binding DataContext.ToggleWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="40" Height="40"
                                                                Background="{DynamicResource WhitePrimaryBrush}"
                                                                CornerRadius="20">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                                         Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                    <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                          Fill="Transparent" Stroke="#1F2937" StrokeThickness="1.5"/>
                                                                </Viewbox>
                                                                <Viewbox Width="24" Height="24" Margin="0,1,0,0"
                                                                         Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                          Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                                                </Viewbox>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Quick Add on hover -->
                                            <Border Background="{DynamicResource BlackPrimaryBrush}" 
                                                    Height="45" 
                                                    VerticalAlignment="Bottom" 
                                                    Cursor="Hand" 
                                                    Opacity="0" 
                                                    x:Name="QuickAddButton">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="ADD TO CART" 
                                                           Foreground="White" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Product info -->
                                    <Border Grid.Row="1" Padding="5,16,5,20">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BlackPrimaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                           FontSize="15" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource BlackPrimaryBrush}"/>
                                                <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}" 
                                                           FontSize="13" 
                                                           Foreground="{DynamicResource Gray400Brush}" 
                                                           TextDecorations="Strikethrough" 
                                                           Margin="10,2,0,0" 
                                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hover animations -->
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="QuickAddButton" 
                                                                 Storyboard.TargetProperty="Opacity" 
                                                                 To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="QuickAddButton" 
                                                                 Storyboard.TargetProperty="Opacity" 
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Margin="0,100,0,0" 
                            Visibility="{Binding FilteredProducts.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                    <Viewbox Width="64" Height="64" Margin="0,0,0,20" Opacity="0.3">
                        <Path Data="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" 
                              Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="No products found" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Try adjusting your filters" 
                               FontSize="14" 
                               Foreground="{DynamicResource Gray500Brush}" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>
                    <Button Content="CLEAR FILTERS" 
                            Style="{StaticResource OutlineButton}" 
                            Padding="30,12" 
                            Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

</UserControl>