<UserControl x:Class="HoloCrew.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <!-- Sidebar Filtros -->
            <ColumnDefinition Width="*" />
            <!-- Grid Productos -->
        </Grid.ColumnDefinitions>

        <!-- ============================================
             SIDEBAR: FILTROS
             ============================================ -->
        <Border Grid.Column="0" 
                Background="{StaticResource BlackPrimaryBrush}"
                BorderBrush="{StaticResource Gray800Brush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Border Padding="30,40">
                    <StackPanel>
                        <!-- Título -->
                        <TextBlock Text="FILTERS" 
                                   Style="{StaticResource HeadingMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,40" />

                        <!-- Búsqueda -->
                        <TextBlock Text="SEARCH" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <Border Background="{StaticResource WhitePrimaryBrush}"
                                Height="45"
                                Margin="0,0,0,30">
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="15,0"
                                     VerticalAlignment="Center"
                                     FontSize="14"/>
                        </Border>

                        <!-- Rango de Precio -->
                        <TextBlock Text="PRICE RANGE" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                    Background="{StaticResource WhitePrimaryBrush}"
                                    Height="45">
                                <TextBox Text="{Binding MinPrice}" 
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="14"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="-" 
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <Border Grid.Column="2"
                                    Background="{StaticResource WhitePrimaryBrush}"
                                    Height="45">
                                <TextBox Text="{Binding MaxPrice}" 
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="14"/>
                            </Border>
                        </Grid>

                        <!-- Categorías -->
                        <TextBlock Text="CATEGORY" 
                                   Style="{StaticResource SubtitleMedium}"
                                   Foreground="{StaticResource WhitePrimaryBrush}"
                                   Margin="0,0,0,15" />
                        <StackPanel Margin="0,0,0,30">
                            <Button Content="ALL PRODUCTS" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource WhitePrimaryBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"/>
                            <Button Content="TOPS" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource Gray400Brush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"/>
                            <Button Content="BOTTOMS" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource Gray400Brush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"/>
                            <Button Content="ACCESSORIES" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource Gray400Brush}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Botones de acción -->
                        <Button Content="APPLY FILTERS" 
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ApplyFiltersCommand}"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Stretch"/>

                        <Button Content="CLEAR FILTERS" 
                                Style="{StaticResource OutlineButton}"
                                Foreground="{StaticResource WhitePrimaryBrush}"
                                BorderBrush="{StaticResource WhitePrimaryBrush}"
                                Command="{Binding ClearFiltersCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ============================================
             ÁREA PRINCIPAL: PRODUCTOS
             ============================================ -->
        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <!-- Header con ordenamiento -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="0,0,0,1"
                        Padding="40,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Resultados -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HeadingLarge}">
                                <Run Text="{Binding TotalProducts, Mode=OneWay}"/>
                                <Run Text="PRODUCTS"/>
                            </TextBlock>
                            <TextBlock Text="Discover our latest collection"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Ordenamiento -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="SORT BY:" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <ComboBox SelectedIndex="{Binding SelectedSortOption}"
                                      Width="200"
                                      Height="45"
                                      FontSize="14"
                                      Padding="15,0">
                                <ComboBoxItem Content="Newest First"/>
                                <ComboBoxItem Content="Price: Low to High"/>
                                <ComboBoxItem Content="Price: High to Low"/>
                                <ComboBoxItem Content="Most Popular"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Grid de Productos -->
                <Border Padding="40,40,40,60">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        Margin="0,0,30,30"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.ViewProductDetailCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      CommandParameter="{Binding}" 
                                                      MouseAction="LeftClick"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="400"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Imagen del producto -->
                                        <Border Grid.Row="0" 
                                                Background="{StaticResource Gray100Brush}">
                                            <Grid>
                                                <Rectangle Fill="{StaticResource Gray200Brush}"/>

                                                <!-- Badge descuento -->
                                                <Border Background="{StaticResource RedAccentBrush}"
                                                        Width="60" 
                                                        Height="30"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="15"
                                                        Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DiscountPercentage, StringFormat=-{0}%}"
                                                               Style="{StaticResource BadgeText}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Border>

                                                <!-- Botón añadir al carrito -->
                                                <Border Background="{StaticResource BlackPrimaryBrush}"
                                                        Width="50" 
                                                        Height="50"
                                                        CornerRadius="25"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="15"
                                                        Cursor="Hand">
                                                    <Border.InputBindings>
                                                        <MouseBinding Command="{Binding DataContext.AddToCartCommand, 
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"
                                                                      MouseAction="LeftClick"/>
                                                    </Border.InputBindings>
                                                    <TextBlock Text="+" 
                                                               Foreground="{StaticResource WhitePrimaryBrush}"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Información del producto -->
                                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                            <!-- Nombre -->
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource ProductTitle}"
                                                       Margin="0,0,0,8"/>

                                            <!-- Rating -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="★" 
                                                           Foreground="{StaticResource StarBrush}" 
                                                           FontSize="14"/>
                                                <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="4,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ReviewCount, StringFormat={}({0})}"
                                                           Style="{StaticResource Caption}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Precio -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Price, StringFormat=€{0:N2}}"
                                                           Style="{StaticResource PriceCard}"
                                                           Foreground="{StaticResource TextPrimary}"/>

                                                <TextBlock Text="{Binding OriginalPrice, StringFormat=€{0:N2}}"
                                                           Style="{StaticResource PriceOriginal}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Loading State -->
                <Border Height="400"
                        Background="{StaticResource BackgroundPrimary}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="⏳" 
                                   FontSize="60" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="LOADING PRODUCTS..." 
                                   Style="{StaticResource SubtitleLarge}"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <Border Padding="40,60"
                        Background="{StaticResource BackgroundPrimary}"
                        Visibility="{Binding Products, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                    <Border Background="{StaticResource Gray100Brush}"
                            Padding="60,80"
                            HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" 
                                       FontSize="80"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"/>
                            <TextBlock Text="NO PRODUCTS FOUND" 
                                       Style="{StaticResource HeadingMedium}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,15"/>
                            <TextBlock Text="Try adjusting your search or filter to find what you're looking for" 
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextAlignment="Center"
                                       MaxWidth="400"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,30"/>
                            <Button Content="CLEAR FILTERS" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ClearFiltersCommand}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
