<UserControl x:Class="HoloCrew.Views.MembersClubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="2000" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>

        

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ============================================ -->
                <!-- HEADER: CTA si no hay sesión / Stats si la hay -->
                <!-- ============================================ -->

                <!-- CTA público: solo visible si NO está logueado -->
                <Border Background="#0A0A0A" Padding="80,70"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="700">
                        <TextBlock Text="JOIN THE CREW"
                                   FontSize="56" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Earn points with every purchase. Unlock exclusive rewards. Get 200 credits just for signing up."
                                   FontSize="16" Foreground="{DynamicResource Gray400Brush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,30"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="White" Padding="40,15" Margin="0,0,15,0" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding GoToRegisterCommand}" MouseAction="LeftClick"/>
                                </Border.InputBindings>
                                <TextBlock Text="SIGN UP FREE" FontSize="14" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                            <Border Background="Transparent" BorderBrush="White" BorderThickness="2" Padding="40,15" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding GoToLoginCommand}" MouseAction="LeftClick"/>
                                </Border.InputBindings>
                                <TextBlock Text="LOG IN" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Zona personal: solo visible si SÍ está logueado -->
                <Border Background="#0A0A0A" Padding="80,60"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="16" Foreground="{DynamicResource Gray400Brush}" Margin="0,0,0,5">
                                <Run Text="Hello,"/>
                                <Run Text="{Binding CurrentUser.FullName}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                <TextBlock Text="{Binding CurrentTier.Name, FallbackValue=BRONZE}"
                                           FontSize="42" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="MEMBER" FontSize="42" FontWeight="Black" Foreground="{DynamicResource Gray400Brush}" Margin="15,0,0,0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,60,0">
                                    <TextBlock Text="{Binding CurrentUser.Credits}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Available Credits" FontSize="13" Foreground="{DynamicResource Gray400Brush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,60,0">
                                    <TextBlock Text="{Binding CurrentUser.LifetimePoints}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Lifetime Points" FontSize="13" Foreground="{DynamicResource Gray400Brush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding CurrentUser.MemberSince, StringFormat='{}{0:MMM yyyy}'}"
                                               FontSize="36" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Member Since" FontSize="13" Foreground="{DynamicResource Gray400Brush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Progress card -->
                        <Border Grid.Column="1" Background="#1A1A1A" Padding="35,28" MinWidth="360"
                                Visibility="{Binding NextTier, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="PROGRESS TO NEXT TIER"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Gray400Brush}" Margin="0,0,0,15"/>
                                <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,5">
                                    <Run Text="{Binding NextTier.Name}"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="{DynamicResource Gray400Brush}" Margin="0,0,0,15">
                                    <Run Text="{Binding PointsToNextTier}"/>
                                    <Run Text=" points to go"/>
                                </TextBlock>

                                <ProgressBar Value="{Binding ProgressPercentage}"
                                    Minimum="0" Maximum="100"
                                    Height="10"
                                    Background="#2A2A2A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Margin="0,0,0,5"/>
                                    <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="White" FontSize="13" FontWeight="Bold">
                                    <Run Text="{Binding ProgressPercentage, StringFormat={}{0:F0}}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- MEMBERSHIP TIERS                              -->
                <!-- ============================================ -->
                <Border Padding="80,70" Background="{DynamicResource WhitePrimaryBrush}">
                    <StackPanel>
                        <TextBlock Text="MEMBERSHIP TIERS" FontSize="36" FontWeight="Black"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border Width="80" Height="2" Background="{DynamicResource BlackPrimaryBrush}" Margin="0,0,0,15"/>
                        <TextBlock Text="ESCALATE YOUR STATUS. UNLOCK SUPERIOR REWARDS."
                                   FontSize="13" Foreground="{DynamicResource Gray500Brush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,50"/>

                        <ItemsControl ItemsSource="{Binding AllTiers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WhitePrimaryBrush}"
                                            BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1"
                                            Margin="10" Padding="0">
                                        <StackPanel>
                                            <!-- Logo 3D desde Supabase -->
                                            <Border Background="{DynamicResource Gray50Brush}" Height="220" ClipToBounds="True">
                                                <controls:AsyncImage Source="{Binding ImageUrl}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Margin="20,25,20,30">
                                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock Text="REQUIRED POINTS" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Gray500Brush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,25">
                                                    <Run Text="{Binding MinPoints}"/>
                                                    <Run Text="–"/>
                                                    <Run Text="{Binding MaxPoints}"/>
                                                </TextBlock>
                                                <Border Background="{DynamicResource Gray200Brush}" Height="1" Margin="0,0,0,20"/>
                                                <ItemsControl ItemsSource="{Binding Benefits}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                <TextBlock Text="•" FontSize="13" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Gray700Brush}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- UNLOCK EXCLUSIVE PERKS                        -->
                <!-- ============================================ -->
                <Border Padding="80,60" Background="{DynamicResource WhitePrimaryBrush}">
                    <StackPanel>
                        <TextBlock Text="UNLOCK EXCLUSIVE PERKS" FontSize="32" FontWeight="Black"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border Width="60" Height="2" Background="{DynamicResource BlackPrimaryBrush}" Margin="0,0,0,40"/>

                        <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="40">
                            <UniformGrid Columns="3" Rows="2">
                                <!-- Perk 1: 200 credits -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="200 CREDITS FOR SIGNING UP" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Get 200 instant credits when you sign up" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Perk 2: Exclusive access -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="EXCLUSIVE ACCESS" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Early access to new products" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Perk 3: Birthday rewards -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="BIRTHDAY REWARDS" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="A special gift on your birthday" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Perk 4: Points on every purchase -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM2 10h20" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="POINTS ON EVERY PURCHASE" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Earn points for every euro spent" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Perk 5: Members-only events -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="MEMBERS-ONLY EVENTS" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Exclusive events and releases for members" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Perk 6: Tiered rewards -->
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Margin="0,0,0,15">
                                        <Path Data="M12 15l-3.5 2 1-4-3-2.5h4L12 7l1.5 3.5h4l-3 2.5 1 4z M12 15v6M8 22h8" Stroke="#2563EB" StrokeThickness="2" Fill="Transparent"/>
                                    </Viewbox>
                                    <TextBlock Text="TIERED REWARDS" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Level up to unlock better benefits" FontSize="12" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- HOW IT WORKS                                  -->
                <!-- ============================================ -->
                <Border Padding="80,70" Background="{DynamicResource Gray50Brush}">
                    <StackPanel>
                        <TextBlock Text="HOW IT WORKS" FontSize="32" FontWeight="Black"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="SIMPLE STEPS TO REWARDS"
                                   FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,45"/>

                        <UniformGrid Columns="3">
                            <!-- 01 -->
                            <Border Background="{DynamicResource WhitePrimaryBrush}" Margin="15" Padding="30,30,30,40">
                                <StackPanel>
                                    <TextBlock Text="01" FontSize="42" FontWeight="Black"
                                               Foreground="{DynamicResource Gray200Brush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="JOIN FOR FREE" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="Sign up and get 200 welcome credits instantly."
                                               FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- 02 -->
                            <Border Background="{DynamicResource WhitePrimaryBrush}" Margin="15" Padding="30,30,30,40">
                                <StackPanel>
                                    <TextBlock Text="02" FontSize="42" FontWeight="Black"
                                               Foreground="{DynamicResource Gray200Brush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="SHOP &amp; EARN" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="Earn points with every purchase to level up."
                                               FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- 03 -->
                            <Border Background="{DynamicResource WhitePrimaryBrush}" Margin="15" Padding="30,30,30,40">
                                <StackPanel>
                                    <TextBlock Text="03" FontSize="42" FontWeight="Black"
                                               Foreground="{DynamicResource Gray200Brush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                    <TextBlock Text="REDEEM REWARDS" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="Use points for discounts and exclusive products."
                                               FontSize="12" Foreground="{DynamicResource Gray500Brush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>