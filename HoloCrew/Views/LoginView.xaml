<UserControl x:Class="HoloCrew.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Panel Negro -->
            <ColumnDefinition Width="*" />
            <!-- Formulario -->
        </Grid.ColumnDefinitions>

        <!-- ============================================
             PANEL IZQUIERDO (NEGRO)
             ============================================ -->
        <Border Grid.Column="0" 
                Background="{StaticResource BlackPrimaryBrush}">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Margin="60">
                <!-- Logo -->
                <TextBlock Text="HOLOCREW" 
                           FontSize="48" 
                           FontWeight="Black" 
                           Foreground="{StaticResource WhitePrimaryBrush}" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Emoji -->
                <TextBlock Text="👋" 
                           FontSize="100"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40" />

                <!-- Mensaje -->
                <TextBlock Text="WELCOME BACK" 
                           Style="{StaticResource HeadingLarge}"
                           Foreground="{StaticResource WhitePrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15" />
                <TextBlock Text="Sign in to continue your shopping experience" 
                           Style="{StaticResource BodyLarge}"
                           Foreground="{StaticResource Gray400Brush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="350"/>
            </StackPanel>
        </Border>

        <!-- ============================================
             FORMULARIO DERECHO
             ============================================ -->
        <Border Grid.Column="1" 
                Background="{StaticResource WhitePrimaryBrush}"
                Padding="80,60">
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="400">

                <!-- Título -->
                <TextBlock Text="SIGN IN" 
                           Style="{StaticResource HeadingLarge}"
                           Margin="0,0,0,50" />

                <!-- Email -->
                <TextBlock Text="EMAIL" 
                           Style="{StaticResource BodyMedium}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Border BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="2"
                        Height="55"
                        Margin="0,0,0,25">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="15,0"
                             VerticalAlignment="Center"
                             FontSize="15"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="PASSWORD" 
                           Style="{StaticResource BodyMedium}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Border BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="2"
                        Height="55"
                        Margin="0,0,0,15">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="15,0"
                                 VerticalAlignment="Center"
                                 FontSize="15"/>
                </Border>

                <!-- Remember Me & Forgot Password -->
                <Grid Margin="0,0,0,35">
                    <CheckBox Content="Remember me"
                              Style="{StaticResource BodyMedium}"
                              VerticalAlignment="Center"/>
                    <Button Content="Forgot password?" 
                            Style="{StaticResource TextButton}"
                            FontSize="14"
                            Foreground="{StaticResource TextSecondary}"
                            HorizontalAlignment="Right"
                            Command="{Binding ForgotPasswordCommand}"/>
                </Grid>

                <!-- Sign In Button -->
                <Button Content="SIGN IN" 
                        Style="{StaticResource PrimaryButton}"
                        FontSize="15"
                        Padding="0,18"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Margin="0,0,0,30"
                        HorizontalAlignment="Stretch"/>

                <!-- Register Link -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,30">
                    <TextBlock Text="Don't have an account? " 
                               Style="{StaticResource BodyMedium}"
                               Foreground="{StaticResource TextSecondary}"/>
                    <Button Content="Register here" 
                            Style="{StaticResource TextButton}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="0"
                            Command="{Binding NavigateToRegisterCommand}"/>
                </StackPanel>

                <!-- Divider -->
                <Grid Margin="0,0,0,30">
                    <Border Height="1" 
                            Background="{StaticResource BorderDefault}"/>
                    <Border Background="{StaticResource WhitePrimaryBrush}"
                            Padding="15,0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="OR CONTINUE WITH" 
                                   Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </Grid>

                <!-- Social Login -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="GOOGLE"
                            Style="{StaticResource OutlineButton}"
                            FontSize="13"
                            Padding="0,15"
                            HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2"
                            Content="FACEBOOK"
                            Style="{StaticResource OutlineButton}"
                            FontSize="13"
                            Padding="0,15"
                            HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Error Message -->
                <Border Background="{StaticResource ErrorColorBrush}"
                        Padding="15"
                        Margin="0,30,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Style="{StaticResource BodySmall}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>

                <!-- Loading -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,30,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⏳" 
                               FontSize="32" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="SIGNING IN..." 
                               Style="{StaticResource BodyMedium}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
