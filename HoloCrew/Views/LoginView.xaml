<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="800" Style="{StaticResource FadeIn}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="400"/>
                <ColumnDefinition Width="*" MinWidth="450" MaxWidth="550"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE - HERO -->
            <Border Grid.Column="0"
                    Background="{StaticResource BlackPrimaryBrush}"
                    Padding="60,80">
                <StackPanel VerticalAlignment="Center"
                            MaxWidth="500">
                    <TextBlock Text="🛍️" 
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="HOLOCREW" 
                               FontSize="56"
                               FontWeight="Bold"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Tu tienda online de confianza" 
                               FontSize="20"
                               Foreground="{StaticResource Gray400Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,50"/>

                    <!-- Benefits -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="✓" 
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,15,0"/>
                            <TextBlock Text="Envío gratis en pedidos superiores a 50€" 
                                       FontSize="16"
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="✓" 
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,15,0"/>
                            <TextBlock Text="Devoluciones gratis en 30 días" 
                                       FontSize="16"
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" 
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,15,0"/>
                            <TextBlock Text="Descuentos exclusivos para miembros" 
                                       FontSize="16"
                                       Foreground="{StaticResource WhitePrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RIGHT SIDE - FORM -->
            <Border Grid.Column="1"
                    Background="{StaticResource WhitePrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="60,80"
                            MaxWidth="450">
                        <StackPanel>

                            <!-- Header -->
                            <TextBlock Text="Iniciar Sesión" 
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Bienvenido de nuevo" 
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,40"/>

                            <!-- ⭐ ERROR MESSAGE GENERAL -->
                            <Border Background="#FFF3CD"
                                    BorderBrush="#FF6B6B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" 
                                               FontSize="16"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding ErrorMessage}" 
                                               Foreground="#721C24"
                                               TextWrapping="Wrap"
                                               FontSize="14"/>
                                </StackPanel>
                            </Border>

                            <!-- ⭐ EMAIL FIELD CON VALIDACIÓN COMPLETA -->
                            <TextBlock Text="Email" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,5">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource StandardTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEmailError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource RedAccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- ⭐ MENSAJE DE ERROR EMAIL -->
                            <TextBlock Text="{Binding EmailErrorMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource RedAccentBrush}"
                                       Margin="0,0,0,15"
                                       Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- ⭐ PASSWORD FIELD CON VALIDACIÓN COMPLETA -->
                            <TextBlock Text="Contraseña" 
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <PasswordBox x:Name="PasswordBox"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         Margin="0,0,0,5">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource StandardPasswordBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPasswordError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource RedAccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <!-- ⭐ MENSAJE DE ERROR PASSWORD -->
                            <TextBlock Text="{Binding PasswordErrorMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource RedAccentBrush}"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Remember Me & Forgot Password -->
                            <Grid Margin="0,0,0,30">
                                <CheckBox Content="Recordarme"
                                          IsChecked="{Binding RememberMe}"
                                          VerticalAlignment="Center"
                                          FontSize="14"/>

                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <Hyperlink Command="{Binding ForgotPasswordCommand}"
                                               Style="{StaticResource ModernHyperlink}">
                                        <Run Text="¿Olvidaste tu contraseña?" FontSize="14"/>
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>

                            <!-- ⭐ LOGIN BUTTON CON LOADING - CORREGIDO -->
                            <Button Command="{Binding LoginCommand}"
                                    Style="{StaticResource AccentButton}"
                                    Height="50"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,20">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- ⭐ CORREGIDO: Loading spinner SIN Style duplicado -->
                                        <TextBlock Text="⏳" 
                                                   FontSize="16"
                                                   Margin="0,0,10,0"
                                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Pulse}"/>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="INICIAR SESIÓN"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter Property="Text" Value="INICIANDO..."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <!-- Divider -->
                            <Grid Margin="0,0,0,20">
                                <Border BorderBrush="{StaticResource BorderDefault}"
                                        BorderThickness="0,1,0,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="O continuar con"
                                           Background="{StaticResource WhitePrimaryBrush}"
                                           Padding="15,0"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Grid>

                            <!-- OAuth Buttons -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Height="50" Cursor="Hand"
                                        Background="White" BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="G" FontSize="18" FontWeight="Bold" Foreground="#DB4437" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Google" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Height="50" Cursor="Hand"
                                        Background="White" BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="f" FontSize="20" FontWeight="Bold" Foreground="#1877F2" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Facebook" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Register Link -->
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0,30,0,0"
                                       FontSize="14">
                                <Run Text="¿No tienes cuenta?" Foreground="{StaticResource TextSecondary}"/>
                                <Hyperlink Command="{Binding NavigateToRegisterCommand}"
                                           Style="{StaticResource ModernHyperlink}"
                                           FontWeight="SemiBold">
                                    <Run Text="Regístrate aquí"/>
                                </Hyperlink>
                            </TextBlock>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
