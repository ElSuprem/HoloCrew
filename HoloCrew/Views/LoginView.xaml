<UserControl x:Class="HoloCrew.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE - HERO IMAGE/INFO -->
        <Border Grid.Column="0"
                Background="{StaticResource BlackPrimaryBrush}"
                Padding="80">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🛍️" 
                           FontSize="100"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="HOLOCREW" 
                           FontSize="56"
                           FontWeight="Bold"
                           Foreground="{StaticResource WhitePrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Tu tienda online de confianza" 
                           FontSize="20"
                           Foreground="{StaticResource Gray400Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,50"/>

                <!-- Benefits -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="✓" 
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,15,0"/>
                        <TextBlock Text="Envío gratis en pedidos superiores a 50€" 
                                   FontSize="16"
                                   Foreground="{StaticResource WhitePrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="✓" 
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,15,0"/>
                        <TextBlock Text="Devoluciones gratis en 30 días" 
                                   FontSize="16"
                                   Foreground="{StaticResource WhitePrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" 
                                   FontSize="24"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,15,0"/>
                        <TextBlock Text="Descuentos exclusivos para miembros" 
                                   FontSize="16"
                                   Foreground="{StaticResource WhitePrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT SIDE - LOGIN FORM -->
        <Border Grid.Column="1"
                Background="{StaticResource WhitePrimaryBrush}"
                Padding="60">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">

                    <!-- Header -->
                    <TextBlock Text="Iniciar Sesión" 
                               FontSize="36"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Bienvenido de nuevo" 
                               FontSize="16"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,40"/>

                    <!-- Error Message -->
                    <Border Background="#FFF3CD"
                            BorderBrush="#FF6B6B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,20"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="#721C24"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                    </Border>

                    <!-- Email Field -->
                    <TextBlock Text="Email" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <!-- ⭐ SIN ESTILO PERSONALIZADO -->
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"
                             Padding="10"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BorderDefault}"
                             Margin="0,0,0,20"/>

                    <!-- Password Field -->
                    <TextBlock Text="Contraseña" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <!-- ⭐ SIN ESTILO PERSONALIZADO -->
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 FontSize="16"
                                 Padding="10"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BorderDefault}"
                                 Margin="0,0,0,10"/>

                    <!-- Remember Me & Forgot Password -->
                    <Grid Margin="0,0,0,30">
                        <CheckBox Content="Recordarme"
                                  IsChecked="{Binding RememberMe}"
                                  VerticalAlignment="Center"
                                  FontSize="14"/>

                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Hyperlink Command="{Binding ForgotPasswordCommand}"
                                       TextDecorations="None"
                                       Foreground="{StaticResource AccentBrush}">
                                <Run Text="¿Olvidaste tu contraseña?" FontSize="14"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- Login Button -->
                    <Button Content="INICIAR SESIÓN"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource AccentButton}"
                            Height="50"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,20"/>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,20">
                        <Border Height="1"
                                Background="{StaticResource BorderDefault}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="O continúa con"
                                   Background="{StaticResource WhitePrimaryBrush}"
                                   Padding="15,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Grid>

                    <!-- Social Login Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Google -->
                        <Button Grid.Column="0"
                                Command="{Binding LoginWithGoogleCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="50"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔵" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Google" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Facebook -->
                        <Button Grid.Column="1"
                                Command="{Binding LoginWithFacebookCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="50"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📘" FontSize="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Facebook" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Register Link -->
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,30,0,0"
                               FontSize="14">
                        <Run Text="¿No tienes cuenta?" Foreground="{StaticResource TextSecondary}"/>
                        <Hyperlink Command="{Binding NavigateToRegisterCommand}"
                                   TextDecorations="None"
                                   Foreground="{StaticResource AccentBrush}">
                            <Run Text="Regístrate" FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
