<UserControl x:Class="HoloCrew.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Imagen/Ilustración -->
            <ColumnDefinition Width="*" />
            <!-- Formulario -->
        </Grid.ColumnDefinitions>

        <!-- IZQUIERDA: Ilustración -->
        <Border Grid.Column="0" 
                Background="#E3F2FD">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <TextBlock Text="🛍️" 
                           FontSize="120"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />
                <TextBlock Text="Bienvenido de nuevo" 
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock Text="Inicia sesión para continuar" 
                           FontSize="16"
                           Foreground="#555"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- DERECHA: Formulario -->
        <Border Grid.Column="1" 
                Padding="60">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Iniciar Sesión" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           Margin="0,0,0,40" />

                <!-- Campos del formulario -->
                <StackPanel>
                    <TextBlock Text="Email" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding Email}"
                             Padding="15,12"
                             FontSize="14"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Margin="0,0,0,20">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Contraseña" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" />
                    <PasswordBox x:Name="PasswordBox"
                                 Padding="15,12"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Margin="0,0,0,10">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="PasswordBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#1976D2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <!-- Recordar contraseña -->
                    <CheckBox Content="Recordar contraseña"
          FontSize="13"
          Margin="0,0,0,30" />
                </StackPanel>

                <!-- Botón de inicio de sesión -->
                <Button Content="Iniciar Sesión" 
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Padding="20,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,20">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#115293" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BBDEFB" />
                                    <Setter Property="Foreground" Value="#90A4AE" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Enlaces adicionales -->
                <StackPanel>
                    <Button Content="¿Olvidaste tu contraseña?"
                            Padding="0"
                            FontSize="13"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1976D2"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="¿No tienes una cuenta?" 
                               FontSize="13"
                               Foreground="#666"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5" />

                    <Button Content="Regístrate aquí" 
                            Command="{Binding NavigateToRegisterCommand}"
                            Padding="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1976D2"
                            HorizontalAlignment="Center"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1" 
                        Background="#E0E0E0"
                        Margin="0,30,0,30" />

                <!-- Inicio de sesión social -->
                <TextBlock Text="O inicia sesión con" 
                           FontSize="14"
                           Foreground="#666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15" />

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Content="Google"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="White"
                            Foreground="#555"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Facebook"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="White"
                            Foreground="#555"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Mensaje de error -->
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                        Background="#FFEBEE"
                        Padding="15"
                        Margin="0,30,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               FontSize="13"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>

                <!-- Loading -->
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Height="50"
                      Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="⏳" 
                                   FontSize="24" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="Iniciando sesión..." 
                                   FontSize="12" 
                                   Foreground="#666" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>