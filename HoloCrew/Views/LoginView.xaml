<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <!-- Vista de inicio de sesión.
         Formulario centrado con email, contraseña, botón de inicio, enlaces a registro y recuperación.
         Se conecta con LoginViewModel. -->

    <Border Padding="0,40,0,60">
        <Grid HorizontalAlignment="Center" MaxWidth="520">
            <Border Background="{DynamicResource WhitePrimaryBrush}"
                    BorderBrush="{DynamicResource Gray200Brush}"
                    BorderThickness="1"
                    Padding="60,50">

                <StackPanel>

                    <!-- logo -->
                    <TextBlock Text="HOLOCREW" 
                               FontSize="24" 
                               FontWeight="Black" 
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>

                    <!-- título -->
                    <TextBlock Text="WELCOME BACK" 
                               FontSize="28"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Access your account to manage orders" 
                               FontSize="14"
                               Foreground="{DynamicResource Gray500Brush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>

                    <!-- mensaje de proceso (iniciando sesión) - estilo neutro, NO error -->
                    <Border Background="#F3F4F6"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,20"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="M12 6v6l4 2 M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                          Stroke="#4B5563" StrokeThickness="2" Fill="Transparent"/>
                                </Viewbox>
                                <TextBlock Text="Signing you in…"
                                           Foreground="#4B5563"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         Background="Transparent"
                                         Foreground="#4B5563"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- mensaje de error (solo cuando hay un error real) -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Path Data="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" 
                                      Stroke="#DC2626" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="{Binding ErrorMessage}" 
                                       Foreground="#DC2626"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- campo email -->
                    <TextBlock Text="Email or Username" 
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48" Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEmailError}" Value="True">
                                        <Setter Property="BorderBrush" Value="#DC2626"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <Path Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6" 
                                      Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource BlackPrimaryBrush}"
                                     CaretBrush="{DynamicResource BlackPrimaryBrush}"
                                     BorderThickness="0"
                                     Padding="42,0,15,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"/>
                            <TextBlock Text="john@example.com"
                                       Foreground="{DynamicResource Gray400Brush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="42,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Email}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Email}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- error de email -->
                    <TextBlock Text="{Binding EmailErrorMessage}"
                               FontSize="12"
                               Foreground="#DC2626"
                               Margin="0,-15,0,5"
                               Visibility="{Binding HasEmailError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- campo contraseña -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Password" 
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Forgot your password?" 
                                   FontSize="13"
                                   Foreground="{DynamicResource BlackPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding ForgotPasswordCommand}" MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                    <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48" Margin="0,0,0,5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPasswordError}" Value="True">
                                        <Setter Property="BorderBrush" Value="#DC2626"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <Path Data="M19 11H5V21H19V11ZM17 11V7C17 4.24 14.76 2 12 2C9.24 2 7 4.24 7 7V11" 
                                      Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <PasswordBox x:Name="PasswordBox"
                                         Background="Transparent"
                                         Foreground="{DynamicResource BlackPrimaryBrush}"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         BorderThickness="0"
                                         Padding="42,0,15,0"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"/>
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Text="••••••••"
                                       Foreground="{DynamicResource Gray400Brush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="42,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <!-- error de contraseña -->
                    <TextBlock Text="{Binding PasswordErrorMessage}"
                               FontSize="12"
                               Foreground="#DC2626"
                               Margin="0,0,0,10"
                               Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- recordar sesión -->
                    <CheckBox Content="Remember me"
                              IsChecked="{Binding RememberMe}"
                              Foreground="{DynamicResource BlackPrimaryBrush}"
                              VerticalAlignment="Center"
                              FontSize="14"
                              Margin="0,10,0,25"
                              Cursor="Hand"/>

                    <!-- botón iniciar sesión -->
                    <Button Command="{Binding LoginCommand}"
                            Height="52"
                            Cursor="Hand"
                            Margin="0,0,0,25">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="SIGN IN  →"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Text" Value="SIGNING IN..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <!-- separador -->
                    <Grid Margin="0,0,0,25">
                        <Border BorderBrush="{DynamicResource Gray200Brush}"
                                BorderThickness="0,1,0,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Or continue with"
                                   Background="{DynamicResource WhitePrimaryBrush}"
                                   Padding="15,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource Gray500Brush}"/>
                    </Grid>

                    <!-- botones de redes sociales -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="48" Cursor="Hand"
                                Background="{DynamicResource WhitePrimaryBrush}" BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="G" FontSize="18" FontWeight="Bold" Foreground="#DB4437" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Google" FontSize="14" Foreground="{DynamicResource BlackPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Height="48" Cursor="Hand"
                                Background="{DynamicResource WhitePrimaryBrush}" BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Apple" FontSize="14" Foreground="{DynamicResource BlackPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,1,0,0" Margin="0,0,0,25"/>

                    <!-- enlace a registro -->
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="14"
                               Margin="0,0,0,5">
                        <Run Text="Don't have an account?" Foreground="{DynamicResource Gray500Brush}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Hyperlink Command="{Binding NavigateToRegisterCommand}"
                                   TextDecorations="None"
                                   Foreground="{DynamicResource BlackPrimaryBrush}"
                                   FontWeight="Bold"
                                   FontSize="14">
                            <Run Text="Join the Members Club  →"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontSize="13">
                        <Run Text="Get " Foreground="{DynamicResource Gray500Brush}"/>
                        <Run Text="200 FREE CREDITS" FontWeight="Bold" Foreground="{DynamicResource BlackPrimaryBrush}"/>
                        <Run Text=" when you register" Foreground="{DynamicResource Gray500Brush}"/>
                    </TextBlock>

                </StackPanel>
            </Border>
        </Grid>
    </Border>

</UserControl>
