<UserControl x:Class="HoloCrew.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock Text="Mi Perfil" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,30" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR: Navegación perfil -->
                <Border Grid.Column="0" 
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,1,0"
                        Padding="20">
                    <StackPanel>
                        <!-- Información usuario -->
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="80" 
                                        Height="80"
                                        Background="#1976D2"
                                        Margin="0,0,0,15">
                                    <TextBlock Text="{Binding UserInitials}" 
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding UserFullName}" 
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding UserEmail}" 
                                           FontSize="13"
                                           Foreground="#666"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Menú navegación -->
                        <StackPanel>
                            <Button Content="📝 Información personal" 
                                    Command="{Binding NavigateToPersonalInfoCommand}"
                                    Padding="15,12"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#555"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Margin="0,0,0,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#1976D2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="📍 Direcciones" 
                                    Command="{Binding NavigateToAddressesCommand}"
                                    Padding="15,12"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#555"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Margin="0,0,0,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#1976D2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="💳 Métodos de pago" 
                                    Command="{Binding NavigateToPaymentMethodsCommand}"
                                    Padding="15,12"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#555"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Margin="0,0,0,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#1976D2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="🔔 Notificaciones" 
                                    Command="{Binding NavigateToNotificationsCommand}"
                                    Padding="15,12"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#555"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Margin="0,0,0,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#1976D2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="⚙️ Configuración" 
                                    Command="{Binding NavigateToSettingsCommand}"
                                    Padding="15,12"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#555"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Margin="0,0,0,5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#1976D2" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Cerrar sesión -->
                        <Button Content="🚪 Cerrar sesión" 
                                Command="{Binding LogoutCommand}"
                                Padding="15,12"
                                FontSize="14"
                                Background="Transparent"
                                BorderBrush="#F44336"
                                BorderThickness="1"
                                Foreground="#F44336"
                                Cursor="Hand"
                                Margin="0,30,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFEBEE" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CONTENIDO PRINCIPAL -->
                <StackPanel Grid.Column="1" 
                            Margin="40,0,0,0">

                    <!-- Sección seleccionada -->
                    <ContentControl Content="{Binding SelectedSection}">
                        <ContentControl.Resources>
                            <!-- Personal Info Template -->
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Información Personal" 
                                               FontSize="24" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,30" />

                                    <Border Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            Padding="30">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Nombre" 
                                                               FontWeight="SemiBold" 
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding FirstName}"
                                                             Padding="12,10"
                                                             FontSize="14"
                                                             BorderBrush="#E0E0E0"
                                                             BorderThickness="1" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="Apellidos" 
                                                               FontWeight="SemiBold" 
                                                               Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding LastName}"
                                                             Padding="12,10"
                                                             FontSize="14"
                                                             BorderBrush="#E0E0E0"
                                                             BorderThickness="1" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Email" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,20,0,8" />
                                            <TextBox Text="{Binding Email}"
                                                     Padding="12,10"
                                                     FontSize="14"
                                                     BorderBrush="#E0E0E0"
                                                     BorderThickness="1"
                                                     Margin="0,0,0,20" />

                                            <TextBlock Text="Teléfono" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,0,0,8" />
                                            <TextBox Text="{Binding PhoneNumber}"
                                                     Padding="12,10"
                                                     FontSize="14"
                                                     BorderBrush="#E0E0E0"
                                                     BorderThickness="1"
                                                     Margin="0,0,0,20" />

                                            <TextBlock Text="Fecha de Nacimiento" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,0,0,8" />
                                            <DatePicker SelectedDate="{Binding BirthDate}"
                                                        Padding="12,10"
                                                        FontSize="14"
                                                        BorderBrush="#E0E0E0"
                                                        BorderThickness="1"
                                                        Margin="0,0,0,30" />

                                            <Button Content="Guardar Cambios" 
                                                    Command="{Binding SavePersonalInfoCommand}"
                                                    Padding="20,12"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Background="#1976D2"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Right">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#115293" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>

                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#80FFFFFF"
                  Height="400">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Cargando perfil..." FontSize="16" Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>