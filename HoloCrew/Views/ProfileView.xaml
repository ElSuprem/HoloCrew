<UserControl x:Class="HoloCrew.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <!-- Sidebar -->
            <ColumnDefinition Width="*" />
            <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ============================================
             SIDEBAR (NEGRO)
             ============================================ -->
        <Border Grid.Column="0" 
                Background="#0A0A0A"
                BorderBrush="#2E2E2E"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Border Padding="30,40">
                    <StackPanel>
                        <!-- Avatar + User Info -->
                        <Border Background="#1A1A1A"
                                Padding="25"
                                Margin="0,0,0,40">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Avatar Circle -->
                                <Border Width="90" 
                                        Height="90"
                                        CornerRadius="45"
                                        Background="{DynamicResource RedAccentBrush}"
                                        Margin="0,0,0,20">
                                    <TextBlock Text="{Binding UserInitials}" 
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource WhitePrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- User Name -->
                                <TextBlock Text="{Binding UserFullName}" 
                                           Style="{StaticResource SubtitleLarge}"
                                           Foreground="{DynamicResource WhitePrimaryBrush}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <!-- Email -->
                                <TextBlock Text="{Binding UserEmail}" 
                                           Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource Gray400Brush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Navigation Menu -->
                        <StackPanel>
                            <TextBlock Text="ACCOUNT" 
                                       Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource Gray500Brush}"
                                       Margin="0,0,0,15"/>

                            <Button Content="Personal Info" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{DynamicResource WhitePrimaryBrush}"
                                    FontSize="14"
                                    Padding="0,12"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToPersonalInfoCommand}"
                                    Margin="0,0,0,5"/>

                            <Button Content="Addresses" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{DynamicResource Gray400Brush}"
                                    FontSize="14"
                                    Padding="0,12"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToAddressesCommand}"
                                    Margin="0,0,0,5"/>

                            <Button Content="Payment Methods" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{DynamicResource Gray400Brush}"
                                    FontSize="14"
                                    Padding="0,12"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToPaymentMethodsCommand}"
                                    Margin="0,0,0,5"/>

                            <Button Content="Order History" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{DynamicResource Gray400Brush}"
                                    FontSize="14"
                                    Padding="0,12"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToOrderHistoryCommand}"
                                    Margin="0,0,0,5"/>

                            <Button Content="Settings" 
                                    Style="{StaticResource TextButton}"
                                    Foreground="{DynamicResource Gray400Brush}"
                                    FontSize="14"
                                    Padding="0,12"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding NavigateToSettingsCommand}"
                                    Margin="0,0,0,40"/>

                            <!-- Logout -->
                            <Border BorderBrush="{DynamicResource ErrorColorBrush}"
                                    BorderThickness="2"
                                    Height="50">
                                <Button Content="LOGOUT" 
                                        Style="{StaticResource TextButton}"
                                        Foreground="{DynamicResource ErrorColorBrush}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Command="{Binding LogoutCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ============================================
             CONTENIDO PRINCIPAL
             ============================================ -->
        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Border Padding="60,40,60,80">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="PERSONAL INFORMATION" 
                               Style="{StaticResource HeadingLarge}"
                               Margin="0,0,0,40" />

                    <!-- Personal Info Card -->
                    <Border Background="{DynamicResource WhitePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            Padding="40"
                            Margin="0,0,0,40">
                        <StackPanel>
                            <!-- First Name & Last Name -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FIRST NAME" 
                                               Style="{StaticResource BodyMedium}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <Border BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="2"
                                            Height="50">
                                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="15,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LAST NAME" 
                                               Style="{StaticResource BodyMedium}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <Border BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="2"
                                            Height="50">
                                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="15,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="14"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Email & Phone -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="EMAIL" 
                                               Style="{StaticResource BodyMedium}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <Border BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="2"
                                            Height="50">
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="15,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PHONE" 
                                               Style="{StaticResource BodyMedium}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <Border BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="2"
                                            Height="50">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="15,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="14"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Save Button -->
                            <Button Content="SAVE CHANGES" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveChangesCommand}"
                                    Width="200"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent Orders Section -->
                    <TextBlock Text="RECENT ORDERS" 
                               Style="{StaticResource HeadingMedium}"
                               Margin="0,0,0,25" />

                    <!-- Orders List -->
                    <ItemsControl ItemsSource="{Binding RecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WhitePrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDefault}"
                                        BorderThickness="1"
                                        Padding="30"
                                        Margin="0,0,0,20"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding DataContext.ViewOrderDetailCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      MouseAction="LeftClick"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Order Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SubtitleMedium}">
                                                <Run Text="Order #"/>
                                                <Run Text="{Binding OrderNumber}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding OrderDate, StringFormat='MMMM dd, yyyy'}"
                                                       Style="{StaticResource BodySmall}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <!-- Items Count -->
                                        <StackPanel Grid.Column="1" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,40,0">
                                            <TextBlock Style="{StaticResource BodySmall}"
                                                       Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="{Binding ItemCount}"/>
                                                <Run Text=" items"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Total -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Total, StringFormat='{}{0:N2}€'}"
                                                   Style="{StaticResource SubtitleLarge}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,40,0"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3"
                                                Background="{DynamicResource SuccessColorBrush}"
                                                Padding="15,8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource Caption}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WhitePrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- View All Orders Button -->
                    <Button Content="VIEW ALL ORDERS →" 
                            Style="{StaticResource TextButton}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            Command="{Binding NavigateToOrderHistoryCommand}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
