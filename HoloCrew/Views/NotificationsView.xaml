<UserControl x:Class="HoloCrew.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <Grid Margin="0,0,0,30">
                <TextBlock Text="Notificaciones" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Marcar todas como leídas" 
                            Command="{Binding MarkAllAsReadCommand}"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            Foreground="#1976D2"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Limpiar todas" 
                            Command="{Binding ClearAllCommand}"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            Foreground="#F44336"
                            BorderBrush="#F44336"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filtros -->
            <Border Background="#F8F9FA"
                    Padding="20"
                    Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filtrar:" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0" />

                    <Button Content="Todas" 
                            Command="{Binding ShowAllCommand}"
                            Padding="15,8"
                            FontSize="13"
                            Background="{Binding IsAllSelected, Converter={StaticResource SelectedButtonConverter}}"
                            Foreground="{Binding IsAllSelected, Converter={StaticResource SelectedButtonTextConverter}}"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="No leídas" 
                            Command="{Binding ShowUnreadCommand}"
                            Padding="15,8"
                            FontSize="13"
                            Background="{Binding IsUnreadSelected, Converter={StaticResource SelectedButtonConverter}}"
                            Foreground="{Binding IsUnreadSelected, Converter={StaticResource SelectedButtonTextConverter}}"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Pedidos" 
                            Command="{Binding ShowOrdersCommand}"
                            Padding="15,8"
                            FontSize="13"
                            Background="{Binding IsOrdersSelected, Converter={StaticResource SelectedButtonConverter}}"
                            Foreground="{Binding IsOrdersSelected, Converter={StaticResource SelectedButtonTextConverter}}"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Promociones" 
                            Command="{Binding ShowPromotionsCommand}"
                            Padding="15,8"
                            FontSize="13"
                            Background="{Binding IsPromotionsSelected, Converter={StaticResource SelectedButtonConverter}}"
                            Foreground="{Binding IsPromotionsSelected, Converter={StaticResource SelectedButtonTextConverter}}"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Lista de notificaciones -->
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding IsRead, Converter={StaticResource NotificationBackgroundConverter}}"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Margin="0,0,0,15"
                                Padding="25"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ViewNotificationCommand, 
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icono -->
                                <Border Grid.Column="0" 
                                        Background="{Binding TypeColor}"
                                        Width="50"
                                        Height="50"
                                        Margin="0,0,20,0">
                                    <TextBlock Text="{Binding TypeIcon}" 
                                               FontSize="20"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Contenido -->
                                <StackPanel Grid.Column="1" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding Message}" 
                                               FontSize="14"
                                               Foreground="#555"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Fecha -->
                                <StackPanel Grid.Column="2" 
                                            Margin="20,0,20,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeAgo}" 
                                               FontSize="12"
                                               Foreground="#999" />

                                    <!-- Indicador no leído -->
                                    <Border Width="8"
                                            Height="8"
                                            Background="#1976D2"
                                            HorizontalAlignment="Center"
                                            Margin="0,5,0,0"
                                            Visibility="{Binding IsRead, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                                </StackPanel>

                                <!-- Acciones -->
                                <StackPanel Grid.Column="3" 
                                            VerticalAlignment="Center">
                                    <Button Content="Marcar como leída" 
                                            Command="{Binding DataContext.MarkAsReadCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,8"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Background="Transparent"
                                            Foreground="#1976D2"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Margin="0,0,0,5"
                                            Visibility="{Binding IsRead, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Eliminar" 
                                            Command="{Binding DataContext.DeleteNotificationCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,8"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Background="Transparent"
                                            Foreground="#F44336"
                                            BorderBrush="#F44336"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sin notificaciones -->
            <Border Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                    Background="#F8F9FA"
                    Padding="60"
                    Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔔" 
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="No hay notificaciones" 
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               Margin="0,0,0,15" />
                    <TextBlock Text="Aquí aparecerán tus notificaciones de pedidos, ofertas y novedades" 
                               FontSize="14"
                               Foreground="#777"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Configuración de notificaciones -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30"
                    Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="Preferencias de notificación" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <StackPanel>
                        <CheckBox Content="Recibir notificaciones por email"
                                  IsChecked="{Binding EmailNotifications}"
                                  FontSize="14"
                                  Margin="0,0,0,15" />

                        <CheckBox Content="Notificaciones push en la aplicación"
                                  IsChecked="{Binding PushNotifications}"
                                  FontSize="14"
                                  Margin="0,0,0,15" />

                        <CheckBox Content="Actualizaciones de pedidos"
                                  IsChecked="{Binding OrderUpdates}"
                                  FontSize="14"
                                  Margin="0,0,0,15" />

                        <CheckBox Content="Alertas de precio"
                                  IsChecked="{Binding PriceAlerts}"
                                  FontSize="14"
                                  Margin="0,0,0,15" />

                        <CheckBox Content="Ofertas y promociones"
                                  IsChecked="{Binding Promotions}"
                                  FontSize="14"
                                  Margin="0,0,0,30" />
                    </StackPanel>

                    <Button Content="Guardar preferencias" 
                            Command="{Binding SaveNotificationSettingsCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Height="200"
                  VerticalAlignment="Center"
                  Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Cargando notificaciones..." 
                               FontSize="16" 
                               Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>