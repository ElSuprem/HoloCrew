<UserControl x:Class="HoloCrew.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Border Padding="60,40,60,80">
        <StackPanel MaxWidth="900">
            <!-- Header -->
            <Grid Margin="0,0,0,40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NOTIFICATIONS" 
                               Style="{StaticResource HeadingLarge}"
                               VerticalAlignment="Center"/>
                    <!-- Unread count badge -->
                    <Border Background="{StaticResource RedAccentBrush}"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding UnreadCount}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="MARK ALL READ" 
                            Style="{StaticResource OutlineButton}"
                            FontSize="13"
                            Padding="20,12"
                            Command="{Binding MarkAllAsReadCommand}"
                            Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,15,0"/>

                    <Button Content="CLEAR ALL" 
                            Background="Transparent"
                            BorderBrush="{StaticResource ErrorColorBrush}"
                            BorderThickness="2"
                            Foreground="{StaticResource ErrorColorBrush}"
                            FontSize="13"
                            FontWeight="Bold"
                            Padding="20,12"
                            Cursor="Hand"
                            Command="{Binding ClearAllCommand}"
                            Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ErrorColorBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WhitePrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filtros -->
            <Border Background="{StaticResource Gray100Brush}"
                    Padding="25,20"
                    Margin="0,0,0,30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FILTER:" 
                               Style="{StaticResource BodyMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <!-- Filter buttons with selection indicator -->
                    <Button Content="ALL" 
                            FontSize="13"
                            FontWeight="SemiBold"
                            Padding="12,8"
                            Command="{Binding ShowAllCommand}"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFilter}" Value="All">
                                        <Setter Property="Background" Value="{StaticResource BlackPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="UNREAD" 
                            FontSize="13"
                            FontWeight="SemiBold"
                            Padding="12,8"
                            Command="{Binding ShowUnreadCommand}"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFilter}" Value="Unread">
                                        <Setter Property="Background" Value="{StaticResource BlackPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="ORDERS" 
                            FontSize="13"
                            FontWeight="SemiBold"
                            Padding="12,8"
                            Command="{Binding ShowOrdersCommand}"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFilter}" Value="Orders">
                                        <Setter Property="Background" Value="{StaticResource BlackPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="PROMOTIONS" 
                            FontSize="13"
                            FontWeight="SemiBold"
                            Padding="12,8"
                            Command="{Binding ShowPromotionsCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFilter}" Value="Promotions">
                                        <Setter Property="Background" Value="{StaticResource BlackPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Notifications List -->
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="25"
                                Margin="0,0,0,15"
                                Cursor="Hand"
                                BorderThickness="1">
                            <!-- Conditional style based on IsRead -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource WhitePrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding DataContext.OpenNotificationCommand, 
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              MouseAction="LeftClick"/>
                            </Border.InputBindings>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource Gray100Brush}"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Margin="0,0,15,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource BodyMedium}"
                                                   FontWeight="SemiBold"/>
                                        <!-- Unread indicator dot -->
                                        <Ellipse Width="8" Height="8" 
                                                 Fill="{StaticResource RedAccentBrush}"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}"
                                               Style="{StaticResource BodySmall}"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Time -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimeAgo}"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>

                                <!-- Delete button -->
                                <Button Grid.Column="3"
                                        Command="{Binding DataContext.DeleteNotificationCommand, 
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="30"
                                        Height="30"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="15"
                                                                Width="30" Height="30">
                                                            <TextBlock Text="✕" 
                                                                       FontSize="14"
                                                                       Foreground="{StaticResource Gray400Brush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{StaticResource ErrorColorBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty State -->
            <Border Background="{StaticResource Gray100Brush}"
                    Padding="60,80"
                    Visibility="{Binding HasNotifications, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="" 
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>
                    <TextBlock Text="NO NOTIFICATIONS" 
                               Style="{StaticResource HeadingMedium}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="You're all caught up! Notifications about orders, offers, and updates will appear here" 
                               Style="{StaticResource BodyLarge}"
                               Foreground="{StaticResource TextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                </StackPanel>
            </Border>

            <!-- Notification Preferences -->
            <Border Background="{StaticResource WhitePrimaryBrush}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    Padding="40"
                    Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="NOTIFICATION PREFERENCES" 
                               Style="{StaticResource HeadingMedium}"
                               Margin="0,0,0,25"/>

                    <!-- Email Notifications -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Email Notifications" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Receive notifications via email" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding EmailNotifications}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Push Notifications -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Push Notifications" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Receive in-app push notifications" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding PushNotifications}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Order Updates -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Order Updates" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Get notified about order status changes" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding OrderUpdates}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Price Alerts -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Price Alerts" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Get alerts when prices drop on wishlist items" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding PriceAlerts}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Promotions -->
                    <Grid Margin="0,0,0,30">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Offers &amp; Promotions" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Receive exclusive deals and special offers" 
                                       Style="{StaticResource BodySmall}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding Promotions}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Save Button -->
                    <Button Content="SAVE PREFERENCES" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveNotificationSettingsCommand}"
                            Width="220"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center"
                        Margin="0,60,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="⏳" 
                           FontSize="60" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <TextBlock Text="SAVING PREFERENCES..." 
                           Style="{StaticResource SubtitleLarge}"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
