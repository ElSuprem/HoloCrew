<UserControl x:Class="HoloCrew.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="60,40,60,80">
            <StackPanel MaxWidth="900">
                <!-- Header -->
                <Grid Margin="0,0,0,40">
                    <TextBlock Text="NOTIFICATIONS" 
                               Style="{StaticResource HeadingLarge}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="MARK ALL READ" 
                                Style="{StaticResource OutlineButton}"
                                FontSize="13"
                                Padding="20,12"
                                Command="{Binding MarkAllAsReadCommand}"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,15,0"/>

                        <Button Content="CLEAR ALL" 
                                Background="Transparent"
                                BorderBrush="{StaticResource ErrorColorBrush}"
                                BorderThickness="2"
                                Foreground="{StaticResource ErrorColorBrush}"
                                FontSize="13"
                                FontWeight="Bold"
                                Padding="20,12"
                                Cursor="Hand"
                                Command="{Binding ClearAllCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorColorBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhitePrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filtros -->
                <Border Background="{StaticResource Gray100Brush}"
                        Padding="25,20"
                        Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FILTER:" 
                                   Style="{StaticResource BodyMedium}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>

                        <Button Content="ALL" 
                                Style="{StaticResource TextButton}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Command="{Binding ShowAllCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="UNREAD" 
                                Style="{StaticResource TextButton}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Command="{Binding ShowUnreadCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="ORDERS" 
                                Style="{StaticResource TextButton}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Command="{Binding ShowOrdersCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="PROMOTIONS" 
                                Style="{StaticResource TextButton}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Command="{Binding ShowPromotionsCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Notifications List -->
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WhitePrimaryBrush}"
                                    BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="1"
                                    Padding="25"
                                    Margin="0,0,0,15"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding DataContext.OpenNotificationCommand, 
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  MouseAction="LeftClick"/>
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource Gray100Brush}"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource SubtitleMedium}"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Style="{StaticResource BodyMedium}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding TimeAgo}"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Gray400Brush}"/>
                                    </StackPanel>

                                    <!-- Unread Badge -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource RedAccentBrush}"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Margin="0,0,20,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="3"
                                            Content="✕"
                                            Style="{StaticResource TextButton}"
                                            FontSize="16"
                                            Width="30"
                                            Height="30"
                                            Foreground="{StaticResource Gray400Brush}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteNotificationCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Background="{StaticResource Gray100Brush}"
                        Padding="60,80"
                        Visibility="{Binding HasNotifications, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔔" 
                                   FontSize="100"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>
                        <TextBlock Text="NO NOTIFICATIONS" 
                                   Style="{StaticResource HeadingMedium}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="You're all caught up! Notifications about orders, offers, and updates will appear here" 
                                   Style="{StaticResource BodyLarge}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Border>

                <!-- Notification Preferences -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40"
                        Margin="0,40,0,0">
                    <StackPanel>
                        <TextBlock Text="NOTIFICATION PREFERENCES" 
                                   Style="{StaticResource HeadingMedium}"
                                   Margin="0,0,0,25"/>

                        <!-- Email Notifications -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Email Notifications" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Receive notifications via email" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding EmailNotifications}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Push Notifications -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Push Notifications" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Receive in-app push notifications" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding PushNotifications}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Order Updates -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Order Updates" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Get notified about order status changes" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding OrderUpdates}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Price Alerts -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Price Alerts" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Get alerts when prices drop on wishlist items" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding PriceAlerts}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Promotions -->
                        <Grid Margin="0,0,0,30">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Offers &amp; Promotions" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Receive exclusive deals and special offers" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding Promotions}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Save Button -->
                        <Button Content="SAVE PREFERENCES" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveNotificationSettingsCommand}"
                                Width="220"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Loading -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,60,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="⏳" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="LOADING NOTIFICATIONS..." 
                               Style="{StaticResource SubtitleLarge}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
