<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.BlackWeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1400" d:DesignWidth="1400"
             Background="#0A0A0A">

    <UserControl.Resources>
        <!-- Gold gradient brush -->
        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D4AF37" Offset="0"/>
            <GradientStop Color="#F4E4BC" Offset="0.5"/>
            <GradientStop Color="#D4AF37" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradientVertical" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D4AF37" Offset="0"/>
            <GradientStop Color="#AA8C2C" Offset="1"/>
        </LinearGradientBrush>

        <!-- ComboBox oscuro estilizado para tema negro -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Margin="12,0,0,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="▼"
                                               FontSize="10"
                                               Foreground="#888888"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   AllowsTransparency="True">
                                <Border Background="#1A1A1A"
                                        BorderBrush="#444444"
                                        BorderThickness="1"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#D4AF37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ============================================ -->
        <!-- LOADING STATE -->
        <!-- ============================================ -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#0A0A0A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding LoadingMessage}" 
                           FontSize="16"
                           Foreground="#888888"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- EMPTY STATE -->
        <!-- ============================================ -->
        <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#0A0A0A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                <TextBlock Text="🖤" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding EmptyTitle}" 
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="{Binding EmptySubtitle}" 
                           FontSize="16"
                           Foreground="#888888"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"/>
                <Button Content="{Binding EmptyActionText}"
                        Command="{Binding EmptyActionCommand}"
                        Padding="40,15"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="{StaticResource GoldGradientVertical}"
                        Foreground="#0A0A0A"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT -->
        <!-- ============================================ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>

                <!-- ============================================ -->
                <!-- HERO BANNER -->
                <!-- ============================================ -->
                <Border Background="#0A0A0A" Padding="80,80">
                    <Grid>
                        <!-- Decorative elements -->
                        <Border Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0">
                            <TextBlock Text="%" FontSize="300" FontWeight="Black" Foreground="White"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title and info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Badge -->
                                <Border Background="{StaticResource GoldGradientVertical}" 
                                        Padding="15,8"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,25">
                                    <TextBlock Text="⭐  T H E   B I G G E S T   S A L E   O F   T H E   Y E A R" 
                                               FontSize="10" 
                                               FontWeight="Bold"
                                               Foreground="#0A0A0A"/>
                                </Border>

                                <!-- Main title -->
                                <TextBlock Text="BLACK" 
                                           FontSize="90"
                                           FontWeight="Black"
                                           Foreground="White"
                                           Margin="0,0,0,-15"/>
                                <TextBlock Text="WEEK" 
                                           FontSize="90"
                                           FontWeight="Black"
                                           Foreground="{StaticResource GoldGradient}"
                                           Margin="0,0,0,25"/>

                                <TextBlock Text="{Binding SaleSubtitle}"
                                           FontSize="18"
                                           Foreground="#AAAAAA"
                                           Margin="0,0,0,30"/>

                                <!-- Stats row -->
                                <StackPanel Orientation="Horizontal">
                                    <Border BorderBrush="#333333" BorderThickness="0,0,1,0" Padding="0,0,30,0">
                                        <StackPanel>
                                            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource GoldGradient}">
                                                <Run Text="UP TO "/>
                                                <Run Text="{Binding MaxDiscountPercent, StringFormat={}{0:0}}"/>
                                                <Run Text="%"/>
                                            </TextBlock>
                                            <TextBlock Text="D I S C O U N T" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="30,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TotalProductCount}" 
                                                       FontSize="32" 
                                                       FontWeight="Bold" 
                                                       Foreground="White"/>
                                            <TextBlock Text="P R O D U C T S" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Countdown -->
                            <Border Grid.Column="1" 
                                    Background="#111111"
                                    BorderBrush="#222222"
                                    BorderThickness="1"
                                    Padding="50,40"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="S A L E   E N D S   I N"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,25"/>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- Days -->
                                        <StackPanel Margin="0,0,15,0">
                                            <Border Background="#1A1A1A" 
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    Padding="18,12"
                                                    MinWidth="65">
                                                <TextBlock Text="{Binding DaysRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="32"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="DAYS"
                                                       FontSize="9"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text=":"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"
                                                   VerticalAlignment="Top"
                                                   Margin="0,12,0,0"/>

                                        <!-- Hours -->
                                        <StackPanel Margin="15,0">
                                            <Border Background="#1A1A1A" 
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    Padding="18,12"
                                                    MinWidth="65">
                                                <TextBlock Text="{Binding HoursRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="32"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="HRS"
                                                       FontSize="9"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text=":"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"
                                                   VerticalAlignment="Top"
                                                   Margin="0,12,0,0"/>

                                        <!-- Minutes -->
                                        <StackPanel Margin="15,0">
                                            <Border Background="#1A1A1A" 
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    Padding="18,12"
                                                    MinWidth="65">
                                                <TextBlock Text="{Binding MinutesRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="32"
                                                           FontWeight="Black"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="MIN"
                                                       FontSize="9"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text=":"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#333333"
                                                   VerticalAlignment="Top"
                                                   Margin="0,12,0,0"/>

                                        <!-- Seconds -->
                                        <StackPanel Margin="15,0,0,0">
                                            <Border Background="#1A1A1A" 
                                                    BorderBrush="#D4AF37"
                                                    BorderThickness="1"
                                                    Padding="18,12"
                                                    MinWidth="65">
                                                <TextBlock Text="{Binding SecondsRemaining, StringFormat={}{0:D2}}"
                                                           FontSize="32"
                                                           FontWeight="Black"
                                                           Foreground="{StaticResource GoldGradient}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="SEC"
                                                       FontSize="9"
                                                       Foreground="#555555"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Urgency message -->
                                    <Border Background="#1A1A1A" 
                                            Padding="20,10" 
                                            Margin="0,25,0,0"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="⏰ Don't miss out!"
                                                   FontSize="12"
                                                   Foreground="#D4AF37"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- TOP DEALS SECTION -->
                <!-- ============================================ -->
                <Border Background="#111111" Padding="80,60">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                            <TextBlock Text="" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="TOP DEALS" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource GoldGradientVertical}" 
                                    Padding="12,5" 
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="BEST DISCOUNTS" 
                                           FontSize="10" 
                                           FontWeight="Bold"
                                           Foreground="#0A0A0A"/>
                            </Border>
                        </StackPanel>

                        <!-- Top Deals Grid (4 productos) -->
                        <ItemsControl ItemsSource="{Binding TopDeals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A"
                                            BorderBrush="#D4AF37"
                                            BorderThickness="2"
                                            Margin="8"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="280"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image con overlay -->
                                            <Border Grid.Row="0" Background="#252525">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding MainImageUrl}" 
                                                           Stretch="UniformToFill"/>

                                                    <!-- Discount badge grande -->
                                                    <Border Background="{StaticResource GoldGradientVertical}"
                                                            Padding="15,8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="0">
                                                        <TextBlock Foreground="#0A0A0A" FontSize="14" FontWeight="Black">
                                                            <Run Text="-"/>
                                                            <Run Text="{Binding DiscountPercentage, Mode=OneWay, StringFormat={}{0:0}}"/>
                                                            <Run Text="%"/>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Top Deal badge -->
                                                    <Border Background="#DC2626"
                                                            Padding="10,5"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0">
                                                        <TextBlock Text=" TOP DEAL" 
                                                                   Foreground="White" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Quick Add - CORREGIDO CON BUTTON -->
                                                    <Button Background="{StaticResource GoldGradientVertical}"
                                                            Height="45"
                                                            VerticalAlignment="Bottom"
                                                            Opacity="0"
                                                            x:Name="QuickAddTop"
                                                            Cursor="Hand"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" Height="45">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="ADD TO CART"
                                                                   Foreground="#0A0A0A"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Row="1" Margin="18">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource GoldGradient}"/>
                                                    <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}"
                                                               FontSize="14"
                                                               Foreground="#555555"
                                                               TextDecorations="Strikethrough"
                                                               Margin="12,4,0,0"/>
                                                </StackPanel>

                                                <TextBlock Foreground="#4ADE80" FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="Save €"/>
                                                    <Run Text="{Binding Savings, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="QuickAddTop"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="QuickAddTop"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- FILTERS BAR - CORREGIDO CON COMBOBOX OSCURO -->
                <!-- ============================================ -->
                <Border Background="#0A0A0A"
                        BorderBrush="#222222"
                        BorderThickness="0,1"
                        Padding="80,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category filters - CORREGIDO CON BUTTON -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Category:"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0"
                                                Padding="15,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                    <Setter Property="BorderBrush" Value="#333333"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#D4AF37"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Background" Value="#D4AF37"/>
                                                            <Setter Property="Foreground" Value="#0A0A0A"/>
                                                            <Setter Property="BorderBrush" Value="#D4AF37"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Sort dropdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Sort by:"
                                       FontSize="13"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortBy}"
                                      Width="180"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- ALL PRODUCTS GRID -->
                <!-- ============================================ -->
                <Border Padding="80,50" Background="#0A0A0A">
                    <StackPanel>
                        <TextBlock Text="ALL BLACK WEEK DEALS" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   Margin="0,0,0,30"/>

                        <ItemsControl ItemsSource="{Binding BlackWeekProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151515"
                                            BorderBrush="#252525"
                                            BorderThickness="1"
                                            Margin="8"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="260"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Image -->
                                            <Border Grid.Row="0" Background="#1A1A1A">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Image Source="{Binding MainImageUrl}" Stretch="UniformToFill"/>

                                                    <!-- Discount badge -->
                                                    <Border Background="#DC2626"
                                                            Padding="10,5"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="10,10,0,0">
                                                        <TextBlock Foreground="White" FontSize="12" FontWeight="Bold">
                                                            <Run Text="-"/>
                                                            <Run Text="{Binding DiscountPercentage, Mode=OneWay, StringFormat={}{0:0}}"/>
                                                            <Run Text="%"/>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Wishlist button -->
                                                    <Button Width="36" Height="36"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,10,10,0"
                                                            Cursor="Hand"
                                                            Panel.ZIndex="100"
                                                            Command="{Binding DataContext.ToggleWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Width="36" Height="36"
                                                                        Background="#2A2A2A"
                                                                        CornerRadius="18">
                                                                    <Grid>
                                                                        <!-- Corazón vacío -->
                                                                        <Viewbox Width="20" Height="20" Margin="0,1,0,0"
                                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                                  Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                                                                        </Viewbox>
                                                                        <!-- Corazón relleno -->
                                                                        <Viewbox Width="20" Height="20" Margin="0,1,0,0"
                                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                                  Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                                                        </Viewbox>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- Quick Add - CORREGIDO CON BUTTON -->
                                                    <Button Background="White"
                                                            Height="42"
                                                            VerticalAlignment="Bottom"
                                                            Opacity="0"
                                                            x:Name="QuickAdd"
                                                            Cursor="Hand"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" Height="42">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="ADD TO CART"
                                                                   Foreground="#0A0A0A"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Row="1" Margin="14">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="#DC2626"/>
                                                    <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2}€'}"
                                                               FontSize="12"
                                                               Foreground="#555555"
                                                               TextDecorations="Strikethrough"
                                                               Margin="10,3,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="QuickAdd"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="QuickAdd"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================ -->
                <!-- BOTTOM CTA -->
                <!-- ============================================ -->
                <Border Background="#111111" Padding="80,60">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Can't find what you're looking for?"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Explore our full catalog with thousands of products"
                                       FontSize="14"
                                       Foreground="#888888"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="BROWSE ALL PRODUCTS →"
                                Command="{Binding BrowseAllProductsCommand}"
                                Padding="35,15"
                                FontSize="13"
                                FontWeight="Bold"
                                Background="Transparent"
                                Foreground="{StaticResource GoldGradient}"
                                BorderBrush="{StaticResource GoldGradient}"
                                BorderThickness="2"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
