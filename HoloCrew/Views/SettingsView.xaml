<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <!-- Vista de configuración (Settings).
         Barra lateral con opciones de navegación, contenido principal con toggles y modales.
         Se conecta con SettingsViewModel. -->

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- barra lateral izquierda (siempre oscura) -->
            <Border Grid.Column="0" Background="#0A0A0A" Padding="30,50,30,40">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontSize="24" FontWeight="Black" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="Manage your preferences" FontSize="13" Foreground="{DynamicResource Gray500Brush}" Margin="0,0,0,40"/>

                    <!-- tarjeta del usuario -->
                    <Border Background="#1A1A1A" Padding="18,15" Margin="0,0,0,35" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding NavigateToProfileCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="#2A2A2A" CornerRadius="18">
                                <Grid>
                                    <!-- Icono genérico de usuario (visible si NO hay avatar) -->
                                    <Viewbox Width="16" Height="16"
                 Visibility="{Binding HasCurrentUserAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Path Data="M20 21V19C20 16.79 18.21 15 16 15H8C5.79 15 4 16.79 4 19V21M16 7C16 9.21 14.21 11 12 11C9.79 11 8 9.21 8 7C8 4.79 9.79 3 12 3C14.21 3 16 4.79 16 7Z" 
                  Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    </Viewbox>

                                    <!-- Avatar real recortado en círculo mediante OpacityMask -->
                                    <Grid Width="36" Height="36"
              Visibility="{Binding HasCurrentUserAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Ellipse Width="36" Height="36" Fill="Black"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.OpacityMask>
                                        <controls:AsyncImage Source="{Binding CurrentUserAvatarUrl}"
                                 Stretch="UniformToFill"
                                 Width="36"
                                 Height="36"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding CurrentUserEmail}" FontSize="11" Foreground="{DynamicResource Gray500Brush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource Gray500Brush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Gray600Brush}" Margin="5,0,0,12"/>
                    <TextBlock Text="Appearance" FontSize="14" Foreground="{DynamicResource Gray300Brush}" Margin="5,0,0,0" Padding="0,10" Cursor="Hand"/>
                    <TextBlock Text="Notifications" FontSize="14" Foreground="{DynamicResource Gray300Brush}" Margin="5,0,0,0" Padding="0,10" Cursor="Hand"/>

                    <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Gray600Brush}" Margin="5,25,0,12"/>
                    <TextBlock Text="Privacy &amp; Security" FontSize="14" Foreground="{DynamicResource Gray300Brush}" Margin="5,0,0,0" Padding="0,10" Cursor="Hand"/>
                    <TextBlock Text="Account" FontSize="14" Foreground="{DynamicResource Gray300Brush}" Margin="5,0,0,0" Padding="0,10" Cursor="Hand"/>

                    <TextBlock Text="SUPPORT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Gray600Brush}" Margin="5,25,0,12"/>
                    <TextBlock Text="Help &amp; Legal" FontSize="14" Foreground="{DynamicResource Gray300Brush}" Margin="5,0,0,0" Padding="0,10" Cursor="Hand"/>

                    <Border Height="1" Background="#2A2A2A" Margin="0,30,0,20"/>

                    <Button Command="{Binding LogoutCommand}" Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" Padding="5,10">
                                    <TextBlock Text="Sign Out" FontSize="14" Foreground="#EF4444"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1A1A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- contenido principal -->
            <Border Grid.Column="1" Background="{DynamicResource WhitePrimaryBrush}" Padding="60,50,60,80">
                <StackPanel MaxWidth="700">

                    <!-- APARIENCIA -->
                    <TextBlock Text="APPEARANCE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,0,0,20"/>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dark Mode" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Reduce screen brightness for comfortable viewing" FontSize="13" Foreground="{DynamicResource Gray500Brush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding IsDarkMode}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Language" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Select your preferred language" FontSize="13" Foreground="{DynamicResource Gray500Brush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" Width="180" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="12,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICACIONES -->
                    <TextBlock Text="NOTIFICATIONS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,45,0,20"/>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Enable notifications" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Receive important updates and alerts" FontSize="13" Foreground="{DynamicResource Gray500Brush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding NotificationsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <TextBlock Text="Email notifications" FontSize="14" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding EmailNotifications}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <TextBlock Text="Push notifications" FontSize="14" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding PushNotifications}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <TextBlock Text="Order updates" FontSize="14" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding OrderUpdates}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <TextBlock Text="Promotional emails" FontSize="14" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding PromotionalEmails}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- PRIVACIDAD Y SEGURIDAD -->
                    <TextBlock Text="PRIVACY &amp; SECURITY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,45,0,20"/>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <TextBlock Text="Data collection" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding DataCollectionEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <TextBlock Text="Personalized ads" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding PersonalizedAds}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,18">
                        <Grid>
                            <TextBlock Text="Share data with partners" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding ShareDataWithPartners}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- CUENTA -->
                    <TextBlock Text="ACCOUNT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,45,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="20,18" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding ChangePasswordCommand}" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Change Password" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Update your password" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="›" FontSize="20" Foreground="{DynamicResource Gray400Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="20,18" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding ExportDataCommand}" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Export My Data" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Download a copy of your data" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="›" FontSize="20" Foreground="{DynamicResource Gray400Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="20,18" Margin="0,15,0,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding DeleteAccountCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Delete Account" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626"/>
                                <TextBlock Text="Permanently delete your account and all data" FontSize="12" Foreground="#EF4444" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="›" FontSize="20" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- AYUDA Y LEGAL -->
                    <TextBlock Text="HELP &amp; LEGAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Gray400Brush}" Margin="0,45,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="20,18" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding ViewPrivacyPolicyCommand}" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Privacy Policy" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="20,18" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding ViewTermsOfServiceCommand}" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Terms of Service" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="20,18" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Command="{Binding ContactSupportCommand}" MouseAction="LeftClick"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Gray50Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Contact Support" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="HoloCrew v1.0.0" FontSize="12" Foreground="{DynamicResource Gray400Brush}" HorizontalAlignment="Center" Margin="0,45,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL: POLÍTICA DE PRIVACIDAD -->
        <Grid Visibility="{Binding ShowPrivacyPolicy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" Panel.ZIndex="100">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePrivacyPolicyCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource WhitePrimaryBrush}" MaxWidth="650" MaxHeight="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,35">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="30" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Privacy Policy" FontSize="20" FontWeight="Bold"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePrivacyPolicyCommand}"/>
                            </Border.InputBindings>
                            <Viewbox Width="14" Height="14">
                                <Path Data="M18 6L6 18M6 6L18 18" Stroke="{DynamicResource Gray500Brush}" StrokeThickness="2.5"/>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="1. Information We Collect" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="We collect information you provide directly, such as your name, email, and payment data when you make a purchase." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="2. Use of Information" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="We use your information to process orders, improve our services, and send you account-related communications." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="3. Data Protection" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="We implement technical and organizational security measures to protect your personal data." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="4. Your Rights" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="You have the right to access, rectify, or delete your personal data at any time from your account settings." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="5. Contact" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="For any privacy inquiries, contact us at privacy@holocrew.com" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="GOT IT" Style="{StaticResource PrimaryButton}" Padding="40,14" HorizontalAlignment="Right" Margin="0,20,0,0" Command="{Binding ClosePrivacyPolicyCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: TÉRMINOS DE SERVICIO -->
        <Grid Visibility="{Binding ShowTermsOfService, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" Panel.ZIndex="100">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseTermsOfServiceCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource WhitePrimaryBrush}" MaxWidth="650" MaxHeight="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,35">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="30" ShadowDepth="5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Terms of Service" FontSize="20" FontWeight="Bold"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseTermsOfServiceCommand}"/>
                            </Border.InputBindings>
                            <Viewbox Width="14" Height="14">
                                <Path Data="M18 6L6 18M6 6L18 18" Stroke="{DynamicResource Gray500Brush}" StrokeThickness="2.5"/>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="1. Acceptance of Terms" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="By using HoloCrew, you accept these terms of service. If you disagree, do not use our services." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="2. Use of Service" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="You agree to use our service legally and respectfully. Fraudulent use is not permitted." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="3. Purchases and Payments" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="All prices are in euros and include applicable taxes. Payments are processed securely." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="4. Returns" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="We accept returns within 30 days of purchase, provided the product is in its original condition." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="5. Intellectual Property" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="All HoloCrew content is protected by copyright." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,20"/>
                            <TextBlock Text="6. Contact" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="For legal inquiries, write to us at legal@holocrew.com" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Gray600Brush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="GOT IT" Style="{StaticResource PrimaryButton}" Padding="40,14" HorizontalAlignment="Right" Margin="0,20,0,0" Command="{Binding CloseTermsOfServiceCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL: CONTACTO CON SOPORTE -->
        <Grid Visibility="{Binding ShowContactSupport, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" Panel.ZIndex="100">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseContactSupportCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="{DynamicResource WhitePrimaryBrush}" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,35">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="30" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="Contact Support" FontSize="20" FontWeight="Bold"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseContactSupportCommand}"/>
                            </Border.InputBindings>
                            <Viewbox Width="14" Height="14">
                                <Path Data="M18 6L6 18M6 6L18 18" Stroke="{DynamicResource Gray500Brush}" StrokeThickness="2.5"/>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <TextBlock Text="Need help? We're here for you." FontSize="14" Foreground="{DynamicResource Gray600Brush}" Margin="0,0,0,25"/>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,15">
                        <Grid>
                            <TextBlock Text="Email" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="support@holocrew.com" FontSize="14" Foreground="{DynamicResource Gray600Brush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="0,0,0,1" Padding="0,15">
                        <Grid>
                            <TextBlock Text="Phone" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="+34 900 123 456" FontSize="14" Foreground="{DynamicResource Gray600Brush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border Padding="0,15">
                        <Grid>
                            <TextBlock Text="Business hours" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Mon-Fri, 9:00 - 18:00" FontSize="14" Foreground="{DynamicResource Gray600Brush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Button Content="CLOSE" Style="{StaticResource OutlineButton}" Padding="40,14" HorizontalAlignment="Right" Margin="0,20,0,0" Command="{Binding CloseContactSupportCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>