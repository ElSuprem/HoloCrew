<UserControl x:Class="HoloCrew.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Border Padding="60,40,60,80">
        <StackPanel MaxWidth="900">
            <!-- Header -->
            <TextBlock Text="SETTINGS" 
                           Style="{StaticResource HeadingLarge}"
                           Margin="0,0,0,40" />

            <!-- ============================================
                     ACCOUNT SETTINGS
                     ============================================ -->
            <TextBlock Text="ACCOUNT" 
                           Style="{StaticResource HeadingMedium}"
                           Margin="0,0,0,20" />

            <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40"
                        Margin="0,0,0,40">
                <StackPanel>
                    <!-- Language & Currency -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LANGUAGE" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          Height="50"
                                          Padding="15,0"
                                          FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CURRENCY" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Currencies}"
                                          SelectedItem="{Binding SelectedCurrency}"
                                          Height="50"
                                          Padding="15,0"
                                          FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- Timezone -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="TIMEZONE" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding TimeZones}"
                                      SelectedItem="{Binding SelectedTimeZone}"
                                      Height="50"
                                      Padding="15,0"
                                      FontSize="14"/>
                    </StackPanel>

                    <!-- Save Button -->
                    <Button Content="SAVE PREFERENCES" 
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePreferencesCommand}"
                                Width="200"
                                HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- ============================================
                     DISPLAY SETTINGS
                     ============================================ -->
            <TextBlock Text="DISPLAY" 
                           Style="{StaticResource HeadingMedium}"
                           Margin="0,0,0,20" />

            <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40"
                        Margin="0,0,0,40">
                <StackPanel>
                    <!-- Theme -->
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="THEME" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                            <RadioButton Content="Light"
                                             GroupName="Theme"
                                             IsChecked="{Binding IsLightThemeSelected}"
                                             FontSize="14"
                                             Margin="0,0,20,0"
                                             VerticalAlignment="Center"/>

                            <RadioButton Content="Dark"
                                             GroupName="Theme"
                                             IsChecked="{Binding IsDarkThemeSelected}"
                                             FontSize="14"
                                             VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Font Size -->
                    <Grid>
                        <TextBlock Text="FONT SIZE" 
                                       Style="{StaticResource BodyMedium}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        <ComboBox ItemsSource="{Binding FontSizes}"
                                      SelectedItem="{Binding SelectedFontSize}"
                                      Width="200"
                                      Height="50"
                                      Padding="15,0"
                                      FontSize="14"
                                      HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================
                     NOTIFICATIONS SETTINGS
                     ============================================ -->
            <TextBlock Text="NOTIFICATIONS" 
                           Style="{StaticResource HeadingMedium}"
                           Margin="0,0,0,20" />

            <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40"
                        Margin="0,0,0,40">
                <StackPanel>
                    <!-- Email Notifications -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Email Notifications" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Receive updates about orders and promotions" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding EmailNotificationsEnabled}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Push Notifications -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Push Notifications" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Get notified about order status changes" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding PushNotificationsEnabled}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- SMS Notifications -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SMS Notifications" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Receive delivery updates via SMS" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding SmsNotificationsEnabled}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================
                     PRIVACY SETTINGS
                     ============================================ -->
            <TextBlock Text="PRIVACY" 
                           Style="{StaticResource HeadingMedium}"
                           Margin="0,0,0,20" />

            <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40"
                        Margin="0,0,0,40">
                <StackPanel>
                    <!-- Share Usage Data -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Share Usage Data" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Help improve the app by sharing anonymous usage data" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding ShareUsageData}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Save Search History -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Save Search History" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Keep track of your searches for easier shopping" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding SaveSearchHistory}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Public Profile -->
                    <Grid Margin="0,0,0,30">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Public Profile" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Make your profile visible to other users" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding ShowPublicProfile}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Download Data Button -->
                    <Button Content="DOWNLOAD MY DATA" 
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding DownloadDataCommand}"
                                Width="220"
                                HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ============================================
                     ADVANCED SETTINGS
                     ============================================ -->
            <TextBlock Text="ADVANCED" 
                           Style="{StaticResource HeadingMedium}"
                           Margin="0,0,0,20" />

            <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="40">
                <StackPanel>
                    <!-- Clear Cache -->
                    <Grid Margin="0,0,0,30">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Application Cache" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                            <TextBlock Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}">
                                    <Run Text="Current size:"/>
                                    <Run Text="{Binding CacheSize}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Content="CLEAR CACHE" 
                                    Style="{StaticResource OutlineButton}"
                                    FontSize="13"
                                    Padding="20,12"
                                    Command="{Binding ClearCacheCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" 
                                Background="{StaticResource BorderDefault}"
                                Margin="0,0,0,30"/>

                    <!-- Delete Account -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Delete Account" 
                                           Style="{StaticResource BodyMedium}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrorColorBrush}"
                                           Margin="0,0,0,5"/>
                            <TextBlock Text="Permanently delete your account and all associated data" 
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <Button Content="DELETE ACCOUNT" 
                                    Background="Transparent"
                                    BorderBrush="{StaticResource ErrorColorBrush}"
                                    BorderThickness="2"
                                    Foreground="{StaticResource ErrorColorBrush}"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Padding="20,12"
                                    Cursor="Hand"
                                    Command="{Binding DeleteAccountCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorColorBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WhitePrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
