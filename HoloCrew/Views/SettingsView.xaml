<UserControl x:Class="HoloCrew.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock Text="Configuración" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,30" />

            <!-- Configuración de cuenta -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30"
                    Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Cuenta" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Idioma -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Idioma" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Padding="12,10"
                                      FontSize="14"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1" />
                        </StackPanel>

                        <!-- Moneda -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Moneda" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding SelectedCurrency}"
                                      Padding="12,10"
                                      FontSize="14"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Zona horaria -->
                    <TextBlock Text="Zona horaria" 
                               FontWeight="SemiBold" 
                               Margin="0,20,0,8" />
                    <ComboBox ItemsSource="{Binding TimeZones}"
                              SelectedItem="{Binding SelectedTimeZone}"
                              Padding="12,10"
                              FontSize="14"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              Margin="0,0,0,30" />

                    <Button Content="Guardar preferencias" 
                            Command="{Binding SavePreferencesCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Configuración de visualización -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30"
                    Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Visualización" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <!-- Tema -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Tema" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Width="150" />

                        <RadioButton Content="Claro"
                                     GroupName="Theme"
                                     IsChecked="{Binding IsLightThemeSelected}"
                                     FontSize="14"
                                     Margin="0,0,20,0"
                                     VerticalAlignment="Center" />

                        <RadioButton Content="Oscuro"
                                     GroupName="Theme"
                                     IsChecked="{Binding IsDarkThemeSelected}"
                                     FontSize="14"
                                     VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Tamaño de fuente -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Tamaño de texto" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Width="150" />

                        <ComboBox ItemsSource="{Binding FontSizes}"
                                  SelectedItem="{Binding SelectedFontSize}"
                                  Width="200"
                                  Padding="12,8"
                                  FontSize="14"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1" />
                    </StackPanel>

                    <!-- Animaciones -->
                    <CheckBox Content="Habilitar animaciones"
                              IsChecked="{Binding EnableAnimations}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Margin="0,0,0,30" />

                    <Button Content="Aplicar cambios" 
                            Command="{Binding ApplyDisplaySettingsCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Configuración de privacidad -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30"
                    Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Privacidad" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <CheckBox Content="Compartir datos de uso anónimos para mejorar la aplicación"
                              IsChecked="{Binding ShareUsageData}"
                              FontSize="14"
                              Margin="0,0,0,15" />

                    <CheckBox Content="Guardar historial de búsqueda"
                              IsChecked="{Binding SaveSearchHistory}"
                              FontSize="14"
                              Margin="0,0,0,15" />

                    <CheckBox Content="Mostrar perfil público"
                              IsChecked="{Binding ShowPublicProfile}"
                              FontSize="14"
                              Margin="0,0,0,30" />

                    <Button Content="Descargar mis datos" 
                            Command="{Binding DownloadDataCommand}"
                            Padding="15,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            Foreground="#1976D2"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Configuración avanzada -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="30">
                <StackPanel>
                    <TextBlock Text="Avanzado" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <!-- Limpiar caché -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Caché de la aplicación" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Width="200" />

                        <TextBlock Text="{Binding CacheSize}" 
                                   FontSize="14"
                                   Foreground="#666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0" />

                        <Button Content="Limpiar caché" 
                                Command="{Binding ClearCacheCommand}"
                                Padding="15,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="#1976D2"
                                BorderBrush="#1976D2"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Exportar datos -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Exportar datos" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Width="200" />

                        <Button Content="Exportar a JSON" 
                                Command="{Binding ExportDataCommand}"
                                Padding="15,8"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                Foreground="#1976D2"
                                BorderBrush="#1976D2"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Versión de la app -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Versión" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Width="200" />

                        <TextBlock Text="{Binding AppVersion}" 
                                   FontSize="14"
                                   Foreground="#666"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Mensaje de éxito -->
            <Border Visibility="{Binding ShowSuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#E8F5E9"
                    BorderBrush="#C8E6C9"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,30,0,0">
                <TextBlock Text="{Binding SuccessMessage}" 
                           FontSize="14"
                           Foreground="#2E7D32"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Loading -->
            <Grid Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"
                  Height="200"
                  VerticalAlignment="Center"
                  Margin="0,30,0,0">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Guardando configuración..." 
                               FontSize="16" 
                               Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>