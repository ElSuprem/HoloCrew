<UserControl x:Class="HoloCrew.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="60,40,60,80">
            <StackPanel MaxWidth="900">

                <!-- HEADER -->
                <TextBlock Text="CONFIGURACIÓN" 
                           FontSize="42"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Personaliza tu experiencia en HoloCrew" 
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,40"/>

                <!-- ========== SECCIÓN: PERFIL ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="👤 PERFIL" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- User Info -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0"
                                    Width="60" Height="60"
                                    Background="{StaticResource Gray200Brush}"
                                    CornerRadius="30"
                                    Margin="0,0,20,0">
                                <TextBlock Text="👨" 
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" 
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CurrentUserEmail}" 
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Button -->
                            <Button Grid.Column="2"
                                    Content="Ver perfil"
                                    Command="{Binding NavigateToProfileCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Height="40"
                                    Padding="20,0"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== SECCIÓN: APARIENCIA ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🎨 APARIENCIA" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- Tema -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modo oscuro" 
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Reduce el brillo de la pantalla" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsDarkMode}"
                                      Command="{Binding ToggleDarkModeCommand}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Idioma -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Idioma" 
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Selecciona tu idioma preferido" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      Width="150"
                                      Height="40"
                                      VerticalAlignment="Center"
                                      FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== SECCIÓN: NOTIFICACIONES ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔔 NOTIFICACIONES" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- Notificaciones generales -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Activar notificaciones" 
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Recibe actualizaciones importantes" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding NotificationsEnabled}"
                                      Command="{Binding ToggleNotificationsCommand}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderDefault}" Margin="0,10,0,15"/>

                        <!-- Email notifications -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Notificaciones por email"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding EmailNotifications}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Push notifications -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Notificaciones push"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding PushNotifications}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Order updates -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Actualizaciones de pedidos"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding OrderUpdates}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Promotional emails -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Emails promocionales y ofertas"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding PromotionalEmails}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== SECCIÓN: PRIVACIDAD ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🔒 PRIVACIDAD Y SEGURIDAD" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- Data collection -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recopilación de datos" 
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Ayúdanos a mejorar tu experiencia" 
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding DataCollectionEnabled}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderDefault}" Margin="0,10,0,15"/>

                        <!-- Personalized ads -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Anuncios personalizados"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding PersonalizedAds}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Share with partners -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Compartir datos con socios"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding ShareDataWithPartners}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Links -->
                        <StackPanel>
                            <Button Content="📄 Política de privacidad"
                                    Command="{Binding ViewPrivacyPolicyCommand}"
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"/>
                            <Button Content="📄 Términos de servicio"
                                    Command="{Binding ViewTermsOfServiceCommand}"
                                    Style="{StaticResource TextButton}"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========== SECCIÓN: CUENTA ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30"
                        Margin="0,0,0,20"
                        Visibility="{Binding IsUserLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="👤 CUENTA" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- Change password -->
                        <Button Content="🔒 Cambiar contraseña"
                                Command="{Binding ChangePasswordCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="45"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"/>

                        <!-- Export data -->
                        <Button Content="📥 Exportar mis datos"
                                Command="{Binding ExportDataCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="45"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"/>

                        <!-- Logout -->
                        <Button Content="👋 Cerrar sesión"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="45"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,20"/>

                        <Border Height="1" Background="{StaticResource BorderDefault}" Margin="0,10,0,20"/>

                        <!-- Delete account -->
                        <Button Content="⚠️ Eliminar cuenta"
                                Command="{Binding DeleteAccountCommand}"
                                Height="45"
                                HorizontalAlignment="Stretch"
                                Background="#FEE"
                                BorderBrush="#F88"
                                BorderThickness="1"
                                Foreground="#C00"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- ========== SECCIÓN: OTROS ========== -->
                <Border Background="{StaticResource WhitePrimaryBrush}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        Padding="30">
                    <StackPanel>
                        <TextBlock Text="⚙️ OTROS" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <!-- Clear cache -->
                        <Button Content="🗑️ Limpiar caché"
                                Command="{Binding ClearCacheCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="45"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"/>

                        <!-- Contact support -->
                        <Button Content="💬 Contactar soporte"
                                Command="{Binding ContactSupportCommand}"
                                Style="{StaticResource OutlineButton}"
                                Height="45"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- VERSION -->
                <TextBlock Text="HoloCrew v1.0.0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
