<UserControl x:Class="HoloCrew.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:HoloCrew.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <!-- Cabecera -->
            <Grid Margin="0,0,0,30">
                <TextBlock Text="{Binding OrderNumber, StringFormat='Pedido #{0}'}" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center" />

                <Button Content="← Volver al historial" 
                        Command="{Binding BackToHistoryCommand}"
                        Padding="15,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        Foreground="#1976D2"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Información del pedido -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Detalles -->
                    <ColumnDefinition Width="*" />
                    <!-- Seguimiento -->
                </Grid.ColumnDefinitions>

                <!-- Detalles del pedido -->
                <StackPanel Grid.Column="0" 
                            Margin="0,0,20,0">
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="30">
                        <StackPanel>
                            <TextBlock Text="Detalles del pedido" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,20" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Fecha" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                               FontSize="14"
                                               Foreground="#666"
                                               Margin="0,0,0,15" />

                                    <TextBlock Text="Estado" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5" />
                                    <Border Background="{Binding StatusColor}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,15">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Método de pago" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding PaymentMethod}" 
                                               FontSize="14"
                                               Foreground="#666"
                                               Margin="0,0,0,15" />

                                    <TextBlock Text="Dirección de envío" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="{Binding ShippingAddress}" 
                                               FontSize="14"
                                               Foreground="#666"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Productos del pedido -->
                    <TextBlock Text="Productos" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Margin="0,30,0,20" />

                    <ItemsControl ItemsSource="{Binding OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,10"
                                        Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Imagen -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Detalles -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Precio -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Imagen -->
                                        <Border Grid.Column="0" 
                                                Background="#F5F5F5"
                                                CornerRadius="4"
                                                Width="80"
                                                Height="80"
                                                Margin="0,0,20,0">
                                            <TextBlock Text="📷" 
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#CCC" />
                                        </Border>

                                        <!-- Detalles -->
                                        <StackPanel Grid.Column="1" 
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" 
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding VariantDescription}" 
                                                       FontSize="14"
                                                       Foreground="#666"
                                                       Margin="0,0,0,5" />
                                            <!-- CORREGIDO: Línea 185 -->
                                            <TextBlock Text="{Binding Quantity, StringFormat='Cantidad: {0}'}" 
                                                       FontSize="14"
                                                       Foreground="#666" />
                                        </StackPanel>

                                        <!-- Precio -->
                                        <StackPanel Grid.Column="2" 
                                                    VerticalAlignment="Center">
                                            <!-- CORREGIDO: Línea 193 -->
                                            <TextBlock Text="{Binding TotalPrice, StringFormat='€{0:N2}'}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1976D2" />
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='€{0:N2} c/u'}"
                                                       FontSize="13"
                                                       Foreground="#666"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Seguimiento y total -->
                <StackPanel Grid.Column="1" 
                            Margin="20,0,0,0">
                    <!-- Seguimiento -->
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="30"
                            Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="Seguimiento del envío" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,20" />

                            <ItemsControl ItemsSource="{Binding TrackingEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Punto -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding IsCurrent, Converter={StaticResource StatusToColorConverter}}"
                                                    Width="16"
                                                    Height="16"
                                                    CornerRadius="8"
                                                    Margin="0,0,15,0"
                                                    VerticalAlignment="Top" />

                                            <!-- Detalles -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Status}" 
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" 
                                                           FontSize="13"
                                                           Foreground="#666"
                                                           Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                                           FontSize="12"
                                                           Foreground="#999"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Información de seguimiento -->
                            <Border Background="#F8F9FA"
                                    CornerRadius="8"
                                    Padding="15"
                                    Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Número de seguimiento" 
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding TrackingNumber}" 
                                               FontSize="16"
                                               FontFamily="Courier New"
                                               Foreground="#1976D2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Resumen del total -->
                    <Border Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="30">
                        <StackPanel>
                            <TextBlock Text="Resumen del total" 
                                       FontSize="20" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,20" />

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Subtotal" 
                                               FontSize="14"
                                               Foreground="#666"
                                               Width="200" />
                                    <TextBlock Text="{Binding Subtotal, StringFormat='€{0:N2}'}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Envío" 
                                               FontSize="14"
                                               Foreground="#666"
                                               Width="200" />
                                    <TextBlock Text="{Binding ShippingCost, StringFormat='€{0:N2}'}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Descuento" 
                                               FontSize="14"
                                               Foreground="#4CAF50"
                                               Width="200" />
                                    <TextBlock Text="{Binding DiscountAmount, StringFormat='-€{0:N2}'}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#4CAF50"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <Border Height="1" 
                                        Background="#E0E0E0"
                                        Margin="0,10,0,10" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total" 
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Width="200" />
                                    <TextBlock Text="{Binding Total, StringFormat='€{0:N2}'}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1976D2"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Botones de acción -->
                            <StackPanel Orientation="Horizontal" 
                                        Margin="0,30,0,0">
                                <Button Content="Descargar factura" 
                                        Command="{Binding DownloadInvoiceCommand}"
                                        Padding="15,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="Transparent"
                                        Foreground="#1976D2"
                                        BorderBrush="#1976D2"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Margin="0,0,10,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Volver a pedir" 
                                        Command="{Binding ReorderCommand}"
                                        Padding="15,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="#1976D2"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#115293" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Loading -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Height="200"
                  VerticalAlignment="Center"
                  Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Cargando detalles del pedido..." 
                               FontSize="16" 
                               Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>