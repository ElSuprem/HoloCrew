<UserControl x:Class="HoloCrew.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Border Padding="60,40,60,80">
        <StackPanel>
            <Grid Margin="0,0,0,40">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeadingLarge}">
                        <Run Text="ORDER #"/>
                        <Run Text="{Binding OrderNumber}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding OrderDate, StringFormat='MMMM dd, yyyy'}"
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Button Content="← BACK TO ORDERS" 
                        Style="{StaticResource OutlineButton}"
                        FontSize="13"
                        Padding="20,12"
                        Command="{Binding BackToHistoryCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ORDER ITEMS" Style="{StaticResource HeadingMedium}" Margin="0,0,0,25"/>

                    <ItemsControl ItemsSource="{Binding OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WhitePrimaryBrush}"
                                        BorderBrush="{DynamicResource Gray200Brush}"
                                        BorderThickness="1"
                                        Padding="25"
                                        Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource Gray100Brush}" Width="80" Height="80" Margin="0,0,20,0" ClipToBounds="True">
                                            <controls:AsyncImage Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,5"/>
                                            <TextBlock FontSize="13" Foreground="{DynamicResource Gray500Brush}">
                                                <Run Text="Size: "/><Run Text="{Binding Size}"/>
                                                <Run Text=" • Color: "/><Run Text="{Binding Color}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="13" Foreground="{DynamicResource Gray500Brush}" Margin="0,5,0,0">
                                                <Run Text="Qty: "/><Run Text="{Binding Quantity}"/>
                                                <Run Text=" × €"/><Run Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N2}€'}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="DELIVERY &amp; PAYMENT" Style="{StaticResource HeadingMedium}" Margin="0,40,0,25"/>

                    <Border Background="{DynamicResource WhitePrimaryBrush}" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SHIPPING ADDRESS" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding ShippingAddress}" FontSize="14" Foreground="{DynamicResource Gray600Brush}" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PAYMENT METHOD" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding PaymentMethod}" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border Background="{DynamicResource BlackPrimaryBrush}" Padding="30,25" Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="ORDER STATUS" FontWeight="SemiBold" FontSize="14" Foreground="White" Margin="0,0,0,15"/>
                            <Border Background="{Binding StatusColor}" Padding="15,10" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding EstimatedDelivery, StringFormat='Estimated delivery: MMM dd'}" FontSize="12" Foreground="{DynamicResource Gray400Brush}" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource WhitePrimaryBrush}" BorderBrush="{DynamicResource Gray200Brush}" BorderThickness="1" Padding="30" Margin="0,0,0,30">
                        <StackPanel>
                            <TextBlock Text="TRACKING" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>

                            <ItemsControl ItemsSource="{Binding TrackingHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,2,15,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding EventTitle}" FontWeight="SemiBold" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Gray400Brush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Gray400Brush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Pending"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding EventDate, StringFormat='MMM dd, HH:mm'}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Gray100Brush}" Padding="30">
                        <StackPanel>
                            <TextBlock Text="ORDER SUMMARY" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Subtotal" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:N2}€'}" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Shipping" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ShippingCost, StringFormat='{}{0:N2}€'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShippingCost}" Value="0">
                                                    <Setter Property="Text" Value="FREE"/>
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,0,0,12" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Discount" FontSize="14" Foreground="#4CAF50"/>
                                <TextBlock Text="{Binding DiscountAmount, StringFormat='-€{0:N2}'}" FontSize="14" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Gray300Brush}" Margin="0,10,0,20"/>

                            <Grid>
                                <TextBlock Text="TOTAL" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Total, StringFormat='{}{0:N2}€'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,30,0,0">
                        <Button Content="TRACK PACKAGE" Style="{StaticResource PrimaryButton}" Command="{Binding TrackPackageCommand}" Margin="0,0,0,15"/>
                        <Button Content="CONTACT SUPPORT" Style="{StaticResource OutlineButton}" Command="{Binding ContactSupportCommand}" Margin="0,0,0,15"/>

                        <Button Content="CANCEL ORDER"
                                Command="{Binding CancelOrderCommand}"
                                Visibility="{Binding CanBeCancelled, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="Transparent"
                                BorderBrush="#F44336"
                                BorderThickness="2"
                                Foreground="#F44336"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="20,14"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>