<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <!-- Vista del carrito de compras.
         Muestra los productos añadidos, permite cambiar cantidades, quitar productos,
         aplicar cupones, y ver el resumen del pedido (subtotal, envío, IVA, total).
         Se conecta con CartViewModel. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- lista de productos del carrito -->
        <Border Grid.Column="0" Padding="70,50,40,80">
            <StackPanel>
                <!-- título -->
                <TextBlock Text="YOUR CART" 
                           FontSize="32"
                           FontWeight="Black"
                           Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource Gray500Brush}" FontSize="14" Margin="0,0,0,40">
                    <Run Text="{Binding CartItems.Count, Mode=OneWay}"/>
                    <Run Text=" items in your cart"/>
                </TextBlock>

                <!-- estado vacío -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCartEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Viewbox Width="64" Height="64" Margin="0,0,0,25" Opacity="0.3">
                        <Path Data="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6ZM3 6H21M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" 
                              Stroke="{DynamicResource BlackPrimaryBrush}" StrokeThickness="2" Fill="Transparent"/>
                    </Viewbox>
                    <TextBlock Text="Your cart is empty" 
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Browse our collection and add items to your cart" 
                               FontSize="14" Foreground="{DynamicResource Gray500Brush}"
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Content="BROWSE PRODUCTS" 
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseProductsCommand}"
                            Padding="40,15"/>
                </StackPanel>

                <!-- lista de productos -->
                <ItemsControl ItemsSource="{Binding CartItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WhitePrimaryBrush}"
                                    BorderBrush="{DynamicResource Gray200Brush}"
                                    BorderThickness="1"
                                    Padding="25"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- imagen del producto -->
                                    <Border Grid.Column="0" 
                                            Background="{DynamicResource Gray100Brush}" 
                                            Width="110" Height="110"
                                            ClipToBounds="True">
                                        <controls:AsyncImage Source="{Binding ImageUrl}"
                                                             Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- información del producto -->
                                    <StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" 
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Size: " Foreground="{DynamicResource Gray500Brush}" FontSize="13"/>
                                            <TextBlock Text="{Binding Size}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="  ·  Color: " Foreground="{DynamicResource Gray500Brush}" FontSize="13"/>
                                            <TextBlock Text="{Binding Color}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" 
                                                   FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- cantidad y botón eliminar -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="40" Height="40" Cursor="Hand"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Gray300Brush}">
                                                                <TextBlock Text="−" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BlackPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding Quantity}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BlackPrimaryBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Width="50" TextAlignment="Center"/>
                                                <Button Width="40" Height="40" Cursor="Hand"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Gray300Brush}">
                                                                <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BlackPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Remove" FontSize="13" Foreground="{DynamicResource RedAccentBrush}" 
                                                   HorizontalAlignment="Center" Cursor="Hand" TextDecorations="Underline">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" MouseAction="LeftClick"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- resumen del pedido (sidebar) -->
        <Border Grid.Column="1" Background="{DynamicResource Gray50Brush}">
            <Border Padding="35,50,35,80">
                <StackPanel>
                    <TextBlock Text="ORDER SUMMARY" FontSize="20" FontWeight="Black" Margin="0,0,0,30"/>

                    <!-- subtotal -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Subtotal" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='{}{0:N2}€'}" FontSize="14" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- envío -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Shipping" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ShippingCost, StringFormat='{}{0:N2}€'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShippingCost}" Value="0">
                                            <Setter Property="Text" Value="FREE"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- impuestos (IVA 21%) -->
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Tax (21%)" FontSize="14" Foreground="{DynamicResource Gray600Brush}"/>
                        <TextBlock Text="{Binding Tax, StringFormat='{}{0:N2}€'}" FontSize="14" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- descuento -->
                    <Grid Margin="0,0,0,15" Visibility="{Binding Discount, Converter={StaticResource CountToVisibilityConverter}}">
                        <TextBlock Text="Discount" FontSize="14" Foreground="#10B981"/>
                        <TextBlock Text="{Binding Discount, StringFormat='-{0:N2}€'}" FontSize="14" Foreground="#10B981" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- total -->
                    <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,25">
                        <Grid>
                            <TextBlock Text="TOTAL" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="{Binding Total, StringFormat='{}{0:N2}€'}" FontSize="20" FontWeight="Black" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- cupón de descuento -->
                    <TextBlock Text="Have a coupon?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="46">
                            <Grid>
                                <TextBox Text="{Binding CouponCode, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="14" VerticalContentAlignment="Center"
                                         Padding="15,0,100,0"/>
                                <TextBlock Text="Enter code" Foreground="{DynamicResource Gray400Brush}" FontSize="14"
                                           VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CouponCode}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CouponCode}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="APPLY" Style="{StaticResource PrimaryButton}"
                                        FontSize="12" FontWeight="Bold"
                                        Padding="20,0" Height="36"
                                        HorizontalAlignment="Right" Margin="5"
                                        Command="{Binding ApplyCouponCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- mensaje del cupón -->
                    <TextBlock Text="{Binding CouponMessage}" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Gray500Brush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCouponValid}" Value="True">
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCouponValid}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource RedAccentBrush}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- banner de envío gratis -->
                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" Padding="15" Margin="0,0,0,25">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShippingCost}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="You qualify for FREE shipping!" FontSize="13" Foreground="#059669" FontWeight="SemiBold" TextAlignment="Center"/>
                    </Border>

                    <!-- botones -->
                    <Button Content="PROCEED TO CHECKOUT" 
                            Style="{StaticResource PrimaryButton}"
                            Padding="0,18" Margin="0,0,0,12"
                            Command="{Binding CheckoutCommandCommand}"
                            IsEnabled="{Binding CanCheckout}"/>
                    <Button Content="CONTINUE SHOPPING" 
                            Style="{StaticResource OutlineButton}"
                            Padding="0,18"
                            Command="{Binding BrowseProductsCommand}"/>

                    <!-- métodos de pago aceptados -->
                    <StackPanel Margin="0,25,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="Secure checkout with" FontSize="11" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource Gray100Brush}" Padding="10,5" Margin="0,0,5,0">
                                <TextBlock Text="VISA" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Border Background="{DynamicResource Gray100Brush}" Padding="10,5" Margin="0,0,5,0">
                                <TextBlock Text="MASTERCARD" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Border Background="{DynamicResource Gray100Brush}" Padding="10,5" Margin="0,0,5,0">
                                <TextBlock Text="PAYPAL" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Border Background="{DynamicResource Gray100Brush}" Padding="10,5">
                                <TextBlock Text="AMEX" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</UserControl>