<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <!-- Vista de registro de usuario.
         Formulario a la izquierda con nombre, email, contraseña, términos.
         Panel derecho con beneficios del club de miembros.
         Se conecta con RegisterViewModel. -->

    <Border Padding="40,30,40,60">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="550"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- formulario de registro -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WhitePrimaryBrush}"
                    BorderBrush="{DynamicResource Gray200Brush}"
                    BorderThickness="1"
                    Padding="50,40">
                <StackPanel>

                    <TextBlock Text="HOLOCREW" 
                               FontSize="20" 
                               FontWeight="Black" 
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="JOIN THE CLUB" 
                               FontSize="26"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,30" FontSize="14">
                        <Run Text="Create your account and get " Foreground="{DynamicResource Gray500Brush}"/>
                        <Run Text="200 FREE CREDITS" FontWeight="Bold" Foreground="#3B82F6"/>
                    </TextBlock>

                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,20"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyCollectionToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="#DC2626"
                                   TextWrapping="Wrap"
                                   FontSize="13"/>
                    </Border>

                    <!-- nombre completo -->
                    <TextBlock Text="Full Name" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48" Margin="0,0,0,18">
                        <Grid>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <Path Data="M20 21V19C20 16.7909 18.2091 15 16 15H8C5.79086 15 4 16.7909 4 19V21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" 
                                      Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="42,0,15,0" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" FontSize="14"/>
                            <TextBlock Text="John Doe" Foreground="{DynamicResource Gray400Brush}" FontSize="14" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FullName}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FullName}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- email -->
                    <TextBlock Text="Email Address" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48" Margin="0,0,0,18">
                        <Grid>
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                <Path Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6" 
                                      Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                            </Viewbox>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="42,0,15,0" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" FontSize="14"/>
                            <TextBlock Text="john@example.com" Foreground="{DynamicResource Gray400Brush}" FontSize="14" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Email}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Email}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- contraseña y confirmación -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48">
                                <Grid>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                        <Path Data="M19 11H5V21H19V11ZM17 11V7C17 4.24 14.76 2 12 2C9.24 2 7 4.24 7 7V11" 
                                              Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    </Viewbox>
                                    <PasswordBox x:Name="PasswordBox"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 BorderThickness="0" Padding="42,0,10,0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 FontSize="14"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Confirm Password" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Height="48">
                                <Grid>
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="14,0,0,0">
                                        <Path Data="M19 11H5V21H19V11ZM17 11V7C17 4.24 14.76 2 12 2C9.24 2 7 4.24 7 7V11" 
                                              Stroke="{DynamicResource Gray400Brush}" StrokeThickness="1.5" Fill="Transparent"/>
                                    </Viewbox>
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                                 BorderThickness="0" Padding="42,0,10,0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 FontSize="14"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Minimum 6 characters" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="0,0,0,20"/>

                    <CheckBox IsChecked="{Binding AcceptTerms}" Margin="0,0,0,25" Cursor="Hand">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run Text="I agree to the "/>
                            <Run Text="Terms &amp; Conditions" FontWeight="SemiBold" TextDecorations="Underline"/>
                            <Run Text=" and "/>
                            <Run Text="Privacy Policy" FontWeight="SemiBold" TextDecorations="Underline"/>
                        </TextBlock>
                    </CheckBox>

                    <Button Command="{Binding RegisterCommand}"
                            Height="52"
                            Cursor="Hand"
                            Margin="0,0,0,25">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="CREATE ACCOUNT  →" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Button>

                    <TextBlock HorizontalAlignment="Center" FontSize="14">
                        <Run Text="Already have an account? " Foreground="{DynamicResource Gray500Brush}"/>
                        <Hyperlink Command="{Binding NavigateToLoginCommand}"
                                   TextDecorations="None"
                                   Foreground="{DynamicResource BlackPrimaryBrush}"
                                   FontWeight="Bold">
                            <Run Text="Sign in here"/>
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- panel de beneficios (siempre oscuro) -->
            <Border Grid.Column="2"
                    Background="#0A0A0A"
                    Padding="40,40">
                <StackPanel>

                    <TextBlock Text="MEMBER BENEFITS" 
                               FontSize="28" 
                               FontWeight="Black" 
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Join our exclusive community and enjoy premium benefits" 
                               FontSize="14" 
                               Foreground="{DynamicResource Gray400Brush}"
                               Margin="0,0,0,35"
                               TextWrapping="Wrap"/>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#10B981" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="200 welcome credits" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Available immediately after registration" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="32,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#10B981" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Early access to launches" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Available immediately after registration" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="32,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#10B981" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Free shipping on orders +50€" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Available immediately after registration" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="32,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#10B981" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Exclusive member offers" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Available immediately after registration" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="32,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,35">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#10B981" StrokeThickness="2" Fill="Transparent"/>
                            </Viewbox>
                            <TextBlock Text="Points and rewards program" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Available immediately after registration" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="32,4,0,0"/>
                    </StackPanel>

                    <Border Background="#3B82F6" Padding="30,25" Margin="0,0,0,25">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="200" FontSize="42" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="FREE CREDITS" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Redeemable on your first purchase" FontSize="13" Foreground="#BFDBFE" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3">
                        <Border BorderBrush="{DynamicResource Gray700Brush}" BorderThickness="1" Padding="15,12" Margin="0,0,5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="10K+" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Active Members" FontSize="11" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource Gray700Brush}" BorderThickness="1" Padding="15,12" Margin="0,0,5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="€50K+" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Credits Redeemed" FontSize="11" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource Gray700Brush}" BorderThickness="1" Padding="15,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="24/7" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Support" FontSize="11" Foreground="{DynamicResource Gray500Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>