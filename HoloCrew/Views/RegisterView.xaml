<UserControl x:Class="HoloCrew.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: Ilustración -->
            <Border Grid.Column="0" 
                    Background="#E3F2FD">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="🎉" 
                               FontSize="120"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="Únete a HoloCrew" 
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1976D2"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="Crea tu cuenta para comenzar" 
                               FontSize="16"
                               Foreground="#555"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- DERECHA: Formulario -->
            <Border Grid.Column="1" 
                    Padding="60">
                <StackPanel>
                    <TextBlock Text="Crear Cuenta" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Foreground="#1976D2"
                               Margin="0,0,0,30" />

                    <!-- Campos del formulario -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8" />
                                <TextBox Text="{Binding FirstName}"
                                         Padding="15,12"
                                         FontSize="14"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Apellidos" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8" />
                                <TextBox Text="{Binding LastName}"
                                         Padding="15,12"
                                         FontSize="14"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email" 
                                   FontWeight="SemiBold" 
                                   Margin="0,20,0,8" />
                        <TextBox Text="{Binding Email}"
                                 Padding="15,12"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Margin="0,0,0,20" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Contraseña" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8" />
                                <PasswordBox x:Name="PasswordBox"
                                             Padding="15,12"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Confirmar Contraseña" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8" />
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Padding="15,12"
                                             FontSize="14"
                                             BorderBrush="#E0E0E0"
                                             BorderThickness="1" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Fecha de Nacimiento" 
                                   FontWeight="SemiBold" 
                                   Margin="0,20,0,8" />
                        <DatePicker SelectedDate="{Binding BirthDate}"
                                    Padding="15,12"
                                    FontSize="14"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Margin="0,0,0,20" />

                        <TextBlock Text="Teléfono" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding PhoneNumber}"
                                 Padding="15,12"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Margin="0,0,0,20" />

                        <CheckBox Content="Acepto los términos y condiciones"
                                  IsChecked="{Binding AcceptTerms}"
                                  FontSize="13"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Deseo recibir ofertas y novedades por email"
                                  IsChecked="{Binding SubscribeToNewsletter}"
                                  FontSize="13"
                                  Margin="0,0,0,30" />
                    </StackPanel>

                    <!-- Botón de registro -->
                    <Button Content="Crear Cuenta" 
                            Command="{Binding RegisterCommand}"
                            CommandParameter="{Binding ElementName=PasswordBox, Path=SecurePassword}"
                            Padding="20,15"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,20"
                            IsEnabled="{Binding CanRegister}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BBDEFB" />
                                        <Setter Property="Foreground" Value="#90A4AE" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Enlace a login -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="¿Ya tienes una cuenta?" 
                                   FontSize="13"
                                   Foreground="#666"
                                   Margin="0,0,0,5" />

                        <Button Content="Inicia sesión aquí" 
                                Command="{Binding NavigateToLoginCommand}"
                                Padding="0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#1976D2"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#115293" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Mensaje de error -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                            Background="#FFEBEE"
                            Padding="15"
                            Margin="0,30,0,0">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   FontSize="13"
                                   Foreground="#C62828"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Loading -->
                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                          Height="50"
                          Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="⏳" 
                                       FontSize="24" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5" />
                            <TextBlock Text="Creando cuenta..." 
                                       FontSize="12" 
                                       Foreground="#666" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>