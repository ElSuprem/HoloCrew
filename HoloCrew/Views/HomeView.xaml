<UserControl x:Class="HoloCrew.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Banner Principal -->
            <Border Height="400" 
                    Background="#E3F2FD"
                    Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Texto del Banner -->
                    <StackPanel Grid.Column="0" 
                                VerticalAlignment="Center"
                                Margin="80,0,40,0">
                        <TextBlock Text="Bienvenido a HoloCrew" 
                                   FontSize="48" 
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,20" />
                        <TextBlock Text="Los mejores productos al mejor precio" 
                                   FontSize="24" 
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,30" />
                        <Button Content="Ver Catálogo" 
                                Command="{Binding NavigateToCategoryCommand}"
                                Padding="30,15"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Background="#1976D2"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#115293" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Imagen del Banner -->
                    <Border Grid.Column="1" 
                            Margin="40">
                        <TextBlock Text="🛍️" 
                                   FontSize="200"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.3" />
                    </Border>
                </Grid>
            </Border>

            <!-- Categorías Principales -->
            <StackPanel Margin="80,0,80,60">
                <TextBlock Text="Categorías Populares" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Margin="0,0,0,30" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="10"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#40000000" 
                                                      BlurRadius="10" 
                                                      ShadowDepth="2" 
                                                      Opacity="0.2" />
                                </Border.Effect>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.NavigateToCategoryCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IconUrl, FallbackValue='📦'}" 
                                               FontSize="48"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,15" />
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Productos Destacados -->
            <StackPanel Margin="80,0,80,60">
                <Grid Margin="0,0,0,30">
                    <TextBlock Text="Productos Destacados" 
                               FontSize="32" 
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Button Content="Ver todos ➔" 
                            HorizontalAlignment="Right"
                            Padding="15,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#1976D2"
                            FontSize="14"
                            Cursor="Hand" />
                </Grid>

                <ItemsControl ItemsSource="{Binding FeaturedProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Product Card -->
                            <Border Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Width="260"
                                    Margin="10"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#40000000" 
                                                      BlurRadius="12" 
                                                      ShadowDepth="3" 
                                                      Opacity="0.15" />
                                </Border.Effect>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ViewProductDetailCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Imagen del Producto -->
                                    <Border Grid.Row="0" 
        CornerRadius="12,12,0,0"
        Background="#F5F5F5">
                                        <!-- Usar Grid para tener múltiples elementos -->
                                        <Grid>
                                            <TextBlock Text="📷" 
                   FontSize="64"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#CCC" />

                                            <!-- Badge de Descuento -->
                                            <Border Background="#F44336"
                Padding="8,4"
                CornerRadius="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DiscountPercentage, StringFormat='-{0}%'}"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Información del Producto -->
                                    <StackPanel Grid.Row="1" Margin="15">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#757575"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,12" />

                                        <!-- Rating -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="★" Foreground="#FFC107" FontSize="14" />
                                            <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}"
                                                       FontSize="12"
                                                       Margin="4,0,8,0" />
                                            <TextBlock Text="{Binding ReviewCount, StringFormat='({0})'}"
                                                       FontSize="12"
                                                       Foreground="#999" />
                                        </StackPanel>

                                        <!-- Precio -->
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Price, StringFormat='€{0:N2}'}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="#1976D2" />

                                                <TextBlock Text="{Binding OriginalPrice, StringFormat='€{0:N2}'}"
                                                           FontSize="14"
                                                           Foreground="#999"
                                                           TextDecorations="Strikethrough"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- Botón Añadir -->
                                            <Button Content="+" 
                                                    HorizontalAlignment="Right"
                                                    Width="36"
                                                    Height="36"
                                                    Background="#1976D2"
                                                    Foreground="White"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.AddToCartCommand, 
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="18"
                                                                            Width="{TemplateBinding Width}"
                                                                            Height="{TemplateBinding Height}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#115293" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Loading Indicator -->
            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#80FFFFFF"
                  Height="400">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Cargando..." FontSize="16" Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>