<UserControl x:Class="HoloCrew.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <StackPanel>

        <!-- HERO BANNER - Mejorado con sombra y gradient -->
        <Border Background="{StaticResource BlackSecondaryBrush}" Height="550">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="20" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Rectangle Fill="{StaticResource Gray800Brush}" Opacity="0.3"/>

                <!-- Gradient overlay -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#40000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="RISE WITH THE CREW" 
                               Style="{StaticResource HeroTitle}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,25"/>
                    <TextBlock Text="Discover our premium streetwear collection designed for comfort and style" 
                               Style="{StaticResource SubtitleLarge}"
                               Foreground="{StaticResource WhitePrimaryBrush}"
                               TextAlignment="Center"
                               Opacity="0.9"
                               Margin="0,0,0,50"/>
                    <Button Content="SHOP NOW" 
                            Style="{StaticResource HeroButton}"
                            Command="{Binding NavigateToCatalogCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BENEFICIOS - Más espacio y separadores -->
        <Border Background="{StaticResource WhitePrimaryBrush}" 
                BorderBrush="{StaticResource BorderDefault}" 
                BorderThickness="0,1,0,1"
                Padding="80,45">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="48" TextAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="14 DAYS RETURN POLICY" 
                                   Style="{StaticResource SubtitleMedium}"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Easy returns within 14 days"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="20" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🚚" FontSize="48" TextAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="FREE SHIPPING OVER 50€" 
                                   Style="{StaticResource SubtitleMedium}"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Free delivery on eligible orders"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌍" FontSize="48" TextAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="WORLDWIDE SHIPPING" 
                                   Style="{StaticResource SubtitleMedium}"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="We ship to over 100 countries"
                                   Style="{StaticResource BodySmall}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- FEATURED PRODUCTS - Mejor espaciado -->
        <Border Padding="80,80,80,100">
            <StackPanel>
                <TextBlock Text="FEATURED PRODUCTS" 
                           Style="{StaticResource HeadingLarge}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Handpicked selection from our latest collection" 
                           Style="{StaticResource BodyLarge}"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,60"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Producto 1 -->
                    <Border Grid.Column="0"
                            Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                            <Border Grid.Row="1" Padding="25,20">
                                <StackPanel>
                                    <TextBlock Text="OVERSIZED HOODIE" 
                                               Style="{StaticResource SubtitleMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="59.99€" 
                                               FontSize="20" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>
                                    <Button Content="ADD TO CART" 
                                            Style="{StaticResource AddToCartButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Producto 2 -->
                    <Border Grid.Column="2"
                            Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                            <Border Grid.Row="1" Padding="25,20">
                                <StackPanel>
                                    <TextBlock Text="CARGO PANTS" 
                                               Style="{StaticResource SubtitleMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="79.99€" 
                                               FontSize="20" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>
                                    <Button Content="ADD TO CART" 
                                            Style="{StaticResource AddToCartButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Producto 3 -->
                    <Border Grid.Column="4"
                            Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                            <Border Grid.Row="1" Padding="25,20">
                                <StackPanel>
                                    <TextBlock Text="GRAPHIC TEE" 
                                               Style="{StaticResource SubtitleMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="39.99€" 
                                               FontSize="20" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>
                                    <Button Content="ADD TO CART" 
                                            Style="{StaticResource AddToCartButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Producto 4 -->
                    <Border Grid.Column="6"
                            Background="{StaticResource WhitePrimaryBrush}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Rectangle Grid.Row="0" Fill="{StaticResource Gray200Brush}"/>

                            <Border Grid.Row="1" Padding="25,20">
                                <StackPanel>
                                    <TextBlock Text="BOMBER JACKET" 
                                               Style="{StaticResource SubtitleMedium}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="129.99€" 
                                               FontSize="20" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>
                                    <Button Content="ADD TO CART" 
                                            Style="{StaticResource AddToCartButton}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Button Content="VIEW ALL PRODUCTS" 
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Center"
                        Margin="0,60,0,0"
                        Command="{Binding NavigateToCatalogCommand}"/>
            </StackPanel>
        </Border>

        <!-- CALL TO ACTION -->
        <Border Background="{StaticResource RedAccentBrush}" Padding="80,60">
            <Border.Effect>
                <DropShadowEffect Color="#E31E24" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="JOIN THE CREW" 
                           FontSize="48" 
                           FontWeight="Black" 
                           Foreground="{StaticResource WhitePrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Subscribe to get exclusive offers and early access to new drops" 
                           FontSize="18"
                           Foreground="{StaticResource WhitePrimaryBrush}"
                           Opacity="0.9"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <Border Background="{StaticResource WhitePrimaryBrush}"
                        Padding="40,18"
                        Cursor="Hand">
                    <TextBlock Text="SUBSCRIBE NOW" 
                               FontSize="14" 
                               FontWeight="Black" 
                               Foreground="{StaticResource BlackPrimaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
