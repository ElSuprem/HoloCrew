<UserControl x:Class="HoloCrew.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Banner Principal -->
            <Border Height="400" 
                    Background="#E3F2FD"
                    Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Texto del Banner -->
                    <StackPanel Grid.Column="0" 
                                VerticalAlignment="Center"
                                Margin="80,0,40,0">
                        <TextBlock Text="Bienvenido a HoloCrew" 
                                   FontSize="48" 
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,20" />
                        <TextBlock Text="Los mejores productos al mejor precio" 
                                   FontSize="24" 
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,30" />
                        <Button Content="Ver Catálogo" 
                                Command="{Binding NavigateToCatalogCommand}"
                                Padding="30,15"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Background="#1976D2"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#115293" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Imagen del Banner -->
                    <Border Grid.Column="1" 
                            Margin="40">
                        <TextBlock Text="🛍️" 
                                   FontSize="200"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.3" />
                    </Border>
                </Grid>
            </Border>

            <!-- Mensaje simple para empezar -->
            <Border Background="#F8F9FA"
                    Padding="40"
                    Margin="40"
                    CornerRadius="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="👋 ¡Empieza a explorar!" 
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1976D2"
                               Margin="0,0,0,20" />
                    <TextBlock Text="Usa los botones de navegación arriba para explorar nuestro catálogo, 
ver tu carrito o gestionar tu lista de deseos." 
                               FontSize="16"
                               Foreground="#666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="600" />
                </StackPanel>
            </Border>

            <!-- Loading Indicator - SIN CONVERTER TEMPORALMENTE -->
            <Grid Height="400">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Cargando..." FontSize="16" Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>