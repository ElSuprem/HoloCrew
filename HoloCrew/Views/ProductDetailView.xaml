<UserControl x:Class="HoloCrew.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <Grid>
        <StackPanel>

            <!-- MAIN PRODUCT SECTION -->
            <Border Background="{StaticResource WhitePrimaryBrush}" Padding="80,40,80,60">
                <StackPanel>

                    <!-- Breadcrumb -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Home" Foreground="{StaticResource Gray500Brush}" FontSize="13" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{StaticResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="Shop" Foreground="{StaticResource Gray500Brush}" FontSize="13" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{StaticResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="{Binding Product.Name}" Foreground="{StaticResource BlackPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Product Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55*"/>
                            <ColumnDefinition Width="45*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: IMAGE GALLERY -->
                        <Grid Grid.Column="0" Margin="0,0,50,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Main Image -->
                            <Border Grid.Row="0" Background="{StaticResource Gray100Brush}" Height="600">
                                <Grid>
                                    <TextBlock Text="" FontSize="80" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Indicador de imagen actual (dots) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                                        <Ellipse Width="10" Height="10" Margin="3">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#50000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedImageIndex}" Value="0">
                                                            <Setter Property="Fill" Value="{StaticResource BlackPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="10" Margin="3">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#50000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedImageIndex}" Value="1">
                                                            <Setter Property="Fill" Value="{StaticResource BlackPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="10" Margin="3">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#50000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedImageIndex}" Value="2">
                                                            <Setter Property="Fill" Value="{StaticResource BlackPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="10" Margin="3">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#50000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedImageIndex}" Value="3">
                                                            <Setter Property="Fill" Value="{StaticResource BlackPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>

                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
                                        <Border Background="{StaticResource BlackPrimaryBrush}" Padding="14,8" Margin="0,0,8,0"
                                                Visibility="{Binding Product.IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NEW" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="{StaticResource RedAccentBrush}" Padding="14,8"
                                                Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                <Run Text="-"/><Run Text="{Binding Product.DiscountPercentage, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Wishlist Button -->
                                    <Button Command="{Binding ToggleWishlistCommand}" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="25">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Viewbox Width="26" Height="26" Margin="0,1,0,0"
                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                  Fill="Transparent" Stroke="#1F2937" StrokeThickness="1.5"/>
                                                        </Viewbox>
                                                        <Viewbox Width="26" Height="26" Margin="0,1,0,0"
                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                  Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                                        </Viewbox>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Navigation Arrow Left -->
                                    <Button Command="{Binding PreviousImageCommand}" Width="45" Height="45" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="22.5" Opacity="0.9">
                                                    <TextBlock Text="‹" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Navigation Arrow Right -->
                                    <Button Command="{Binding NextImageCommand}" Width="45" Height="45" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="22.5" Opacity="0.9">
                                                    <TextBlock Text="›" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,2"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Thumbnails - Simple con índices fijos -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Command="{Binding SelectImageCommand}" CommandParameter="0" Width="90" Height="90" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{StaticResource Gray100Brush}" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImageIndex}" Value="0">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="1" FontSize="20" FontWeight="Bold" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SelectImageCommand}" CommandParameter="1" Width="90" Height="90" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{StaticResource Gray100Brush}" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImageIndex}" Value="1">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="2" FontSize="20" FontWeight="Bold" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SelectImageCommand}" CommandParameter="2" Width="90" Height="90" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{StaticResource Gray100Brush}" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImageIndex}" Value="2">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="3" FontSize="20" FontWeight="Bold" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SelectImageCommand}" CommandParameter="3" Width="90" Height="90" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{StaticResource Gray100Brush}" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImageIndex}" Value="3">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="4" FontSize="20" FontWeight="Bold" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- RIGHT: PRODUCT INFO -->
                        <StackPanel Grid.Column="1">

                            <!-- Category -->
                            <TextBlock Text="{Binding Product.Category.Name}" FontSize="12" Foreground="{StaticResource Gray500Brush}" Margin="0,0,0,10"/>

                            <!-- Product Name -->
                            <TextBlock Text="{Binding Product.Name}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" LineHeight="40" Margin="0,0,0,15"/>

                            <!-- Rating -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="16"/>
                                <TextBlock Text="{Binding Product.AverageRating, StringFormat=' {0:N1}'}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                <TextBlock Foreground="{StaticResource Gray500Brush}" FontSize="14" Margin="5,0,0,0">
                                    <Run Text="("/><Run Text="{Binding Product.ReviewCount, Mode=OneWay}"/><Run Text=" reviews)"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                                <TextBlock Text="{Binding Product.Price, StringFormat='{}{0:N2}€'}" FontSize="36" FontWeight="Black"/>
                                <TextBlock Text="{Binding Product.OriginalPrice, StringFormat='{}{0:N2}€'}" FontSize="22" Foreground="{StaticResource Gray400Brush}"
                                           TextDecorations="Strikethrough" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="#DCFCE7" Padding="10,5" Margin="15,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="#16A34A" FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Save €"/><Run Text="{Binding Product.DiscountAmount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Text="{Binding Product.Description}" FontSize="14" Foreground="{StaticResource Gray600Brush}"
                                       TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,30"/>

                            <Border Height="1" Background="{StaticResource Gray200Brush}" Margin="0,0,0,25"/>

                            <!-- COLOR SELECTOR -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12">
                                    <Run Text="Color: "/><Run Text="{Binding SelectedColor}" FontWeight="Normal"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding AvailableColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}" Width="36" Height="36" Margin="0,0,10,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" CornerRadius="18" Background="{Binding HexCode}" BorderThickness="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="White">
                                                                            <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- SIZE SELECTOR -->
                            <StackPanel Margin="0,0,0,25">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Size: "/><Run Text="{Binding SelectedSize}" FontWeight="Normal"/>
                                    </TextBlock>
                                    <Button Command="{Binding ToggleSizeGuideCommand}" HorizontalAlignment="Right" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="Size Guide" FontSize="13" Foreground="{StaticResource Gray600Brush}" TextDecorations="Underline"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailableSizes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Size}" Width="50" Height="44" Margin="0,0,8,0" Cursor="Hand"
                                                    IsEnabled="{Binding IsAvailable}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                            <Setter Property="Background" Value="{StaticResource Gray100Brush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource Gray200Brush}"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock x:Name="txt" Text="{Binding Size}" FontSize="13" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource BlackPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                <Setter Property="Foreground" Value="{StaticResource Gray400Brush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Size Guide Popup -->
                                <Border Margin="0,15,0,0" Background="{StaticResource Gray50Brush}" Padding="20"
                                        Visibility="{Binding IsSizeGuideOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="SIZE GUIDE" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="25"/>
                                                <RowDefinition Height="25"/>
                                                <RowDefinition Height="25"/>
                                                <RowDefinition Height="25"/>
                                                <RowDefinition Height="25"/>
                                                <RowDefinition Height="25"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Chest (cm)" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Length (cm)" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Sleeve (cm)" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="XS" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="86-91" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="66" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="61" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="S" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="91-96" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="69" FontSize="12"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="63" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="M" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="96-101" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="72" FontSize="12"/>
                                            <TextBlock Grid.Row="3" Grid.Column="3" Text="65" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="L" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="101-106" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="75" FontSize="12"/>
                                            <TextBlock Grid.Row="4" Grid.Column="3" Text="67" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="XL" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="106-111" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="78" FontSize="12"/>
                                            <TextBlock Grid.Row="5" Grid.Column="3" Text="69" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="XXL" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="111-116" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="2" Text="81" FontSize="12"/>
                                            <TextBlock Grid.Row="6" Grid.Column="3" Text="71" FontSize="12"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- QUANTITY SELECTOR -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Quantity" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Border BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1" Width="140" Height="48" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding DecreaseQuantityCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="−" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Command="{Binding IncreaseQuantityCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="+" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ACTION BUTTONS -->
                            <Button Content="ADD TO CART" Style="{StaticResource PrimaryButton}" Background="{StaticResource BlackPrimaryBrush}"
                                    Height="56" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" Command="{Binding AddToCartCommand}"/>
                            <Button Content="BUY NOW" Style="{StaticResource OutlineButton}" Height="56" FontSize="15" FontWeight="Bold" Command="{Binding BuyNowCommand}"/>

                            <!-- BENEFITS -->
                            <Border Background="{StaticResource Gray50Brush}" Padding="20" Margin="0,30,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Free shipping on orders over €50" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="14-day return policy" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="In stock - Ships within 24h" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PRODUCT DETAILS TABS -->
            <Border Padding="80,50" Background="{StaticResource Gray50Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="DETAILS" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Premium cotton blend (80% cotton, 20% polyester)"/><LineBreak/>
                            <Run Text="• 320 GSM heavyweight fabric"/><LineBreak/>
                            <Run Text="• Relaxed fit"/><LineBreak/>
                            <Run Text="• Ribbed cuffs and hem"/><LineBreak/>
                            <Run Text="• Embroidered logo"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,30,0">
                        <TextBlock Text="CARE" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Machine wash cold"/><LineBreak/>
                            <Run Text="• Do not bleach"/><LineBreak/>
                            <Run Text="• Tumble dry low"/><LineBreak/>
                            <Run Text="• Iron on low heat"/><LineBreak/>
                            <Run Text="• Do not dry clean"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SHIPPING" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Standard: 3-5 business days"/><LineBreak/>
                            <Run Text="• Express: 1-2 business days"/><LineBreak/>
                            <Run Text="• Free shipping over €50"/><LineBreak/>
                            <Run Text="• International shipping available"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- REVIEWS SECTION -->
            <Border Padding="80,60" Background="{StaticResource WhitePrimaryBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,30">
                        <TextBlock Text="CUSTOMER REVIEWS" FontSize="22" FontWeight="Bold"/>
                        <Button Command="{Binding ToggleWriteReviewCommand}" HorizontalAlignment="Right" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{StaticResource BlackPrimaryBrush}" Padding="20,12">
                                        <TextBlock Text="WRITE A REVIEW" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Write Review Form -->
                    <Border Background="{StaticResource Gray50Brush}" Padding="25" Margin="0,0,0,30"
                            Visibility="{Binding IsWriteReviewOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Write Your Review" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
                            <TextBlock Text="Rating" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Command="{Binding SetReviewRatingCommand}" CommandParameter="1" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="★" FontSize="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="1">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="2">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="3">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="4">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="5">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SetReviewRatingCommand}" CommandParameter="2" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="★" FontSize="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="2">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="3">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="4">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="5">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SetReviewRatingCommand}" CommandParameter="3" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="★" FontSize="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="3">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="4">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="5">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SetReviewRatingCommand}" CommandParameter="4" Cursor="Hand" Margin="0,0,5,0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="★" FontSize="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="4">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="5">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SetReviewRatingCommand}" CommandParameter="5" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="★" FontSize="24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Gray300Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NewReviewRating}" Value="5">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style></TextBlock>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Title" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding NewReviewTitle, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,10" FontSize="14" Margin="0,0,0,15"/>
                            <TextBlock Text="Review" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding NewReviewText, UpdateSourceTrigger=PropertyChanged}" Height="100" Padding="12,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="SUBMIT REVIEW" Style="{StaticResource PrimaryButton}" Padding="25,12" Command="{Binding SubmitReviewCommand}"/>
                                <Button Content="CANCEL" Style="{StaticResource OutlineButton}" Padding="25,12" Margin="15,0,0,0" Command="{Binding ToggleWriteReviewCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rating Summary -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,60,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Product.AverageRating, StringFormat='{}{0:N1}'}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="24" HorizontalAlignment="Center" Margin="0,5,0,10"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource Gray500Brush}">
                                <Run Text="Based on "/><Run Text="{Binding Product.ReviewCount, Mode=OneWay}"/><Run Text=" reviews"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="5 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="210" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="70%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="4 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="60" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="20%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="3 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="15" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="5%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="2 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="15" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="5%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="0" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="0%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Sample Reviews -->
                    <Border BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0" Padding="0,30,0,0">
                        <StackPanel>
                            <Border Margin="0,0,0,25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="14"/>
                                        <TextBlock Text="Amazing quality!" FontWeight="SemiBold" FontSize="14" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="The fabric is incredibly soft and the fit is perfect. Definitely ordering more colors!" FontSize="14" Foreground="{StaticResource Gray600Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="Carlos M. - December 2024" FontSize="12" Foreground="{StaticResource Gray400Brush}"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,25" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0" Padding="0,25,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="★★★★☆" Foreground="#FBBF24" FontSize="14"/>
                                        <TextBlock Text="Great hoodie" FontWeight="SemiBold" FontSize="14" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Very comfortable and warm. Shipping was fast. Only giving 4 stars because I wish there were more color options." FontSize="14" Foreground="{StaticResource Gray600Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="Maria L. - November 2024" FontSize="12" Foreground="{StaticResource Gray400Brush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="Load More Reviews" Style="{StaticResource OutlineButton}" HorizontalAlignment="Center" Padding="40,14" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <!-- RELATED PRODUCTS -->
            <Border Padding="80,60" Background="{StaticResource Gray50Brush}">
                <StackPanel>
                    <TextBlock Text="YOU MAY ALSO LIKE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <ItemsControl ItemsSource="{Binding RelatedProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WhitePrimaryBrush}" Margin="10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ViewRelatedProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="280"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{StaticResource Gray100Brush}">
                                            <TextBlock Text="" FontSize="36" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="15">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
