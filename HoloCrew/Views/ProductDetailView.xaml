<UserControl x:Class="HoloCrew.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ============================================ -->
            <!-- MAIN PRODUCT SECTION -->
            <!-- ============================================ -->
            <Border Background="{StaticResource WhitePrimaryBrush}" Padding="80,40,80,60">
                <StackPanel>

                    <!-- Breadcrumb -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Home" 
                                   Foreground="{StaticResource Gray500Brush}" 
                                   FontSize="13"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{StaticResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="Shop" 
                                   Foreground="{StaticResource Gray500Brush}" 
                                   FontSize="13"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{StaticResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="{Binding Product.Name}" 
                                   Foreground="{StaticResource BlackPrimaryBrush}" 
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Product Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55*"/>
                            <ColumnDefinition Width="45*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: IMAGE GALLERY -->
                        <Grid Grid.Column="0" Margin="0,0,50,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Main Image -->
                            <Border Grid.Row="0" 
                                    Background="{StaticResource Gray100Brush}"
                                    Height="600">
                                <Grid>
                                    <!-- Image Placeholder -->
                                    <TextBlock Text="📷" 
                                               FontSize="80" 
                                               Opacity="0.15"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>

                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Top"
                                                Margin="20">
                                        <!-- NEW Badge -->
                                        <Border Background="{StaticResource BlackPrimaryBrush}"
                                                Padding="14,8"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding Product.IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NEW" 
                                                       Foreground="White" 
                                                       FontSize="11" 
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <!-- SALE Badge -->
                                        <Border Background="{StaticResource RedAccentBrush}"
                                                Padding="14,8"
                                                Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                <Run Text="-"/>
                                                <Run Text="{Binding Product.DiscountPercentage, Mode=OneWay}"/>
                                                <Run Text="%"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Wishlist Button -->
                                    <Border Width="50" Height="50"
                                            Background="White"
                                            CornerRadius="25"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="20"
                                            Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleWishlistCommand}"/>
                                        </Border.InputBindings>
                                        <TextBlock FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🤍"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInWishlist}" Value="True">
                                                            <Setter Property="Text" Value="❤️"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Navigation Arrows -->
                                    <Border Width="45" Height="45"
                                            Background="White"
                                            CornerRadius="22.5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="15,0"
                                            Cursor="Hand"
                                            Opacity="0.9">
                                        <TextBlock Text="‹" FontSize="24" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,2,2"/>
                                    </Border>
                                    <Border Width="45" Height="45"
                                            Background="White"
                                            CornerRadius="22.5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="15,0"
                                            Cursor="Hand"
                                            Opacity="0.9">
                                        <TextBlock Text="›" FontSize="24" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="2,0,0,2"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Thumbnails -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
                                <Border Width="90" Height="90" Background="{StaticResource Gray200Brush}" Margin="0,0,10,0" 
                                        BorderBrush="{StaticResource BlackPrimaryBrush}" BorderThickness="2" Cursor="Hand"/>
                                <Border Width="90" Height="90" Background="{StaticResource Gray100Brush}" Margin="0,0,10,0" 
                                        BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1" Cursor="Hand"/>
                                <Border Width="90" Height="90" Background="{StaticResource Gray100Brush}" Margin="0,0,10,0" 
                                        BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1" Cursor="Hand"/>
                                <Border Width="90" Height="90" Background="{StaticResource Gray100Brush}" Margin="0,0,10,0" 
                                        BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- RIGHT: PRODUCT INFO -->
                        <StackPanel Grid.Column="1">

                            <!-- Category -->
                            <TextBlock Text="{Binding Product.Category.Name}" 
                                       FontSize="12"
                                       Foreground="{StaticResource Gray500Brush}"
                                       Margin="0,0,0,10"/>

                            <!-- Product Name -->
                            <TextBlock Text="{Binding Product.Name}" 
                                       FontSize="32"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       LineHeight="40"
                                       Margin="0,0,0,15"/>

                            <!-- Rating -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="16"/>
                                <TextBlock Text="{Binding Product.AverageRating, StringFormat=' {0:N1}'}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0"/>
                                <TextBlock Foreground="{StaticResource Gray500Brush}" FontSize="14" Margin="5,0,0,0">
                                    <Run Text="("/>
                                    <Run Text="{Binding Product.ReviewCount, Mode=OneWay}"/>
                                    <Run Text=" reviews)"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                                <TextBlock Text="{Binding Product.Price, StringFormat='€{0:N2}'}" 
                                           FontSize="36"
                                           FontWeight="Black"/>
                                <TextBlock Text="{Binding Product.OriginalPrice, StringFormat='€{0:N2}'}"
                                           FontSize="22"
                                           Foreground="{StaticResource Gray400Brush}"
                                           TextDecorations="Strikethrough"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="#DCFCE7" Padding="10,5" Margin="15,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="#16A34A" FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Save €"/>
                                        <Run Text="{Binding Product.DiscountAmount, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Text="{Binding Product.Description}"
                                       FontSize="14"
                                       Foreground="{StaticResource Gray600Brush}"
                                       TextWrapping="Wrap"
                                       LineHeight="24"
                                       Margin="0,0,0,30"/>

                            <!-- Separator -->
                            <Border Height="1" Background="{StaticResource Gray200Brush}" Margin="0,0,0,25"/>

                            <!-- COLOR SELECTOR -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12">
                                    <Run Text="Color: "/>
                                    <Run Text="{Binding SelectedColor}" FontWeight="Normal"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#0A0A0A" 
                                            BorderBrush="{StaticResource BlackPrimaryBrush}" BorderThickness="2"
                                            Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#FFFFFF" 
                                            BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1"
                                            Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#6B7280" 
                                            BorderBrush="Transparent" BorderThickness="2"
                                            Margin="0,0,10,0" Cursor="Hand"/>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#1E3A5F" 
                                            BorderBrush="Transparent" BorderThickness="2"
                                            Margin="0,0,10,0" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- SIZE SELECTOR -->
                            <StackPanel Margin="0,0,0,25">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Size: "/>
                                        <Run Text="{Binding SelectedSize}" FontWeight="Normal"/>
                                    </TextBlock>
                                    <TextBlock Text="Size Guide" 
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               Foreground="{StaticResource Gray600Brush}"
                                               TextDecorations="Underline"
                                               Cursor="Hand"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="50" Height="44" Background="Transparent" 
                                            BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="XS" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="50" Height="44" Background="Transparent" 
                                            BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="S" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="50" Height="44" Background="{StaticResource BlackPrimaryBrush}" 
                                            BorderBrush="{StaticResource BlackPrimaryBrush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="M" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="50" Height="44" Background="Transparent" 
                                            BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="L" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="50" Height="44" Background="Transparent" 
                                            BorderBrush="{StaticResource Gray300Brush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand">
                                        <TextBlock Text="XL" FontSize="13" FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="50" Height="44" Background="{StaticResource Gray100Brush}" 
                                            BorderBrush="{StaticResource Gray200Brush}" BorderThickness="1"
                                            Margin="0,0,8,0" Cursor="Hand" Opacity="0.5">
                                        <TextBlock Text="XXL" FontSize="13" Foreground="{StaticResource Gray400Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- QUANTITY SELECTOR -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Quantity" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Border BorderBrush="{StaticResource Gray300Brush}" 
                                        BorderThickness="1" 
                                        Width="140"
                                        Height="48"
                                        HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Cursor="Hand" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DecreaseQuantityCommand}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="−" FontSize="20" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Quantity}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="2" Cursor="Hand" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding IncreaseQuantityCommand}"/>
                                            </Border.InputBindings>
                                            <TextBlock Text="+" FontSize="20" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ACTION BUTTONS -->
                            <Button Content="ADD TO CART"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource BlackPrimaryBrush}"
                                    Height="56"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Margin="0,0,0,12"
                                    Command="{Binding AddToCartCommand}"/>

                            <Button Content="BUY NOW"
                                    Style="{StaticResource OutlineButton}"
                                    Height="56"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Command="{Binding BuyNowCommand}"/>

                            <!-- BENEFITS -->
                            <Border Background="{StaticResource Gray50Brush}" 
                                    Padding="20" 
                                    Margin="0,30,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                            <Path Data="M5 12H19M12 5L19 12L12 19" 
                                                  Stroke="{StaticResource BlackPrimaryBrush}" 
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="Free shipping on orders over €50" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                            <Path Data="M3 12L5 10M5 10L12 3L19 10M5 10V20C5 20.5523 5.44772 21 6 21H9M19 10L21 12M19 10V20C19 20.5523 18.5523 21 18 21H15M9 21H15" 
                                                  Stroke="{StaticResource BlackPrimaryBrush}" 
                                                  StrokeThickness="2"
                                                  Fill="Transparent"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="14-day return policy" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                            <Path Data="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" 
                                                  Stroke="#16A34A" 
                                                  StrokeThickness="2"
                                                  Fill="Transparent"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="In stock - Ships within 24h" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- PRODUCT DETAILS TABS -->
            <!-- ============================================ -->
            <Border Padding="80,50" Background="{StaticResource Gray50Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Details -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="DETAILS" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Premium cotton blend (80% cotton, 20% polyester)"/>
                            <LineBreak/>
                            <Run Text="• 320 GSM heavyweight fabric"/>
                            <LineBreak/>
                            <Run Text="• Relaxed fit"/>
                            <LineBreak/>
                            <Run Text="• Ribbed cuffs and hem"/>
                            <LineBreak/>
                            <Run Text="• Embroidered logo"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Care Instructions -->
                    <StackPanel Grid.Column="1" Margin="0,0,30,0">
                        <TextBlock Text="CARE" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Machine wash cold"/>
                            <LineBreak/>
                            <Run Text="• Do not bleach"/>
                            <LineBreak/>
                            <Run Text="• Tumble dry low"/>
                            <LineBreak/>
                            <Run Text="• Iron on low heat"/>
                            <LineBreak/>
                            <Run Text="• Do not dry clean"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Shipping -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SHIPPING" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Standard: 3-5 business days"/>
                            <LineBreak/>
                            <Run Text="• Express: 1-2 business days"/>
                            <LineBreak/>
                            <Run Text="• Free shipping over €50"/>
                            <LineBreak/>
                            <Run Text="• International shipping available"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- REVIEWS SECTION -->
            <!-- ============================================ -->
            <Border Padding="80,60" Background="{StaticResource WhitePrimaryBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CUSTOMER REVIEWS" FontSize="22" FontWeight="Bold"/>
                            <TextBlock FontSize="22" Foreground="{StaticResource Gray400Brush}" Margin="10,0,0,0">
                                <Run Text="("/>
                                <Run Text="{Binding Product.ReviewCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Content="Write a Review" 
                                Style="{StaticResource OutlineButton}"
                                HorizontalAlignment="Right"
                                Padding="25,12"/>
                    </Grid>

                    <!-- Reviews Summary -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Average Rating -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Product.AverageRating, StringFormat='{}{0:N1}'}" 
                                       FontSize="56" 
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="20" HorizontalAlignment="Center" Margin="0,5,0,5"/>
                            <TextBlock Text="Based on all reviews" 
                                       FontSize="13" 
                                       Foreground="{StaticResource Gray500Brush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Rating Bars -->
                        <StackPanel Grid.Column="1" Margin="50,0,0,0">
                            <!-- 5 stars -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="5 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="240" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="80%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <!-- 4 stars -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="4 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="45" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="15%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <!-- 3 stars -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="3 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="15" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="5%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <!-- 2 stars -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="2 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="0" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="0%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                            <!-- 1 star -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1 ★" Width="40" FontSize="13"/>
                                <Border Width="300" Height="8" Background="{StaticResource Gray200Brush}" Margin="10,0">
                                    <Border Background="#FBBF24" Width="0" HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock Text="0%" FontSize="13" Foreground="{StaticResource Gray500Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Sample Reviews -->
                    <Border BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0" Padding="0,30,0,0">
                        <StackPanel>
                            <!-- Review 1 -->
                            <Border Margin="0,0,0,25">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="14"/>
                                        <TextBlock Text="Amazing quality!" FontWeight="SemiBold" FontSize="14" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="The fabric is incredibly soft and the fit is perfect. Definitely ordering more colors!"
                                               FontSize="14"
                                               Foreground="{StaticResource Gray600Brush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Carlos M. - December 2024" 
                                               FontSize="12" 
                                               Foreground="{StaticResource Gray400Brush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Review 2 -->
                            <Border Margin="0,0,0,25" BorderBrush="{StaticResource Gray200Brush}" BorderThickness="0,1,0,0" Padding="0,25,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="★★★★☆" Foreground="#FBBF24" FontSize="14"/>
                                        <TextBlock Text="Great hoodie" FontWeight="SemiBold" FontSize="14" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Very comfortable and warm. Shipping was fast. Only giving 4 stars because I wish there were more color options."
                                               FontSize="14"
                                               Foreground="{StaticResource Gray600Brush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="María L. - November 2024" 
                                               FontSize="12" 
                                               Foreground="{StaticResource Gray400Brush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Content="Load More Reviews" 
                            Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Center"
                            Padding="40,14"
                            Margin="0,20,0,0"/>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- RELATED PRODUCTS -->
            <!-- ============================================ -->
            <Border Padding="80,60" Background="{StaticResource Gray50Brush}">
                <StackPanel>
                    <TextBlock Text="YOU MAY ALSO LIKE" 
                               FontSize="22" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>

                    <ItemsControl ItemsSource="{Binding RelatedProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WhitePrimaryBrush}" Margin="10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ViewRelatedProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="280"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{StaticResource Gray100Brush}"/>

                                        <StackPanel Grid.Row="1" Margin="15">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Price, StringFormat='€{0:N2}'}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
