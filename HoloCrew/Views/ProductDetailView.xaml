<UserControl x:Class="HoloCrew.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>
        <StackPanel>

            <!-- MAIN PRODUCT SECTION -->
            <Border Background="{DynamicResource WhitePrimaryBrush}" Padding="80,40,80,60">
                <StackPanel>

                    <!-- Breadcrumb -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBlock Text="Home" Foreground="{DynamicResource Gray500Brush}" FontSize="13" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{DynamicResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="Shop" Foreground="{DynamicResource Gray500Brush}" FontSize="13" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCatalogCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="  /  " Foreground="{DynamicResource Gray400Brush}" FontSize="13"/>
                        <TextBlock Text="{Binding Product.Name}" Foreground="{DynamicResource BlackPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Product Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55*"/>
                            <ColumnDefinition Width="45*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: IMAGE GALLERY -->
                        <Grid Grid.Column="0" Margin="0,0,50,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Main Image -->
                            <Border Grid.Row="0" Background="{DynamicResource WhitePrimaryBrush}" Height="600" ClipToBounds="True">
                                <Grid>
                                    <!-- Imagen principal: bindeada a SelectedImage del VM -->
                                    <controls:AsyncImage Source="{Binding SelectedImage}" Stretch="Uniform"/>

                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                                                IsHitTestVisible="False">
                                        <Border Background="{DynamicResource BlackPrimaryBrush}" Padding="14,8" Margin="0,0,8,0"
                                                Visibility="{Binding Product.IsNew, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="NEW" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="{DynamicResource RedAccentBrush}" Padding="14,8"
                                                Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                <Run Text="-"/><Run Text="{Binding Product.DiscountPercentage, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Wishlist Button -->
                                    <Button Command="{Binding ToggleWishlistCommand}" Width="50" Height="50"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="25">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Viewbox Width="26" Height="26" Margin="0,1,0,0"
                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                  Fill="Transparent" Stroke="#1F2937" StrokeThickness="1.5"/>
                                                        </Viewbox>
                                                        <Viewbox Width="26" Height="26" Margin="0,1,0,0"
                                                                 Visibility="{Binding IsInWishlist, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                                                  Fill="#EF4444" Stroke="#EF4444" StrokeThickness="1.5"/>
                                                        </Viewbox>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Overlay SOLD OUT cuando todas las tallas están agotadas -->
                                    <Border Background="#CCFFFFFF"
                                            Visibility="{Binding Product.IsCompletelyOutOfStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                            IsHitTestVisible="False">
                                        <Border Background="#0A0A0A"
                                                Padding="30,12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="SOLD OUT"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Thumbnails: ItemsControl real sobre Images del VM -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Images}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Margin="0,0,10,0"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="90" Height="90"
                                                            Background="{DynamicResource Gray100Brush}"
                                                            ClipToBounds="True"
                                                            BorderThickness="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <controls:AsyncImage Source="{Binding Url}" Stretch="Uniform"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- RIGHT: PRODUCT INFO -->
                        <StackPanel Grid.Column="1">

                            <!-- Category -->
                            <TextBlock Text="{Binding Product.Category.Name}" FontSize="12" Foreground="{DynamicResource Gray500Brush}" Margin="0,0,0,10"/>

                            <!-- Product Name -->
                            <TextBlock Text="{Binding Product.Name}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" LineHeight="40" Margin="0,0,0,15"/>

                            <!-- Rating -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="★★★★★" Foreground="#FBBF24" FontSize="16"/>
                                <TextBlock Text="{Binding Product.AverageRating, StringFormat=' {0:N1}'}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                <TextBlock Foreground="{DynamicResource Gray500Brush}" FontSize="14" Margin="5,0,0,0">
                                    <Run Text="("/><Run Text="{Binding Product.ReviewCount, Mode=OneWay}"/><Run Text=" reviews)"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                                <TextBlock Text="{Binding Product.Price, StringFormat='{}{0:N2}€'}" FontSize="36" FontWeight="Black"/>
                                <TextBlock Text="{Binding Product.OriginalPrice, StringFormat='{}{0:N2}€'}" FontSize="22" Foreground="{DynamicResource Gray400Brush}"
                                           TextDecorations="Strikethrough" VerticalAlignment="Center" Margin="15,0,0,0"
                                           Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="#DCFCE7" Padding="10,5" Margin="15,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Foreground="#16A34A" FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Save €"/><Run Text="{Binding Product.Savings, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Text="{Binding Product.Description}" FontSize="14" Foreground="{DynamicResource Gray600Brush}"
                                       TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,30"/>

                            <Border Height="1" Background="{DynamicResource Gray200Brush}" Margin="0,0,0,25"/>

                            <!-- COLOR SELECTOR -->
                            <StackPanel Margin="0,0,0,25">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12">
                                    <Run Text="Color: "/><Run Text="{Binding SelectedColor}" FontWeight="Normal"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding AvailableColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}" Width="36" Height="36" Margin="0,0,10,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" CornerRadius="18" Background="{Binding HexCode}" BorderThickness="2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="White">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- SIZE SELECTOR (oculto si el producto no tiene tallas, p. ej. bolsos) -->
                            <StackPanel Margin="0,0,0,25"
                                        Visibility="{Binding Product.HasSizes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock FontSize="13" FontWeight="SemiBold">
                                        <Run Text="Size: "/><Run Text="{Binding SelectedSize}" FontWeight="Normal"/>
                                    </TextBlock>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AvailableSizes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Size}" Width="50" Height="44" Margin="0,0,8,0" Cursor="Hand"
                                                    IsEnabled="{Binding IsAvailable}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Gray300Brush}"/>
                                                                    <Style.Triggers>
                                                                        <!-- Talla seleccionada: fondo negro -->
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <!-- Talla que el producto no vende: gris tenue -->
                                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                            <Setter Property="Background" Value="{DynamicResource Gray100Brush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Gray200Brush}"/>
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                        <!-- Talla agotada (la vende pero stock=0): rojo claro -->
                                                                        <DataTrigger Binding="{Binding IsSoldOut}" Value="True">
                                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                                            <Setter Property="Opacity" Value="0.9"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Size}" FontSize="13" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BlackPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Gray400Brush}"/>
                                                                            </DataTrigger>
                                                                            <!-- Talla agotada: texto rojo y tachado -->
                                                                            <DataTrigger Binding="{Binding IsSoldOut}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- QUANTITY SELECTOR -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Quantity" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Border BorderBrush="{DynamicResource Gray300Brush}" BorderThickness="1" Width="140" Height="48" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding DecreaseQuantityCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="−" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Command="{Binding IncreaseQuantityCommand}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock Text="+" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ACTION BUTTONS -->
                            <Button Content="ADD TO CART" Style="{StaticResource PrimaryButton}" Background="{DynamicResource BlackPrimaryBrush}"
                                    Height="56" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" Command="{Binding AddToCartCommand}"/>
                            <Button Content="BUY NOW" Style="{StaticResource OutlineButton}" Height="56" FontSize="15" FontWeight="Bold" Command="{Binding BuyNowCommand}"/>

                            <!-- BENEFITS -->
                            <Border Background="{DynamicResource Gray50Brush}" Padding="20" Margin="0,30,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Free shipping on orders over €50" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="14-day return policy" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="→" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="In stock - Ships within 24h" FontSize="13" Foreground="#16A34A" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PRODUCT DETAILS TABS -->
            <Border Padding="80,50" Background="{DynamicResource Gray50Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="DETAILS" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Premium cotton blend (80% cotton, 20% polyester)"/><LineBreak/>
                            <Run Text="• 320 GSM heavyweight fabric"/><LineBreak/>
                            <Run Text="• Relaxed fit"/><LineBreak/>
                            <Run Text="• Ribbed cuffs and hem"/><LineBreak/>
                            <Run Text="• Embroidered logo"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,30,0">
                        <TextBlock Text="CARE" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Machine wash cold"/><LineBreak/>
                            <Run Text="• Do not bleach"/><LineBreak/>
                            <Run Text="• Tumble dry low"/><LineBreak/>
                            <Run Text="• Iron on low heat"/><LineBreak/>
                            <Run Text="• Do not dry clean"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SHIPPING" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Gray600Brush}" LineHeight="26" TextWrapping="Wrap">
                            <Run Text="• Standard: 3-5 business days"/><LineBreak/>
                            <Run Text="• Express: 1-2 business days"/><LineBreak/>
                            <Run Text="• Free shipping over €50"/><LineBreak/>
                            <Run Text="• International shipping available"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RELATED PRODUCTS -->
            <Border Padding="80,60" Background="{DynamicResource Gray50Brush}">
                <StackPanel>
                    <TextBlock Text="YOU MAY ALSO LIKE" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <ItemsControl ItemsSource="{Binding RelatedProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WhitePrimaryBrush}" Margin="10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ViewRelatedProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="280"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{DynamicResource WhitePrimaryBrush}" ClipToBounds="True">
                                            <Grid>
                                                <controls:AsyncImage Source="{Binding MainImageUrl}" Stretch="Uniform"/>
                                                <!-- Overlay SOLD OUT en productos relacionados también -->
                                                <Border Background="#CCFFFFFF"
                                                        Visibility="{Binding IsCompletelyOutOfStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        IsHitTestVisible="False">
                                                    <Border Background="#0A0A0A"
                                                            Padding="20,8"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="SOLD OUT"
                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="15">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>