<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HoloCrew.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="1400"
             Background="{StaticResource BackgroundPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="80,50,80,100">
            <StackPanel>
                <!-- Breadcrumb mejorado con hover -->
                <TextBlock Style="{StaticResource BodyMedium}"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,40">
                    <Hyperlink Style="{StaticResource SecondaryLink}">
                        <Run Text="Home"/>
                    </Hyperlink>
                    <Run Text=" / "/>
                    <Hyperlink Style="{StaticResource SecondaryLink}">
                        <Run Text="Productos"/>
                    </Hyperlink>
                    <Run Text=" / "/>
                    <Run Text="{Binding Product.Category}"/>
                </TextBlock>

                <!-- Contenido Principal -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GALERÍA DE IMÁGENES -->
                    <StackPanel Grid.Column="0">
                        <!-- Imagen Principal -->
                        <Border Background="{StaticResource Gray100Brush}"
                                Height="680"
                                Margin="0,0,0,25">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="15" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Rectangle Fill="{StaticResource Gray200Brush}"/>

                                <!-- Badge descuento -->
                                <Border Background="{StaticResource RedAccentBrush}"
                                        Padding="20,10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="25,25,0,0"
                                        Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Product.DiscountPercentage, StringFormat=-{0}%}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{StaticResource WhitePrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Miniaturas -->
                        <ItemsControl ItemsSource="{Binding ProductImages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Gray100Brush}"
                                            BorderBrush="{StaticResource BorderDefault}"
                                            BorderThickness="2"
                                            Height="130"
                                            Margin="0,0,15,0"
                                            Cursor="Hand">
                                        <Rectangle Fill="{StaticResource Gray200Brush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- DETALLES DEL PRODUCTO -->
                    <Border Grid.Column="2">
                        <StackPanel>
                            <!-- Nombre -->
                            <TextBlock Text="{Binding Product.Name}" 
                                       Style="{StaticResource HeadingXL}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,25"/>

                            <!-- Rating -->
                            <Border Background="{StaticResource Gray50Brush}"
                                    Padding="20,12"
                                    Margin="0,0,0,30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" 
                                               Foreground="{StaticResource StarBrush}" 
                                               FontSize="24"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Product.AverageRating, StringFormat={}{0:F1}}"
                                               Style="{StaticResource SubtitleLarge}"
                                               FontWeight="Bold"
                                               Margin="10,0,15,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Product.ReviewsCount, StringFormat=({0} reviews)}"
                                               Style="{StaticResource BodyMedium}"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Precio -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:C}}"
                                           FontSize="42"
                                           FontWeight="Black"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Product.OriginalPrice, StringFormat={}{0:C}}"
                                           FontSize="24"
                                           TextDecorations="Strikethrough"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Product.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Descripción mejorada -->
                            <TextBlock Text="DESCRIPCIÓN"
                                       Style="{StaticResource SubtitleMedium}"
                                       Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding Product.Description}"
                                       Style="{StaticResource BodyLarge}"
                                       TextWrapping="Wrap"
                                       LineHeight="26"
                                       Margin="0,0,0,30"/>

                            <!-- Color -->
                            <TextBlock Text="COLOR"
                                       Style="{StaticResource SubtitleMedium}"
                                       Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding AvailableColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderDefault}"
                                                BorderThickness="2"
                                                Width="50"
                                                Height="50"
                                                Margin="0,0,12,12"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="3"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Rectangle Fill="{Binding ColorBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Talla mejorada -->
                            <TextBlock Text="TALLA"
                                       Style="{StaticResource SubtitleMedium}"
                                       Margin="0,30,0,15"/>
                            <ItemsControl ItemsSource="{Binding AvailableSizes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderDefault}"
                                                BorderThickness="2"
                                                Width="65"
                                                Height="50"
                                                Margin="0,0,12,12"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="3"/>
                                                            <Setter Property="Background" Value="{StaticResource Gray50Brush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Cantidad -->
                            <TextBlock Text="CANTIDAD"
                                       Style="{StaticResource SubtitleMedium}"
                                       Margin="0,30,0,15"/>
                            <Border BorderBrush="{StaticResource BorderDefault}"
                                    BorderThickness="2"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="-"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Cursor="Hand"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Quantity}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="+"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- ⭐ BOTÓN ADD TO CART MEJORADO -->
                            <Button Content="🛒 ADD TO CART"
                                    Style="{StaticResource AccentButton}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Padding="0,22"
                                    Margin="0,0,0,15"
                                    Command="{Binding AddToCartCommand}">
                                <Button.Effect>
                                    <DropShadowEffect Color="Black" 
                                                      Opacity="0.3" 
                                                      BlurRadius="15" 
                                                      ShadowDepth="5"/>
                                </Button.Effect>
                            </Button>

                            <!-- ⭐ WISHLIST CON MEJOR ESTILO -->
                            <Button Content="♥ ADD TO WISHLIST"
                                    Style="{StaticResource OutlineButton}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Padding="0,18"
                                    Command="{Binding ToggleWishlistCommand}"/>

                            <!-- Información adicional -->
                            <Border Background="{StaticResource Gray50Brush}"
                                    Padding="25,20"
                                    Margin="0,40,0,0"
                                    CornerRadius="8">
                                <StackPanel>
                                    <Border Padding="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚚"
                                                       FontSize="20"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="Envío gratis en pedidos +50€"
                                                       Style="{StaticResource BodyMedium}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄"
                                                       FontSize="20"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="Devoluciones gratuitas en 14 días"
                                                       Style="{StaticResource BodyMedium}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="En stock - Envío inmediato"
                                                       Style="{StaticResource BodyMedium}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#10B981"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TABS SECTION -->
                <TabControl Margin="0,80,0,0"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="30,15"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab: Descripción detallada -->
                    <TabItem Header="Descripción detallada">
                        <Border Padding="30,40" Background="{StaticResource WhitePrimaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Características principales"
                                           Style="{StaticResource SubtitleLarge}"
                                           Margin="0,0,0,20"/>
                                <TextBlock Style="{StaticResource BodyLarge}"
                                           TextWrapping="Wrap"
                                           LineHeight="28">
                                    <Run Text="• Material de alta calidad"/>
                                    <LineBreak/>
                                    <Run Text="• Diseño moderno y elegante"/>
                                    <LineBreak/>
                                    <Run Text="• Fácil de lavar y mantener"/>
                                    <LineBreak/>
                                    <Run Text="• Disponible en múltiples colores y tallas"/>
                                    <LineBreak/>
                                    <Run Text="• Fabricado de forma sostenible"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- Tab: Reseñas -->
                    <TabItem Header="Reseñas (125)">
                        <Border Padding="30,40" Background="{StaticResource WhitePrimaryBrush}">
                            <TextBlock Text="Las reseñas aparecerán aquí..."
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </TabItem>

                    <!-- Tab: Envío -->
                    <TabItem Header="Envío y devoluciones">
                        <Border Padding="30,40" Background="{StaticResource WhitePrimaryBrush}">
                            <StackPanel>
                                <TextBlock Text="Información de envío"
                                           Style="{StaticResource SubtitleLarge}"
                                           Margin="0,0,0,20"/>
                                <TextBlock Style="{StaticResource BodyLarge}"
                                           TextWrapping="Wrap"
                                           LineHeight="28">
                                    <Run Text="• Envío estándar: 3-5 días laborables"/>
                                    <LineBreak/>
                                    <Run Text="• Envío express: 1-2 días laborables"/>
                                    <LineBreak/>
                                    <Run Text="• Envío gratis en pedidos superiores a 50€"/>
                                    <LineBreak/>
                                    <Run Text="• Devoluciones gratuitas en 14 días"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
