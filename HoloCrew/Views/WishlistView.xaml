<UserControl x:Class="HoloCrew.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <Grid Margin="0,0,0,30">
                <TextBlock Text="Mi Lista de Deseos" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Lista vacía -->
            <Border Background="#F8F9FA"
                    Padding="60"
                    Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="❤️" 
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="Tu lista de deseos está vacía" 
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               Margin="0,0,0,15" />
                    <TextBlock Text="Guarda tus productos favoritos aquí para comprarlos más tarde" 
                               FontSize="14"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="0,0,0,30" />
                    <Button Content="Explorar productos" 
                            Command="{Binding BrowseProductsCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>