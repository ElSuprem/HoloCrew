<UserControl x:Class="HoloCrew.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <Grid Margin="0,0,0,30">
                <TextBlock Text="Mi Lista de Deseos" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Añadir todo al carrito" 
                            Command="{Binding AddAllToCartCommand}"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#388E3C" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#C8E6C9" />
                                        <Setter Property="Foreground" Value="#81C784" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Compartir lista" 
                            Command="{Binding ShareWishlistCommand}"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="Transparent"
                            Foreground="#1976D2"
                            BorderBrush="#1976D2"
                            BorderThickness="1"
                            Cursor="Hand"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Lista vacía -->
            <Border Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                    Background="#F8F9FA"
                    Padding="60"
                    Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="❤️" 
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="Tu lista de deseos está vacía" 
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               Margin="0,0,0,15" />
                    <TextBlock Text="Guarda tus productos favoritos aquí para comprarlos más tarde" 
                               FontSize="14"
                               Foreground="#777"
                               TextAlignment="Center"
                               Margin="0,0,0,30" />
                    <Button Content="Explorar productos" 
                            Command="{Binding BrowseProductsCommand}"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Background="#1976D2"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#115293" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Lista de productos -->
            <ItemsControl ItemsSource="{Binding WishlistItems}"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Width="260"
                                Margin="10"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Imagen del Producto -->
                                <Border Grid.Row="0" 
                                        Background="#F5F5F5">
                                    <TextBlock Text="📷" 
                                               FontSize="64"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#CCC" />

                                    <!-- Botón eliminar de wishlist -->
                                    <Button Command="{Binding DataContext.RemoveFromWishlistCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="10"
                                            Cursor="Hand"
                                            ToolTip="Eliminar de la lista">
                                        <TextBlock Text="❤️" 
                                                   FontSize="16" />
                                    </Button>

                                    <!-- Badge de descuento -->
                                    <Border Background="#F44336"
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="10"
                                            Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DiscountPercentage, StringFormat='-{0}%'}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12" />
                                    </Border>
                                </Border>

                                <!-- Información del Producto -->
                                <StackPanel Grid.Row="1" Padding="15">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8" />

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="#757575"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,12" />

                                    <!-- Rating -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="★" Foreground="#FFC107" FontSize="14" />
                                        <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}"
                                                   FontSize="12"
                                                   Margin="4,0,8,0" />
                                        <TextBlock Text="{Binding ReviewCount, StringFormat='({0})'}"
                                                   FontSize="12"
                                                   Foreground="#999" />
                                    </StackPanel>

                                    <!-- Precio y disponibilidad -->
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Price, StringFormat='€{0:N2}'}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="#1976D2" />

                                            <TextBlock Text="{Binding OriginalPrice, StringFormat='€{0:N2}'}"
                                                       FontSize="14"
                                                       Foreground="#999"
                                                       TextDecorations="Strikethrough"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Disponibilidad -->
                                        <TextBlock Text="{Binding StockStatus}"
                                                   FontSize="12"
                                                   Foreground="{Binding StockColor}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Botones de acción -->
                                    <Grid>
                                        <Button Content="Añadir al carrito" 
                                                Command="{Binding DataContext.AddToCartFromWishlistCommand, 
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="15,10"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Background="#1976D2"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding IsInStock}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#115293" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#BBDEFB" />
                                                            <Setter Property="Foreground" Value="#90A4AE" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Command="{Binding DataContext.ViewProductDetailCommand, 
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                Cursor="Hand"
                                                ToolTip="Ver detalles">
                                            <TextBlock Text="👁️" 
                                                       FontSize="16" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Notificaciones de precio -->
            <Border Visibility="{Binding HasPriceDropNotifications, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FFF3E0"
                    Padding="20"
                    Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="🔥 ¡Ofertas en tu lista!" 
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#E65100"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding PriceDropMessage}" 
                               FontSize="14"
                               Foreground="#666"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15" />
                    <Button Content="Ver ofertas" 
                            Command="{Binding ViewPriceDropsCommand}"
                            Padding="15,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F57C00" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Height="200"
                  VerticalAlignment="Center"
                  Margin="0,40,0,0">
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Cargando lista de deseos..." 
                               FontSize="16" 
                               Foreground="#666" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>