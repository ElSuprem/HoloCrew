<UserControl x:Class="HoloCrew.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <Grid>

        <Border Padding="60,40,60,80">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MY WISHLIST" 
                                   Style="{StaticResource HeadingLarge}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Style="{StaticResource BodyLarge}">
                            <Run Text="{Binding WishlistItemCount, Mode=OneWay}"/>
                            <Run Text=" items saved"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Clear All Button -->
                    <Button Content="CLEAR ALL" 
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding ClearWishlistCommand}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"/>
                </Grid>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" Margin="0,100,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWishlistEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="" 
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="YOUR WISHLIST IS EMPTY" 
                               Style="{StaticResource HeadingMedium}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Save your favorite products here to buy them later" 
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center"
                               MaxWidth="400"
                               TextWrapping="Wrap"
                               Margin="0,0,0,30"/>
                    <Button Content="EXPLORE PRODUCTS" 
                            Style="{StaticResource AccentButton}"
                            Padding="40,15"
                            Command="{Binding BrowseProductsCommand}"/>
                </StackPanel>

                <!-- Lista de Productos -->
                <ItemsControl ItemsSource="{Binding WishlistItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WhitePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    Margin="0,0,20,20"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="350"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Imagen -->
                                    <Rectangle Grid.Row="0" Fill="{DynamicResource Gray200Brush}"/>

                                    <!-- Botón Remove -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource WhitePrimaryBrush}"
                                            Width="40" Height="40"
                                            CornerRadius="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="15"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.RemoveFromWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="✕" 
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <Border Grid.Row="1" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,8"/>

                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,15"/>

                                            <Button Content="ADD TO CART" 
                                                    Style="{StaticResource AccentButton}"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
