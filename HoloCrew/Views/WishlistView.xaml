<UserControl x:Class="HoloCrew.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HoloCrew.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{DynamicResource BackgroundPrimary}">

    <!-- Vista de la lista de deseos (wishlist).
         Muestra los productos guardados como favoritos, permite eliminarlos, añadirlos
         al carrito (que les lleva al detalle si tienen tallas), o navegar al detalle del producto.
         Se conecta con WishlistViewModel. -->

    <Grid>

        <Border Padding="60,40,60,80">
            <StackPanel>
                <!-- cabecera -->
                <Grid Margin="0,0,0,40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MY WISHLIST" 
                                   Style="{StaticResource HeadingLarge}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Style="{StaticResource BodyLarge}">
                            <Run Text="{Binding WishlistItemCount, Mode=OneWay}"/>
                            <Run Text=" items saved"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="CLEAR ALL" 
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding ClearWishlistCommand}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"/>
                </Grid>

                <!-- estado vacío -->
                <StackPanel HorizontalAlignment="Center" Margin="0,100,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWishlistEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="No items" 
                               FontSize="100"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30" />
                    <TextBlock Text="YOUR WISHLIST IS EMPTY" 
                               Style="{StaticResource HeadingMedium}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Save your favorite products here to buy them later" 
                               Style="{StaticResource BodyLarge}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextAlignment="Center"
                               MaxWidth="400"
                               TextWrapping="Wrap"
                               Margin="0,0,0,30"/>
                    <Button Content="EXPLORE PRODUCTS" 
                            Style="{StaticResource AccentButton}"
                            Padding="40,15"
                            Command="{Binding BrowseProductsCommand}"/>
                </StackPanel>

                <!-- lista de productos -->
                <ItemsControl ItemsSource="{Binding WishlistItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WhitePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    Margin="0,0,20,20"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="350"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- imagen del producto (click para ver detalle) -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource Gray100Brush}"
                                            ClipToBounds="True"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <controls:AsyncImage Source="{Binding MainImageUrl}"
                                                                 Stretch="UniformToFill"/>

                                            <!-- Overlay SOLD OUT cuando el producto está agotado -->
                                            <Border Background="#CCFFFFFF"
                                                    Visibility="{Binding IsCompletelyOutOfStock, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    IsHitTestVisible="False"
                                                    Panel.ZIndex="100">
                                                <Border Background="#0A0A0A"
                                                        Padding="20,8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="SOLD OUT"
                                                               Foreground="White"
                                                               FontSize="14"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- botón eliminar (encima de la imagen) -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource WhitePrimaryBrush}"
                                            Width="40" Height="40"
                                            CornerRadius="20"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="15"
                                            Cursor="Hand"
                                            Panel.ZIndex="200">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.RemoveFromWishlistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          MouseAction="LeftClick"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="✕" 
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- información del producto -->
                                    <Border Grid.Row="1" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,8"
                                                       Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  MouseAction="LeftClick"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2}€'}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,15"/>

                                            <Button Content="VIEW SIZES" 
                                                    Style="{StaticResource AccentButton}"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>