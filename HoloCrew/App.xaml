<!-- ========================================
     HOLOCREW - APP.XAML
     ✅ Incluye MegaMenuStyles para el nuevo header
     ======================================== -->

<Application x:Class="HoloCrew.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HoloCrew.Converters"
             xmlns:vm="clr-namespace:HoloCrew.ViewModels"
             xmlns:views="clr-namespace:HoloCrew.Views"
             DispatcherUnhandledException="Application_DispatcherUnhandledException">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ========== CONVERTERS ========== -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter" />
            <converters:EqualityConverter x:Key="EqualityConverter" />
            <converters:PriceFormatConverter x:Key="PriceFormatConverter" />
            <converters:DateFormatConverter x:Key="DateFormatConverter" />
            <converters:StatusToColourConverter x:Key="StatusToColourConverter" />
            <converters:SelectedButtonTextConverter x:Key="SelectedButtonTextConverter" />

            <!-- Converter incorporado de WPF -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- ========== DATA TEMPLATES ========== -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductCatalogViewModel}">
                <views:ProductCatalogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProductDetailViewModel}">
                <views:ProductDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CartViewModel}">
                <views:CartView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CheckoutViewModel}">
                <views:CheckoutView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
                <views:RegisterView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfileView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OrderHistoryViewModel}">
                <views:OrderHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OrderDetailViewModel}">
                <views:OrderDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WishlistViewModel}">
                <views:WishlistView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
                <views:NotificationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FlashSaleViewModel}">
                <views:FlashSaleView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BlackWeekViewModel}">
                <views:BlackWeekView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MembersClubViewModel}">
                <views:MembersClubView />
            </DataTemplate>

            <!-- ========== ESTILOS - ORDEN CRÍTICO ========== -->
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. COLORES -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />

                <!-- 2. BRUSHES -->
                <ResourceDictionary Source="Resources/Styles/Brushes.xaml" />

                <!-- 3. ESTILOS DE TEXTO -->
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml" />

                <!-- 4. ESTILOS DE BOTONES -->
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />

                <!-- 5. RESTO DE ESTILOS -->
                <ResourceDictionary Source="Resources/Styles/InputStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ToggleSwitch.xaml" />
                <ResourceDictionary Source="Resources/Styles/LinkStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/EnhancedButtonStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Cards.xaml" />
                <ResourceDictionary Source="Resources/Styles/ScrollViewers.xaml" />
                <ResourceDictionary Source="Resources/Styles/Animations.xaml" />

                <!-- 6. ⭐ NUEVO: Estilos del Mega Menu -->
                <ResourceDictionary Source="Resources/Styles/MegaMenuStyles.xaml" />
                <ResourceDictionary Source="/Resources/Styles/LoadingStates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
