<Application x:Class="HoloCrew.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DispatcherUnhandledException="Application_DispatcherUnhandledException">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ========== CONVERTERS ========== -->
            <!-- Usar el converter incorporado de WPF -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- NOTA: Los demás converters personalizados los registraremos cuando los necesitemos -->

            <!-- ========== ESTILOS ========== -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlocks.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Cards.xaml" />
                <ResourceDictionary Source="Resources/Styles/ScrollViewers.xaml" />
                <ResourceDictionary Source="Resources/Styles/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>