<UserControl x:Class="HoloCrew.Controls.AsyncImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <Grid>
        <!-- Imagen real (visible cuando carga bien) -->
        <Image x:Name="ImageElement"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Placeholder de "imagen no disponible" (oculto por defecto) -->
        <Grid x:Name="FallbackPanel"
              Background="#F3F4F6"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10">
                <!-- Icono SVG de imagen rota -->
                <Viewbox Width="36" Height="36" Margin="0,0,0,8">
                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                          Fill="#9CA3AF"/>
                </Viewbox>
                <TextBlock Text="No image available"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>